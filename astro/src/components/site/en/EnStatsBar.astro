---
/**
 * EnStatsBar — porte estático de src/components/en/EnStatsBar.tsx.
 * A animação de count-up (JS/IntersectionObserver) foi removida:
 * os valores finais são renderizados estaticamente (mesma formatação en-US).
 */
---
<section class="stats-bar" aria-label="Clinic statistics">
  <div class="container">
    <div class="stats-grid">
      <div class="stat">
        <div class="stat-ic">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
        </div>
        <div>
          <p class="stat-val">20+</p>
          <p class="stat-lbl">Years of Experience</p>
        </div>
      </div>

      <div class="stat">
        <div class="stat-ic">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div>
          <p class="stat-val">4,000+</p>
          <p class="stat-lbl">Patients Treated</p>
        </div>
      </div>

      <div class="stat">
        <div class="stat-ic">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
        </div>
        <div>
          <p class="stat-val">27,509</p>
          <p class="stat-lbl">CRO-RJ</p>
        </div>
      </div>

      <div class="stat">
        <div class="stat-ic">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <div>
          <p class="stat-val">5.0 ★</p>
          <p class="stat-lbl">Google Rating</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .stats-bar {
    background: rgb(255 255 255 / 0.8);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    border-top: 1px solid rgb(56 31 71 / 0.1);
    border-bottom: 1px solid rgb(56 31 71 / 0.1);
  }
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 24px;
  }
  @media (min-width: 768px) {
    .container { padding-top: 32px; padding-bottom: 32px; }
  }
  @media (min-width: 1024px) {
    .container { padding-left: 32px; padding-right: 32px; }
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  @media (min-width: 768px) {
    .stats-grid { grid-template-columns: repeat(4, 1fr); gap: 32px; }
  }
  .stat {
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: center;
  }
  .stat-ic {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: rgb(179 149 95 / 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--dental-gold);
  }
  .stat-val {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--dental-purple);
    line-height: 1.25;
  }
  @media (min-width: 768px) {
    .stat-val { font-size: 1.25rem; }
  }
  .stat-lbl {
    font-size: 0.75rem;
    color: #525252; /* text-dental-gray do tailwind.config.ts */
    line-height: 1.25;
  }
</style>
