---
/**
 * EnAboutSection — porte fiel de src/components/en/EnAboutSection.tsx.
 * CTA WhatsApp usa o handler global do Base (js-wa-cta), label do React:
 * sendGCLIDToWebhook("en_home_about_section").
 */
const WA_HREF = "https://wa.me/5521993304045?text=Hello!%20I'd%20like%20to%20book%20an%20appointment.";
---
<section id="about" class="about-sec">
  <div class="container">
    <div class="sec-head">
      <h2 class="heading-lg">Meet Dr. Carla Christoph, Your Dentist in Ipanema</h2>
      <div class="gold-sep" role="none"></div>
      <p class="sec-sub">
        Over 20 years of clinical experience in cosmetic and restorative
        dentistry in Ipanema, Rio de Janeiro
      </p>
    </div>

    <div class="about-grid">
      <div class="about-img">
        <img
          src="/lovable-uploads/fef24f70-4659-453e-8fee-79dee34b6220.png"
          alt="Dr. Carla Christoph, dental specialist in Ipanema, Rio de Janeiro"
          width="1920"
          height="1280"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="about-text">
        <div class="about-paras">
          <p class="body-md">
            With over two decades in Ipanema, Dr. Carla has built her
            reputation by treating each patient individually, with time and
            attention. Her background includes 8 years as a dental officer
            in the Brazilian Navy — an experience that shaped her precision,
            discipline, and commitment to patient care.
          </p>
          <p class="body-md">
            Specialist in Prosthodontics and Implant Dentistry (CRO-RJ
            27.509, Brazilian Dental Board), she uses the iTero Element 5D
            scanner and digital smile planning to bring predictability and
            confidence to every treatment. Each case is treated as unique,
            with the time needed to listen, plan, and deliver.
          </p>
        </div>

        <div class="about-cta">
          <a
            class="btn-purple js-wa-cta"
            data-label="en_home_about_section"
            href={WA_HREF}
            target="_blank"
            rel="noopener"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
            <span class="btn-2line">
              <span class="btn-l1">Book Your Appointment</span>
              <span class="btn-l2">WhatsApp — We reply in your language</span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-sec {
    background: #fff;
    padding-top: 64px;
    padding-bottom: 64px;
  }
  @media (min-width: 768px) {
    .about-sec { padding-top: 80px; padding-bottom: 80px; }
  }
  @media (min-width: 1024px) {
    .about-sec { padding-top: 96px; padding-bottom: 96px; }
  }
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }
  @media (min-width: 1024px) {
    .container { padding: 0 32px; }
  }
  .sec-head {
    max-width: 48rem;
    margin: 0 auto 64px;
    text-align: center;
  }
  .heading-lg {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: 1.875rem;
    color: var(--dental-purple);
    margin-bottom: 16px;
  }
  @media (min-width: 768px) {
    .heading-lg { font-size: 2.25rem; }
  }
  .gold-sep {
    width: 96px;
    height: 4px;
    background: var(--dental-gold);
    margin: 0 auto 24px;
  }
  .sec-sub { color: #525252; margin-bottom: 24px; }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 64px;
    align-items: center;
  }
  @media (min-width: 768px) {
    .about-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .about-img {
    aspect-ratio: 1 / 1;
    border-radius: 16px;
    overflow: hidden;
  }
  .about-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about-text {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }
  .about-paras {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .body-md {
    font-size: 1rem;
    color: rgb(56 31 71 / 0.8);
    line-height: 1.6;
  }
  @media (min-width: 768px) {
    .body-md { font-size: 1.125rem; }
  }
  .about-cta {
    padding-top: 24px;
    margin-top: auto;
  }
  .btn-purple {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--dental-purple);
    color: #fff;
    border-radius: 6px;
    padding: 20px 24px;
    margin-top: 16px;
    text-decoration: none;
    font-size: 0.875rem;
    transition: background-color 0.2s;
  }
  .btn-purple:hover { background: rgb(56 31 71 / 0.9); }
  .btn-2line {
    display: flex;
    flex-direction: column;
    text-align: left;
    line-height: 1.25;
  }
  .btn-l1 { font-weight: 500; }
  .btn-l2 { font-size: 0.75rem; color: rgb(255 255 255 / 0.8); }
</style>
