---
/**
 * SiteHeader — porte fiel de src/components/Header.tsx (React SPA).
 *
 * Fidelidade visual:
 *  - Header fixo, z-60; no desktop começa transparente (py-6) e vira
 *    beige/95 + blur + sombra ao rolar >10px (JS inline mínimo).
 *    No mobile é sempre beige (mesmo comportamento do original: isMobile → beige).
 *  - Badge Google ★5.0 (18 avaliações) → link para o Google Maps.
 *  - Nav: Início, Sobre, Tratamentos (dropdown com os 9 tratamentos),
 *    Blog, Depoimentos (âncora /#depoimentos), Contato, 🇺🇸 EN.
 *  - Dropdown desktop: CSS :hover/:focus-within (sem framework JS).
 *  - Menu mobile: checkbox hack (hamburger) + <details> para o submenu
 *    de Tratamentos. Navegação MPA fecha o menu naturalmente.
 *  - CTA WhatsApp verde escuro (#128C4A) — só no menu mobile, como no original.
 *    Tracking: class js-wa-cta + data-label (handler global do Base.astro).
 *
 * Nota: o link "Lentes de Contato Dental" aponta para a rota REAL
 * (/lentes-de-contato-dental-e-facetas-de-resina); o Header.tsx original
 * usava a URL antiga "-porcelana" que só redireciona.
 */
import { getEquivalentPath } from '@/utils/languageMap';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const enPath = getEquivalentPath(path, 'en');

const treatmentSubItems = [
  { title: 'Lentes de Contato Dental', path: '/lentes-de-contato-dental-e-facetas-de-resina' },
  { title: 'Clareamento Dental', path: '/clareamento-dental' },
  { title: 'Prótese Dentária', path: '/protese-dentaria' },
  { title: 'Implantes Dentários', path: '/implantes-dentarios' },
  { title: 'Ortodontia', path: '/ortodontia' },
  { title: 'Clínica Geral e Prevenção', path: '/clinica-geral-e-prevencao' },
  { title: 'Restaurações Estéticas', path: '/restauracoes-esteticas' },
  { title: 'Tratamento de Canal', path: '/tratamento-de-canal' },
  { title: 'Saúde da Gengiva', path: '/saude-da-gengiva' },
];

const isActive = (p: string) => (p === '/' ? path === '/' : path.startsWith(p));
const treatmentsActive = path.startsWith('/servicos') || treatmentSubItems.some((t) => path.startsWith(t.path));

const WA_HREF = 'https://wa.me/5521993304045?text=Ol%C3%A1!%20Gostaria%20de%20agendar%20uma%20consulta.';
---

<header class="site-hdr" id="site-header">
  <a href="#main-content" class="skip-link">Pular para o conteúdo</a>

  <!-- Checkbox do menu mobile (hamburger sem JS) -->
  <input type="checkbox" id="site-nav-toggle" class="nav-toggle" aria-label="Abrir menu" />

  <div class="hdr-inner">
    <a href="/" class="brand">Dra. Carla Christoph</a>

    <!-- Badge Google ★5.0 -->
    <a
      href="https://www.google.com/maps/place/Dra.+Carla+Christoph/@-22.9837862,-43.2055289,17z/"
      target="_blank"
      rel="noopener noreferrer"
      class="g-badge"
      aria-label="Veja nossas avaliações no Google - 5.0 estrelas com 18 avaliações"
    >
      <svg class="star" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      <b>5.0</b>
      <span class="g-count">(18 avaliações)</span>
    </a>

    <!-- Navegação desktop -->
    <nav class="desk-nav" aria-label="Navegação principal">
      <a href="/" class:list={['nav-link', { active: isActive('/') }]}>Início</a>
      <a href="/sobre" class:list={['nav-link', { active: isActive('/sobre') }]}>Sobre</a>

      <!-- Dropdown Tratamentos: :hover / :focus-within (sem JS) -->
      <div class="dd">
        <a href="/servicos" class:list={['nav-link', 'dd-trigger', { active: treatmentsActive }]}>
          Tratamentos
          <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </a>
        <div class="dd-panel">
          <div class="dd-card">
            {treatmentSubItems.map((sub) => (
              <a href={sub.path} class:list={['dd-item', { active: path === sub.path }]}>{sub.title}</a>
            ))}
            <div class="dd-all">
              <a href="/servicos" class="dd-item dd-item-all">Ver todos os tratamentos →</a>
            </div>
          </div>
        </div>
      </div>

      <a href="/blog" class:list={['nav-link', { active: isActive('/blog') }]}>Blog</a>
      <a href="/#depoimentos" class="nav-link">Depoimentos</a>
      <a href="/contato" class:list={['nav-link', { active: isActive('/contato') }]}>Contato</a>
      <a href={enPath} class="nav-link lang-link" title="View in English">🇺🇸 EN</a>
    </nav>

    <!-- Botão hamburger (mobile) -->
    <label for="site-nav-toggle" class="hamburger" aria-hidden="true">
      <svg class="ic-menu" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      <svg class="ic-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </label>
  </div>

  <!-- Menu mobile (overlay beige tela cheia) -->
  <div class="mob-menu">
    <nav class="mob-nav" aria-label="Menu mobile">
      <a href="/" class:list={['mob-link', { active: isActive('/') }]}>Início</a>
      <a href="/sobre" class:list={['mob-link', { active: isActive('/sobre') }]}>Sobre</a>

      <!-- Submenu Tratamentos: <details> nativo -->
      <details class="mob-dd">
        <summary class:list={['mob-link', 'mob-dd-summary', { active: treatmentsActive }]}>
          Tratamentos
          <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="mob-dd-list">
          {treatmentSubItems.map((sub) => (
            <a href={sub.path} class:list={['mob-dd-item', { active: path === sub.path }]}>{sub.title}</a>
          ))}
          <a href="/servicos" class="mob-dd-item mob-dd-all">Ver todos →</a>
        </div>
      </details>

      <a href="/blog" class:list={['mob-link', { active: isActive('/blog') }]}>Blog</a>
      <a href="/#depoimentos" class="mob-link">Depoimentos</a>
      <a href="/contato" class:list={['mob-link', { active: isActive('/contato') }]}>Contato</a>

      <!-- CTA WhatsApp — tracking via handler global (js-wa-cta) do Base.astro -->
      <a
        href={WA_HREF}
        class="mob-wa js-wa-cta"
        data-label="site_header-mobile_whatsapp"
        target="_blank"
        rel="noopener"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
        Agendar pelo WhatsApp
      </a>

      <a href={enPath} class="mob-lang">🇺🇸 English Version</a>
    </nav>
  </div>
</header>

<!-- JS mínimo: alterna .is-scrolled (>10px) — paridade com o isScrolled do React -->
<script is:inline>
  (function () {
    var h = document.getElementById('site-header');
    if (!h) return;
    function onScroll() {
      h.classList.toggle('is-scrolled', window.scrollY > 10);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>

<style>
  /* Beige do site (Tailwind --background: 51 22% 76%) — difere do beige claro das LPs */
  .site-hdr {
    --beige-site: hsl(51 22% 76%);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    padding: 24px 24px; /* py-6 px-6 */
    background: transparent;
    transition: all 0.3s;
  }
  @media (min-width: 1024px) {
    .site-hdr { padding-left: 48px; padding-right: 48px; } /* lg:px-12 */
  }
  .site-hdr.is-scrolled {
    padding-top: 12px;
    padding-bottom: 12px; /* py-3 */
    background: hsl(51 22% 76% / 0.95);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05); /* shadow-sm */
  }
  /* Mobile: sempre compacto e beige (paridade com isMobile do original) */
  @media (max-width: 767px) {
    .site-hdr {
      padding-top: 12px;
      padding-bottom: 12px;
      background: hsl(51 22% 76% / 0.95);
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
      box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    }
  }

  /* Skip link (acessibilidade) */
  .skip-link {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .skip-link:focus {
    width: auto;
    height: auto;
    clip: auto;
    top: 8px;
    left: 8px;
    z-index: 100;
    background: var(--dental-purple);
    color: #fff;
    padding: 8px 16px;
    border-radius: 6px;
    outline: none;
  }

  .hdr-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .brand {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.5rem; /* text-2xl */
    color: var(--dental-purple);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Badge Google */
  .g-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    background: rgb(255 255 255 / 0.5);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    border: 1px solid rgb(179 149 95 / 0.2);
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.2s;
  }
  .g-badge:hover {
    border-color: rgb(179 149 95 / 0.4);
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
  }
  @media (min-width: 1024px) {
    .g-badge { padding: 6px 12px; }
  }
  .g-badge .star { color: var(--dental-gold); flex-shrink: 0; }
  .g-badge b {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--dental-purple);
  }
  @media (min-width: 1024px) {
    .g-badge b { font-size: 0.875rem; }
  }
  .g-count {
    display: none;
    font-size: 0.75rem;
    color: rgb(56 31 71 / 0.7);
    transition: color 0.2s;
  }
  @media (min-width: 768px) {
    .g-count { display: inline; }
  }
  .g-badge:hover .g-count { color: var(--dental-purple); }

  /* Navegação desktop */
  .desk-nav {
    display: none;
    align-items: center;
    gap: 32px; /* gap-8 */
  }
  @media (min-width: 768px) {
    .desk-nav { display: flex; }
  }
  .nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: rgb(56 31 71 / 0.8);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-link:hover { color: var(--dental-gold); }
  .nav-link.active {
    color: var(--dental-gold);
    border-bottom: 2px solid var(--dental-gold);
    padding-bottom: 2px;
  }
  .lang-link {
    color: rgb(56 31 71 / 0.6);
    margin-left: 8px;
    border-left: 1px solid rgb(56 31 71 / 0.2);
    padding-left: 16px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  /* Dropdown Tratamentos (desktop) */
  .dd { position: relative; }
  .dd-trigger {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .dd .chev { transition: transform 0.2s; }
  .dd:hover .chev,
  .dd:focus-within .chev { transform: rotate(180deg); }
  .dd-panel {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(-8px);
    padding-top: 12px; /* pt-3 — “ponte” de hover entre o link e o card */
    opacity: 0;
    pointer-events: none;
    transition: all 0.2s;
  }
  .dd:hover .dd-panel,
  .dd:focus-within .dd-panel {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }
  .dd-card {
    background: #fff;
    border-radius: 12px;
    /* shadow-hover do index.css */
    box-shadow: 0 12px 32px rgba(56, 31, 71, 0.16), 0 6px 16px rgba(56, 31, 71, 0.1);
    border: 1px solid rgb(56 31 71 / 0.05);
    padding: 8px 0;
    min-width: 280px;
  }
  .dd-item {
    display: block;
    padding: 10px 20px;
    font-size: 0.875rem;
    color: rgb(56 31 71 / 0.8);
    text-decoration: none;
    transition: all 0.2s;
    white-space: nowrap;
  }
  .dd-item:hover {
    color: var(--dental-gold);
    background: hsl(51 22% 76% / 0.5);
  }
  .dd-item.active {
    color: var(--dental-gold);
    background: rgb(179 149 95 / 0.05);
    font-weight: 500;
  }
  .dd-all {
    border-top: 1px solid rgb(56 31 71 / 0.05);
    margin-top: 4px;
    padding-top: 4px;
  }
  .dd-item-all {
    color: var(--dental-gold);
    font-weight: 500;
  }

  /* Hamburger */
  .nav-toggle {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .hamburger {
    display: none;
    color: var(--dental-purple);
    padding: 8px;
    cursor: pointer;
    z-index: 70;
    position: relative;
  }
  @media (max-width: 767px) {
    .hamburger { display: block; }
  }
  .hamburger .ic-close { display: none; }
  .nav-toggle:checked ~ .hdr-inner .hamburger .ic-menu { display: none; }
  .nav-toggle:checked ~ .hdr-inner .hamburger .ic-close { display: block; }

  /* Menu mobile (overlay) */
  .mob-menu {
    display: none;
    position: fixed;
    inset: 0;
    background: hsl(51 22% 76%);
    z-index: 50;
    padding: 96px 24px 0; /* pt-24 px-6 */
    overflow-y: auto;
  }
  .nav-toggle:checked ~ .mob-menu { display: block; }
  @media (min-width: 768px) {
    .nav-toggle:checked ~ .mob-menu { display: none; }
  }
  .mob-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px; /* gap-5 */
    padding-bottom: 48px;
  }
  .mob-link {
    font-size: 1.25rem; /* text-xl */
    font-weight: 500;
    color: var(--dental-purple);
    text-decoration: none;
    transition: color 0.2s;
  }
  .mob-link:hover { color: var(--dental-gold); }
  .mob-link.active { color: var(--dental-gold); }

  /* Submenu mobile Tratamentos */
  .mob-dd {
    width: 100%;
    max-width: 320px;
    text-align: center;
  }
  .mob-dd-summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .mob-dd-summary::-webkit-details-marker { display: none; }
  .mob-dd .chev { transition: transform 0.2s; }
  .mob-dd[open] .chev { transform: rotate(180deg); }
  .mob-dd-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: rgb(255 255 255 / 0.5);
    border-radius: 12px;
    padding: 12px;
    margin-top: 12px;
  }
  .mob-dd-item {
    font-size: 1rem;
    padding: 8px 12px;
    border-radius: 8px;
    color: rgb(56 31 71 / 0.8);
    text-decoration: none;
    transition: all 0.2s;
  }
  .mob-dd-item:hover {
    color: var(--dental-gold);
    background: hsl(51 22% 76%);
  }
  .mob-dd-item.active {
    color: var(--dental-gold);
    background: rgb(179 149 95 / 0.1);
    font-weight: 500;
  }
  .mob-dd-all {
    color: var(--dental-gold);
    font-weight: 500;
    border-top: 1px solid rgb(56 31 71 / 0.1);
    margin-top: 4px;
    padding-top: 12px;
  }

  /* CTA WhatsApp mobile — verde escuro #128C4A (contraste AA, igual ao original) */
  .mob-wa {
    margin-top: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: #128c4a;
    color: #fff;
    padding: 12px 24px;
    border-radius: 999px;
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s;
  }
  .mob-wa:hover { background: #0f7540; }

  .mob-lang {
    margin-top: 8px;
    font-size: 1rem;
    font-weight: 500;
    color: rgb(56 31 71 / 0.6);
    text-decoration: none;
    transition: color 0.2s;
  }
  .mob-lang:hover { color: var(--dental-gold); }
</style>
