---
/**
 * EnLPHero — hero das 4 LPs EN (porte fiel de src/components/en/lp/EnLPHero.tsx
 * + variante local de EnCosmeticDentistryLP.tsx, Sprint 9/V5).
 * CTA usa js-wa-cta + data-label — handler global do Base.astro cuida do tracking.
 * Imagem: <picture> AVIF 480w/1024w + fallback WebP (800x1200 reais), eager + fetchpriority=high.
 */
interface Props {
  headline: string;
  subheadline: string;
  ctaText: string;
  benefits: string[];
  whatsappHref: string;
  labelPrefix: string;
}
const { headline, subheadline, ctaText, benefits, whatsappHref, labelPrefix } = Astro.props;
---

<section class="enlp-hero">
  <div class="enlp-hero-bg" aria-hidden="true"></div>

  <div class="enlp-hero-container">
    <div class="enlp-hero-grid">
      <!-- Left: Content -->
      <div class="enlp-hero-content">
        <!-- Trust badge -->
        <div class="enlp-hero-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#B3955F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
          We reply in your language
        </div>

        <h1 class="enlp-hero-headline">{headline}</h1>

        <p class="enlp-hero-sub">{subheadline}</p>

        <!-- Benefits -->
        <ul class="enlp-hero-benefits">
          {benefits.map((benefit) => (
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#B3955F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              {benefit}
            </li>
          ))}
        </ul>

        <!-- CTA -->
        <div class="enlp-hero-cta-wrap">
          <a
            class="enlp-hero-cta js-wa-cta"
            data-label={`${labelPrefix}_hero_whatsapp`}
            href={whatsappHref}
            target="_blank"
            rel="noopener"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
            <span class="enlp-hero-cta-text">{ctaText}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <!-- Micro trust line -->
        <p class="enlp-hero-trust">CRO-RJ 27.509 • Rua Visconde de Pirajá, 550 — Ipanema</p>
      </div>

      <!-- Right: Image -->
      <div class="enlp-hero-imgcol">
        <div class="enlp-hero-imgwrap">
          <div class="enlp-hero-imgglow" aria-hidden="true"></div>
          <picture class="enlp-hero-picture">
            <source
              srcset="/lovable-uploads/dra-carla-jaleco-bracos-cruzados-480.avif 480w, /lovable-uploads/dra-carla-jaleco-bracos-cruzados-1024.avif 1024w"
              sizes="(max-width:767px) 100vw, (min-width:768px) 50vw, 40vw"
              type="image/avif"
            />
            <img
              src="/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp"
              alt="Dr. Carla Christoph — Cosmetic Dentist in Ipanema, Rio de Janeiro"
              width="800"
              height="1200"
              loading="eager"
              fetchpriority="high"
            />
          </picture>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .enlp-hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    background: hsl(51 22% 76%); /* bg-dental-beige (token real do SPA) */
    padding: 80px 0 48px; /* pt-20 pb-12 — compensa o header fixo do LPLayout */
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .enlp-hero { padding: 96px 0 64px; } /* md:pt-24 md:pb-16 */
  }
  .enlp-hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom right, hsl(51 22% 76%), rgba(255, 255, 255, 0.5), hsl(51 22% 76%));
    pointer-events: none;
  }
  .enlp-hero-container {
    position: relative;
    z-index: 10;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 16px;
    width: 100%;
  }
  @media (min-width: 640px) { .enlp-hero-container { padding: 0 24px; } }
  @media (min-width: 1024px) { .enlp-hero-container { padding: 0 32px; } }
  .enlp-hero-grid {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .enlp-hero-grid { grid-template-columns: 1fr 1fr; gap: 64px; }
  }
  .enlp-hero-content {
    order: 2;
    display: flex;
    flex-direction: column;
    gap: 24px; /* space-y-6 */
    animation: enlpFadeInUp 0.6s ease-out forwards;
  }
  @media (min-width: 1024px) { .enlp-hero-content { order: 1; } }
  .enlp-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(179, 149, 95, 0.2);
    border-radius: 9999px;
    padding: 6px 16px;
    font-size: 0.75rem;
    color: #381f47;
    font-weight: 500;
  }
  .enlp-hero-headline {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    color: #381f47;
    font-size: 1.875rem; /* text-3xl */
    line-height: 1.15;
    letter-spacing: -0.025em;
  }
  @media (min-width: 640px) { .enlp-hero-headline { font-size: 2.25rem; } }
  @media (min-width: 1024px) { .enlp-hero-headline { font-size: 2.75rem; } }
  @media (min-width: 1280px) { .enlp-hero-headline { font-size: 3rem; } }
  .enlp-hero-sub {
    font-size: 1rem;
    color: #525252;
    line-height: 1.625;
    max-width: 36rem;
  }
  @media (min-width: 640px) { .enlp-hero-sub { font-size: 1.125rem; } }
  .enlp-hero-benefits {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px; /* space-y-2.5 */
  }
  .enlp-hero-benefits li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.875rem;
    color: #525252;
  }
  .enlp-hero-benefits svg { margin-top: 2px; flex-shrink: 0; }
  .enlp-hero-cta-wrap { padding-top: 8px; }
  .enlp-hero-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    width: 100%;
    background: #16a34a; /* green-600 */
    color: #fff;
    border-radius: 8px;
    padding: 20px 32px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    transition: all 0.3s;
  }
  @media (min-width: 640px) {
    .enlp-hero-cta { display: inline-flex; width: auto; font-size: 1.125rem; }
  }
  .enlp-hero-cta:hover {
    background: #15803d; /* green-700 */
    transform: translateY(-2px);
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
  }
  .enlp-hero-cta svg:first-child { margin-right: 12px; flex-shrink: 0; }
  .enlp-hero-cta svg:last-child { margin-left: 12px; flex-shrink: 0; }
  .enlp-hero-cta-text { text-align: left; line-height: 1.25; }
  .enlp-hero-trust { font-size: 0.75rem; color: rgba(82, 82, 82, 0.6); }
  .enlp-hero-imgcol {
    order: 1;
    display: flex;
    justify-content: center;
  }
  @media (min-width: 1024px) { .enlp-hero-imgcol { order: 2; } }
  .enlp-hero-imgwrap {
    position: relative;
    width: 100%;
    max-width: 28rem; /* max-w-md */
  }
  @media (min-width: 1024px) { .enlp-hero-imgwrap { max-width: 32rem; } }
  .enlp-hero-imgglow {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom right, rgba(179, 149, 95, 0.2), rgba(56, 31, 71, 0.1));
    border-radius: 16px;
    transform: rotate(-3deg) scale(1.03);
    filter: blur(4px);
  }
  .enlp-hero-picture { display: block; position: relative; }
  .enlp-hero-picture img {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 16px;
    box-shadow: 0 10px 40px -10px rgba(56, 31, 71, 0.2); /* shadow-elegant */
    aspect-ratio: 800 / 1200;
  }
  @keyframes enlpFadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
