---
/**
 * EnLPFloatingWhatsApp — porte fiel de src/components/en/lp/EnLPFloatingWhatsApp.tsx.
 * Botão flutuante mobile-only (md:hidden). Tracking via js-wa-cta (handler global).
 */
interface Props {
  whatsappHref: string;
  labelPrefix: string;
}
const { whatsappHref, labelPrefix } = Astro.props;
---

<a
  class="enlp-floating js-wa-cta"
  data-label={`${labelPrefix}_floating_whatsapp`}
  href={whatsappHref}
  target="_blank"
  rel="noopener"
  aria-label="Contact via WhatsApp"
>
  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
</a>

<style>
  .enlp-floating {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 50;
    background: #16a34a; /* green-600 */
    color: #fff;
    border-radius: 9999px;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    transition: all 0.3s;
  }
  .enlp-floating:hover {
    background: #15803d; /* green-700 */
    transform: scale(1.1);
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
  }
  @media (min-width: 768px) {
    .enlp-floating { display: none; } /* md:hidden */
  }
</style>
