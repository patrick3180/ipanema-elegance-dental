---
/**
 * EnLPServices — porte fiel de src/components/en/lp/EnLPServices.tsx (copy verbatim).
 * Usado somente na LP /en/lp/cosmetic-dentistry (mesma composição do SPA).
 */
const services = [
  {
    icon: 'sparkles',
    title: 'Porcelain Veneers',
    description:
      'Ultra-thin porcelain laminates that enhance shape, color, and alignment. Each veneer is custom-crafted after a Smile Test Drive approval.',
    image: '/lovable-uploads/en-lp-veneers.webp',
    width: 600,
    height: 360,
  },
  {
    icon: 'smile',
    title: 'Composite Bonding',
    description:
      'Direct composite restorations that mimic natural tooth texture. Ideal for chips, gaps, and minor corrections in a single visit.',
    image: '/lovable-uploads/en-lp-composite-bonding.webp',
    width: 600,
    height: 360,
  },
  {
    icon: 'sun',
    title: 'Teeth Whitening',
    description:
      "In-office and take-home protocols with professional-grade gel. Natural results — no fake-looking 'chiclet' teeth.",
    image: '/lovable-uploads/Ante e depois clareamento.webp',
    width: 1024,
    height: 1024,
  },
  {
    icon: 'scanline',
    title: 'Smile Test Drive',
    description:
      'Try your new smile before committing. Dr. Carla applies non-adherent resin on your teeth so you can see, feel, and approve the result in your own mouth.',
    image: '/lovable-uploads/en-lp-smile-test-drive.webp',
    width: 600,
    height: 360,
  },
];
---

<section class="enlp-services">
  <div class="enlp-services-container">
    <div class="enlp-services-head">
      <p class="enlp-services-kicker">Our Specializations</p>
      <h2>Cosmetic Dentistry Treatments</h2>
      <p class="enlp-services-sub">
        Every treatment is planned digitally and performed by Dr. Carla personally — from start to finish.
      </p>
    </div>

    <div class="enlp-services-grid">
      {services.map((service) => (
        <div class="enlp-service-card">
          <div class="enlp-service-imgwrap">
            <img
              src={service.image}
              alt={service.title}
              width={service.width}
              height={service.height}
              loading="lazy"
              decoding="async"
            />
            <div class="enlp-service-imgoverlay" aria-hidden="true"></div>
          </div>

          <div class="enlp-service-body">
            <div class="enlp-service-titlerow">
              {service.icon === 'sparkles' && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B3955F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/></svg>
              )}
              {service.icon === 'smile' && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B3955F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" x2="9.01" y1="9" y2="9"/><line x1="15" x2="15.01" y1="9" y2="9"/></svg>
              )}
              {service.icon === 'sun' && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B3955F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
              )}
              {service.icon === 'scanline' && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B3955F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><path d="M7 12h10"/></svg>
              )}
              <h3>{service.title}</h3>
            </div>
            <p>{service.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .enlp-services {
    padding: 64px 0;
    background: #fff;
  }
  @media (min-width: 768px) { .enlp-services { padding: 80px 0; } }
  .enlp-services-container {
    max-width: 1152px;
    margin: 0 auto;
    padding: 0 16px;
  }
  @media (min-width: 640px) { .enlp-services-container { padding: 0 24px; } }
  @media (min-width: 1024px) { .enlp-services-container { padding: 0 32px; } }
  .enlp-services-head {
    text-align: center;
    margin-bottom: 48px;
  }
  .enlp-services-kicker {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #b3955f;
    font-weight: 500;
    margin-bottom: 12px;
  }
  .enlp-services-head h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    color: #381f47;
    font-size: 1.5rem;
    margin-bottom: 16px;
  }
  @media (min-width: 640px) { .enlp-services-head h2 { font-size: 1.875rem; } }
  .enlp-services-sub {
    color: #525252;
    max-width: 42rem;
    margin: 0 auto;
  }
  .enlp-services-grid {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 640px) { .enlp-services-grid { grid-template-columns: 1fr 1fr; } }
  .enlp-service-card {
    background: hsla(51, 22%, 76%, 0.4); /* bg-dental-beige/40 */
    border: 1px solid rgba(56, 31, 71, 0.05);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.3s;
  }
  .enlp-service-card:hover {
    box-shadow: 0 10px 40px -10px rgba(56, 31, 71, 0.2); /* shadow-elegant */
    border-color: rgba(179, 149, 95, 0.2);
  }
  .enlp-service-imgwrap {
    position: relative;
    height: 192px; /* h-48 */
    overflow: hidden;
  }
  .enlp-service-imgwrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }
  .enlp-service-card:hover .enlp-service-imgwrap img { transform: scale(1.05); }
  .enlp-service-imgoverlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(56, 31, 71, 0.4), transparent);
  }
  .enlp-service-body { padding: 20px; }
  .enlp-service-titlerow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }
  .enlp-service-titlerow svg { flex-shrink: 0; }
  .enlp-service-titlerow h3 {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    color: #381f47;
    font-size: 1.125rem;
  }
  .enlp-service-body p {
    font-size: 0.875rem;
    color: #525252;
    line-height: 1.625;
  }
</style>
