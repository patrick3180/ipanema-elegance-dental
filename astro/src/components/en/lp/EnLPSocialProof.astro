---
/** EnLPSocialProof — porte fiel de src/components/en/lp/EnLPSocialProof.tsx */
import { GOOGLE_REVIEWS_URL } from '../../../lib/googleBusiness';

interface Testimonial {
  name: string;
  text: string;
}
interface Stat {
  number: string;
  label: string;
}
interface Props {
  title: string;
  testimonials: Testimonial[];
  stats?: Stat[];
}
const { title, testimonials, stats } = Astro.props;
---

<section class="enlp-social">
  <div class="enlp-social-container">
    {stats && stats.length > 0 && (
      <div class="enlp-social-stats">
        {stats.map((stat) => (
          <div class="enlp-social-stat">
            <p class="enlp-social-stat-number">{stat.number}</p>
            <p class="enlp-social-stat-label">{stat.label}</p>
          </div>
        ))}
      </div>
    )}

    <div class="enlp-social-head">
      <p class="enlp-social-kicker">Patient Stories</p>
      <h2>{title}</h2>
    </div>

    <div class="enlp-social-grid">
      {testimonials.map((testimonial) => (
        <div class="enlp-social-card">
          <div class="enlp-social-stars" aria-label="5 stars">
            {[1, 2, 3, 4, 5].map(() => (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="#B3955F" stroke="#B3955F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            ))}
          </div>

          <p class="enlp-social-quote">"{testimonial.text}"</p>

          <p class="enlp-social-name">— {testimonial.name}</p>
        </div>
      ))}
    </div>

    <div class="enlp-social-glink">
      <a
        href={GOOGLE_REVIEWS_URL}
        target="_blank"
        rel="noopener noreferrer"
      >See all reviews on Google Maps →</a>
    </div>
  </div>
</section>

<style>
  .enlp-social {
    padding: 64px 0;
    background: #fff;
  }
  @media (min-width: 768px) { .enlp-social { padding: 80px 0; } }
  .enlp-social-container {
    max-width: 1024px;
    margin: 0 auto;
    padding: 0 16px;
  }
  @media (min-width: 640px) { .enlp-social-container { padding: 0 24px; } }
  @media (min-width: 1024px) { .enlp-social-container { padding: 0 32px; } }
  .enlp-social-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 56px;
  }
  @media (min-width: 640px) { .enlp-social-stats { grid-template-columns: repeat(4, 1fr); } }
  .enlp-social-stat {
    text-align: center;
    background: hsla(51, 22%, 76%, 0.6); /* bg-dental-beige/60 */
    border: 1px solid rgba(56, 31, 71, 0.05);
    border-radius: 12px;
    padding: 20px 12px;
  }
  .enlp-social-stat-number {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    color: #381f47;
    font-size: 1.5rem;
  }
  @media (min-width: 640px) { .enlp-social-stat-number { font-size: 1.875rem; } }
  .enlp-social-stat-label {
    font-size: 0.75rem;
    color: #525252;
    margin-top: 4px;
    text-transform: uppercase;
    letter-spacing: 0.025em;
  }
  .enlp-social-head {
    text-align: center;
    margin-bottom: 40px;
  }
  .enlp-social-kicker {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #b3955f;
    font-weight: 500;
    margin-bottom: 12px;
  }
  .enlp-social-head h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    color: #381f47;
    font-size: 1.5rem;
  }
  @media (min-width: 640px) { .enlp-social-head h2 { font-size: 1.875rem; } }
  .enlp-social-grid {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 768px) { .enlp-social-grid { grid-template-columns: repeat(3, 1fr); } }
  .enlp-social-card {
    background: hsla(51, 22%, 76%, 0.4); /* bg-dental-beige/40 */
    border: 1px solid rgba(56, 31, 71, 0.05);
    border-radius: 16px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: box-shadow 0.15s;
  }
  .enlp-social-card:hover {
    box-shadow: 0 10px 40px -10px rgba(56, 31, 71, 0.2); /* shadow-elegant */
  }
  .enlp-social-stars {
    display: flex;
    gap: 2px;
  }
  .enlp-social-quote {
    font-size: 0.875rem;
    color: #525252;
    line-height: 1.625;
    font-style: italic;
  }
  .enlp-social-name {
    font-size: 0.75rem;
    color: #381f47;
    font-weight: 500;
  }
  .enlp-social-glink {
    text-align: center;
    margin-top: 32px;
  }
  .enlp-social-glink a {
    font-size: 0.75rem;
    color: rgba(82, 82, 82, 0.6);
    text-decoration: underline;
    transition: color 0.15s;
  }
  .enlp-social-glink a:hover { color: #b3955f; }
</style>
