---
/** EnLPGuide — porte fiel de src/components/en/lp/EnLPGuide.tsx */
interface Step {
  number: string;
  title: string;
  description: string;
}
interface Props {
  title: string;
  subtitle: string;
  steps: Step[];
}
const { title, subtitle, steps } = Astro.props;
---

<section class="enlp-guide">
  <div class="enlp-guide-container">
    <div class="enlp-guide-head">
      <p class="enlp-guide-kicker">Your Treatment Journey</p>
      <h2>{title}</h2>
      <p class="enlp-guide-sub">{subtitle}</p>
    </div>

    <div class="enlp-guide-steps">
      {steps.map((step, idx) => (
        <div class="enlp-guide-step">
          <div class="enlp-guide-marker">
            <div class="enlp-guide-number">{step.number}</div>
            {idx < steps.length - 1 && <div class="enlp-guide-line" aria-hidden="true"></div>}
          </div>

          <div class="enlp-guide-card">
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .enlp-guide {
    padding: 64px 0;
    background: hsla(51, 22%, 76%, 0.4); /* bg-dental-beige/40 */
  }
  @media (min-width: 768px) { .enlp-guide { padding: 80px 0; } }
  .enlp-guide-container {
    max-width: 896px;
    margin: 0 auto;
    padding: 0 16px;
  }
  @media (min-width: 640px) { .enlp-guide-container { padding: 0 24px; } }
  @media (min-width: 1024px) { .enlp-guide-container { padding: 0 32px; } }
  .enlp-guide-head {
    text-align: center;
    margin-bottom: 48px;
  }
  .enlp-guide-kicker {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #b3955f;
    font-weight: 500;
    margin-bottom: 12px;
  }
  .enlp-guide-head h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    color: #381f47;
    font-size: 1.5rem;
    margin-bottom: 16px;
  }
  @media (min-width: 640px) { .enlp-guide-head h2 { font-size: 1.875rem; } }
  .enlp-guide-sub {
    color: #525252;
    max-width: 42rem;
    margin: 0 auto;
    font-size: 0.875rem;
  }
  .enlp-guide-steps {
    display: flex;
    flex-direction: column;
    gap: 24px; /* space-y-6 */
  }
  .enlp-guide-step {
    position: relative;
    display: flex;
    gap: 20px;
  }
  .enlp-guide-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }
  .enlp-guide-number {
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    background: #381f47;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: 0.875rem;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  }
  .enlp-guide-line {
    width: 1px;
    height: 100%;
    background: rgba(56, 31, 71, 0.15);
    margin-top: 8px;
  }
  .enlp-guide-card {
    background: #fff;
    border-radius: 12px;
    border: 1px solid rgba(56, 31, 71, 0.05);
    padding: 20px;
    flex: 1;
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    transition: box-shadow 0.15s;
  }
  .enlp-guide-card:hover {
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
  }
  .enlp-guide-card h3 {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    color: #381f47;
    font-size: 1.125rem;
    margin-bottom: 6px;
  }
  .enlp-guide-card p {
    font-size: 0.875rem;
    color: #525252;
    line-height: 1.625;
  }
</style>
