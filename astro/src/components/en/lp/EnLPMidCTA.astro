---
/** EnLPMidCTA — porte fiel de src/components/en/lp/EnLPMidCTA.tsx (copy verbatim). */
interface Props {
  whatsappHref: string;
  labelPrefix: string;
}
const { whatsappHref, labelPrefix } = Astro.props;
---

<section class="enlp-midcta">
  <div class="enlp-midcta-container">
    <p class="enlp-midcta-lead">
      Wondering what your treatment plan could look like? Send a smile photo via WhatsApp — Dr. Carla will personally assess your case.
    </p>
    <a
      class="enlp-midcta-btn js-wa-cta"
      data-label={`${labelPrefix}_mid_whatsapp`}
      href={whatsappHref}
      target="_blank"
      rel="noopener"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
      Send Your Photos via WhatsApp
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
    <p class="enlp-midcta-note">Private practice in Ipanema • We reply in your language</p>
  </div>
</section>

<style>
  .enlp-midcta {
    padding: 40px 0; /* py-10 */
    background: #381f47;
  }
  .enlp-midcta-container {
    max-width: 768px;
    margin: 0 auto;
    padding: 0 16px;
    text-align: center;
  }
  @media (min-width: 640px) { .enlp-midcta-container { padding: 0 24px; } }
  @media (min-width: 1024px) { .enlp-midcta-container { padding: 0 32px; } }
  .enlp-midcta-lead {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.875rem;
    margin-bottom: 16px;
  }
  .enlp-midcta-btn {
    display: inline-flex;
    align-items: center;
    background: #b3955f;
    color: #fff;
    border-radius: 8px;
    padding: 20px 32px;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(179, 149, 95, 0.3); /* shadow-gold */
    transition: all 0.3s;
  }
  .enlp-midcta-btn:hover {
    background: #9d7f4f; /* dental-gold-dark */
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(56, 31, 71, 0.16), 0 6px 16px rgba(56, 31, 71, 0.1); /* shadow-hover */
  }
  .enlp-midcta-btn svg:first-child { margin-right: 12px; }
  .enlp-midcta-btn svg:last-child { margin-left: 12px; }
  .enlp-midcta-note {
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.75rem;
    margin-top: 12px;
  }
</style>
