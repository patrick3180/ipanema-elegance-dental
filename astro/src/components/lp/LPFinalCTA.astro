---
/**
 * LPFinalCTA — porte de src/components/landing/consulta/ConsultaInicialCTA.tsx
 * Seção roxa final com CTA verde + trust indicators (24h / +1 hora / 20+ anos).
 */
interface Props {
  title: string;
  subtitle: string;
  buttonText: string;
  urgency?: string;
  whatsappHref: string;
  waLabel: string; // data-label único (ex.: lp-facetas-resina_final_whatsapp)
}
const { title, subtitle, buttonText, urgency, whatsappHref, waLabel } = Astro.props;
---

<section class="lp-finalcta">
  <div class="lp-finalcta-container">
    <div class="lp-finalcta-inner">
      <div class="lp-finalcta-header">
        <h2>{title}</h2>
        <p class="lp-finalcta-sub">{subtitle}</p>
        {urgency && <p class="lp-finalcta-urgency">{urgency}</p>}
      </div>

      <div class="lp-finalcta-btnwrap">
        <a
          class="lp-finalcta-btn js-wa-cta"
          data-label={waLabel}
          href={whatsappHref}
          target="_blank"
          rel="noopener"
          aria-label="Conversar pelo WhatsApp"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
          {buttonText}
        </a>
      </div>

      <div class="lp-finalcta-trust">
        <div class="lp-finalcta-trust-item">
          <div class="lp-finalcta-trust-value">24h</div>
          <div class="lp-finalcta-trust-label">Atendimento WhatsApp</div>
        </div>
        <div class="lp-finalcta-trust-item">
          <div class="lp-finalcta-trust-value">+1 hora</div>
          <div class="lp-finalcta-trust-label">Consulta sem pressa</div>
        </div>
        <div class="lp-finalcta-trust-item">
          <div class="lp-finalcta-trust-value">20+ anos</div>
          <div class="lp-finalcta-trust-label">Experiência comprovada</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .lp-finalcta { background: #381f47; padding: 4rem 0; }
  @media (min-width: 1024px) {
    .lp-finalcta { padding: 6rem 0; }
  }
  .lp-finalcta-container { max-width: 1280px; margin: 0 auto; padding: 0 1rem; }
  .lp-finalcta-inner {
    max-width: 896px;
    margin: 0 auto;
    text-align: center;
    display: grid;
    gap: 2rem;
  }
  .lp-finalcta-header { display: grid; gap: 1.5rem; }
  .lp-finalcta-header h2 {
    font-size: 1.875rem;
    font-weight: 700;
    color: #fff;
    font-family: 'Playfair Display', Georgia, serif;
  }
  @media (min-width: 768px) {
    .lp-finalcta-header h2 { font-size: 2.25rem; }
  }
  .lp-finalcta-sub {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.625;
  }
  @media (min-width: 768px) {
    .lp-finalcta-sub { font-size: 1.25rem; }
  }
  .lp-finalcta-urgency {
    font-size: 0.875rem;
    color: #b3955f;
    font-style: italic;
  }
  @media (min-width: 768px) {
    .lp-finalcta-urgency { font-size: 1rem; }
  }
  .lp-finalcta-btnwrap { display: flex; justify-content: center; }
  .lp-finalcta-btn {
    background: #25d366;
    color: #fff;
    border-radius: 0.5rem;
    padding: 1rem 2rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
  }
  .lp-finalcta-btn:hover {
    background: #1ea952;
    transform: scale(1.05);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }
  @media (min-width: 768px) {
    .lp-finalcta-btn { padding: 1.25rem 3rem; font-size: 1.25rem; }
  }
  .lp-finalcta-trust {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }
  @media (min-width: 768px) {
    .lp-finalcta-trust { grid-template-columns: repeat(3, 1fr); }
  }
  .lp-finalcta-trust-item { text-align: center; }
  .lp-finalcta-trust-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: #b3955f;
    margin-bottom: 0.5rem;
  }
  .lp-finalcta-trust-label {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.875rem;
  }
</style>
