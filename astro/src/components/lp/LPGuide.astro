---
/**
 * LPGuide — porte de src/components/landing/consulta/ConsultaInicialGuide.tsx
 * Cards de credenciais/passos com CheckCircle dourado.
 */
interface GuideStep {
  number: string;
  title: string;
  description: string;
  icon?: string;
}
interface Props {
  title: string;
  subtitle: string;
  steps: GuideStep[];
}
const { title, subtitle, steps } = Astro.props;

// Mesma lógica de grid do React
const isThreeCols = steps.length === 3 || steps.length === 6;
const isOddLast = (index: number) =>
  steps.length % 2 !== 0 && index === steps.length - 1 && !isThreeCols;
---

<section class="lp-guide">
  <div class="lp-guide-container">
    <div class="lp-guide-inner">
      <div class="lp-guide-header">
        <h2>{title}</h2>
        <p>{subtitle}</p>
      </div>

      <div class:list={['lp-guide-grid', isThreeCols ? 'cols-three' : 'cols-two']}>
        {steps.map((step, index) => (
          <div class:list={['lp-guide-card', isOddLast(index) && 'odd-last']}>
            <div class="lp-guide-row">
              <div class="lp-guide-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#B3955F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.27"/></svg>
              </div>
              <div class="lp-guide-body">
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .lp-guide { background: #f9fafb; padding: 4rem 0; }
  @media (min-width: 1024px) {
    .lp-guide { padding: 6rem 0; }
  }
  .lp-guide-container { max-width: 1280px; margin: 0 auto; padding: 0 1rem; }
  .lp-guide-inner { max-width: 896px; margin: 0 auto; }
  .lp-guide-header { text-align: center; display: grid; gap: 1.5rem; margin-bottom: 4rem; }
  .lp-guide-header h2 {
    font-size: 1.875rem;
    font-weight: 700;
    color: #381f47;
    font-family: 'Playfair Display', Georgia, serif;
  }
  @media (min-width: 768px) {
    .lp-guide-header h2 { font-size: 2.25rem; }
  }
  .lp-guide-header p {
    font-size: 1.125rem;
    color: #333;
    line-height: 1.625;
    max-width: 672px;
    margin: 0 auto;
  }
  .lp-guide-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
  .cols-two { max-width: 768px; margin: 0 auto; }
  @media (min-width: 640px) {
    .cols-two { grid-template-columns: 1fr 1fr; }
    .cols-two .odd-last { grid-column: span 2; max-width: 24rem; margin: 0 auto; }
  }
  @media (min-width: 768px) {
    .cols-three { grid-template-columns: 1fr 1fr 1fr; }
  }
  .lp-guide-card {
    background: #fff;
    border-radius: 0.5rem;
    padding: 1.5rem;
    transition: box-shadow 0.3s;
  }
  .lp-guide-card:hover {
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
  }
  .lp-guide-row { display: flex; align-items: center; gap: 1rem; }
  .lp-guide-icon {
    width: 3rem;
    height: 3rem;
    background: rgba(179, 149, 95, 0.2);
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .lp-guide-body { flex: 1; }
  .lp-guide-body h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: #381f47;
    margin-bottom: 0.5rem;
    font-family: Montserrat, system-ui, sans-serif;
  }
  .lp-guide-body p { color: #333; line-height: 1.625; }
</style>
