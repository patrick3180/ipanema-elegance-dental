---
/**
 * LPStatsBar — porte de src/components/treatment/StatsBar.tsx (locale pt).
 * Sinal de autoridade logo abaixo do hero (20+ anos, 4.000+ pacientes, CRO, 5.0 Google).
 */
---
<section class="lp-stats" aria-label="Estatísticas da clínica">
  <div class="lp-stats-inner">
    <div class="lp-stats-grid">
      <div class="lp-stat">
        <div class="lp-stat-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#b3955f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
        </div>
        <div>
          <p class="lp-stat-value">20+</p>
          <p class="lp-stat-label">Anos de Experiência</p>
        </div>
      </div>
      <div class="lp-stat">
        <div class="lp-stat-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#b3955f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div>
          <p class="lp-stat-value">4.000+</p>
          <p class="lp-stat-label">Pacientes Atendidos</p>
        </div>
      </div>
      <div class="lp-stat">
        <div class="lp-stat-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#b3955f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
        </div>
        <div>
          <p class="lp-stat-value">CRO-RJ</p>
          <p class="lp-stat-label">27.509</p>
        </div>
      </div>
      <div class="lp-stat">
        <div class="lp-stat-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="#b3955f" stroke="#b3955f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <div>
          <p class="lp-stat-value">5.0 ★</p>
          <p class="lp-stat-label">Avaliação Google</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .lp-stats {
    background: rgba(56, 31, 71, 0.05);
    border-top: 1px solid rgba(56, 31, 71, 0.1);
    border-bottom: 1px solid rgba(56, 31, 71, 0.1);
  }
  .lp-stats-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.5rem 1rem;
  }
  .lp-stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .lp-stats-grid { grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  }
  .lp-stat {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    justify-content: center;
  }
  .lp-stat-icon {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    background: rgba(179, 149, 95, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lp-stat-value {
    font-size: 1.125rem;
    font-weight: 600;
    color: #381f47;
    line-height: 1.25;
  }
  .lp-stat-label {
    font-size: 0.75rem;
    color: #6b6b6b;
    line-height: 1.25;
  }
</style>
