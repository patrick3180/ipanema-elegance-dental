---
/**
 * LPComparacaoResinaPorcelana — porte de
 * src/components/landing/consulta/ComparacaoResinaPorcelana.tsx
 * Tabela comparativa (desktop) + cards empilhados (mobile) + cards "quando escolher".
 * Comparativo de investimento é QUALITATIVO (sem cifras) — permitido pelo CRO.
 */

// Ícones lucide (paths idênticos aos usados no React)
const icons = {
  layers: '<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>',
  clock: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  droplet: '<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>',
  calendarDays: '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/>',
  wrench: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  wallet: '<path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/>',
  gem: '<path d="M6 3h12l4 6-10 13L2 9Z"/><path d="M11 3 8 9l4 13 4-13-3-6"/><path d="M2 9h20"/>',
};

const linhas = [
  { icon: icons.layers, criterio: 'Material', resina: 'Resina composta nanoparticulada', porcelana: 'Porcelana de alta translucidez' },
  { icon: icons.clock, criterio: 'Durabilidade', resina: '5 a 8 anos', porcelana: '15 a 20 anos' },
  { icon: icons.droplet, criterio: 'Manchamento', resina: 'Pode manchar com o tempo', porcelana: 'Não mancha' },
  { icon: icons.calendarDays, criterio: 'Nº de sessões', resina: '1 a 2 (resultado rápido)', porcelana: '2 a 3 (15 a 20 dias)' },
  { icon: icons.wrench, criterio: 'Reparos', resina: 'Permite reparos pontuais', porcelana: 'Substituição, não reparo pontual' },
  { icon: icons.wallet, criterio: 'Investimento', resina: 'Mais acessível', porcelana: 'Maior — pensado para o longo prazo' },
  { icon: icons.gem, criterio: 'Naturalidade', resina: 'Muito boa', porcelana: 'Translucidez superior' },
];
---

<section class="lp-comp" aria-label="Comparação entre resina e porcelana">
  <div class="lp-comp-container">
    <div class="lp-comp-inner">
      <div class="lp-comp-header">
        <h2>Lente de Contato Dental: Resina × Porcelana</h2>
        <p>
          Os dois materiais deixam o sorriso natural e fecham diastemas. A diferença está nos detalhes abaixo —
          e a indicação certa para o seu caso é definida na consulta.
        </p>
      </div>

      <!-- Tabela (desktop) -->
      <div class="lp-comp-tablewrap">
        <table>
          <thead>
            <tr>
              <th class="lp-comp-th-criterio">Critério</th>
              <th class="lp-comp-th-resina">Faceta de Resina</th>
              <th class="lp-comp-th-porcelana">Lente de Porcelana</th>
            </tr>
          </thead>
          <tbody>
            {linhas.map((linha, i) => (
              <tr class={i % 2 === 0 ? 'row-even' : 'row-odd'}>
                <td class="lp-comp-td-criterio">
                  <span class="lp-comp-criterio">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B3955F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={linha.icon} />
                    {linha.criterio}
                  </span>
                </td>
                <td class="lp-comp-td-resina">{linha.resina}</td>
                <td class="lp-comp-td-porcelana">{linha.porcelana}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Cards empilhados (mobile) -->
      <div class="lp-comp-cards">
        {linhas.map((linha) => (
          <div class="lp-comp-card">
            <div class="lp-comp-card-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B3955F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={linha.icon} />
              {linha.criterio}
            </div>
            <div class="lp-comp-card-grid">
              <div class="lp-comp-card-resina">
                <p class="lp-comp-card-label">Resina</p>
                <p class="lp-comp-card-text">{linha.resina}</p>
              </div>
              <div class="lp-comp-card-porcelana">
                <p class="lp-comp-card-label">Porcelana</p>
                <p class="lp-comp-card-text">{linha.porcelana}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Quando cada material é a melhor escolha -->
      <div class="lp-comp-quando">
        <div class="lp-comp-quando-card borda-resina">
          <h3>Quando a resina costuma ser a melhor escolha</h3>
          <ul>
            <li>• Você quer resultado mais rápido, em 1 ou 2 sessões.</li>
            <li>• Busca um investimento mais acessível neste momento.</li>
            <li>• Casos de ajustes pontuais de formato, cor ou pequenos espaços.</li>
            <li>• Permite ajustes e reparos pontuais ao longo do tempo.</li>
          </ul>
        </div>
        <div class="lp-comp-quando-card borda-porcelana">
          <h3>Quando a porcelana costuma ser a melhor escolha</h3>
          <ul>
            <li>• Você quer máxima durabilidade — 15 a 20 anos.</li>
            <li>• Não quer se preocupar com manchas de café, vinho ou cigarro.</li>
            <li>• Busca translucidez superior e estabilidade de cor a longo prazo.</li>
            <li>• Casos que pedem mudança estética mais ampla e duradoura.</li>
          </ul>
        </div>
      </div>

      <p class="lp-comp-note">
        A escolha ideal depende do seu caso. Na consulta, a Dra. Carla avalia e recomenda a melhor opção para você —
        e o Test Drive do Sorriso ajuda a decidir com segurança.
      </p>
    </div>
  </div>
</section>

<style>
  .lp-comp { background: #faf7f2; padding: 4rem 0; }
  @media (min-width: 1024px) {
    .lp-comp { padding: 6rem 0; }
  }
  .lp-comp-container { max-width: 1280px; margin: 0 auto; padding: 0 1rem; }
  .lp-comp-inner { max-width: 1024px; margin: 0 auto; display: grid; gap: 3rem; }
  .lp-comp-header { text-align: center; display: grid; gap: 1rem; }
  .lp-comp-header h2 {
    font-size: 1.875rem;
    font-weight: 700;
    color: #381f47;
    font-family: 'Playfair Display', Georgia, serif;
  }
  @media (min-width: 768px) {
    .lp-comp-header h2 { font-size: 2.25rem; }
  }
  .lp-comp-header p {
    font-size: 1.125rem;
    color: #333;
    line-height: 1.625;
    max-width: 672px;
    margin: 0 auto;
  }
  /* Tabela desktop */
  .lp-comp-tablewrap {
    display: none;
    overflow: hidden;
    border-radius: 1rem;
    box-shadow: 0 8px 30px rgba(56, 31, 71, 0.08);
    background: #fff;
  }
  @media (min-width: 768px) {
    .lp-comp-tablewrap { display: block; }
  }
  .lp-comp-tablewrap table { width: 100%; border-collapse: collapse; }
  .lp-comp-tablewrap th { text-align: left; padding: 1.25rem; width: 33.333%; }
  .lp-comp-th-criterio {
    font-size: 0.875rem;
    font-weight: 600;
    color: #6b6b6b;
    text-transform: uppercase;
    letter-spacing: 0.025em;
  }
  .lp-comp-th-resina {
    font-size: 1rem;
    font-weight: 700;
    color: #381f47;
    background: rgba(179, 149, 95, 0.1);
  }
  .lp-comp-th-porcelana {
    font-size: 1rem;
    font-weight: 700;
    color: #381f47;
    background: rgba(56, 31, 71, 0.06);
  }
  .lp-comp-tablewrap td { padding: 1.25rem; vertical-align: top; font-size: 15px; color: #333; }
  .row-even { background: #fff; }
  .row-odd { background: rgba(250, 247, 242, 0.6); }
  .lp-comp-td-resina { background: rgba(179, 149, 95, 0.04); }
  .lp-comp-td-porcelana { background: rgba(56, 31, 71, 0.03); }
  .lp-comp-criterio {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: #381f47;
    font-size: 15px;
  }
  /* Cards mobile */
  .lp-comp-cards { display: grid; gap: 1rem; }
  @media (min-width: 768px) {
    .lp-comp-cards { display: none; }
  }
  .lp-comp-card {
    background: #fff;
    border-radius: 0.75rem;
    box-shadow: 0 4px 16px rgba(56, 31, 71, 0.08);
    padding: 1.25rem;
  }
  .lp-comp-card-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: #381f47;
    font-size: 15px;
    margin-bottom: 0.75rem;
  }
  .lp-comp-card-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .lp-comp-card-resina { border-radius: 0.5rem; background: rgba(179, 149, 95, 0.08); padding: 0.75rem; }
  .lp-comp-card-porcelana { border-radius: 0.5rem; background: rgba(56, 31, 71, 0.05); padding: 0.75rem; }
  .lp-comp-card-label { font-size: 0.75rem; font-weight: 700; color: #381f47; margin-bottom: 0.25rem; }
  .lp-comp-card-text { font-size: 13px; color: #333; line-height: 1.375; }
  /* Quando escolher */
  .lp-comp-quando { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 768px) {
    .lp-comp-quando { grid-template-columns: 1fr 1fr; }
  }
  .lp-comp-quando-card {
    background: #fff;
    border-radius: 1rem;
    padding: 1.75rem;
    box-shadow: 0 4px 16px rgba(56, 31, 71, 0.06);
  }
  .borda-resina { border-top: 4px solid rgba(179, 149, 95, 0.6); }
  .borda-porcelana { border-top: 4px solid rgba(56, 31, 71, 0.5); }
  .lp-comp-quando-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #381f47;
    font-family: 'Playfair Display', Georgia, serif;
    margin-bottom: 0.75rem;
  }
  .lp-comp-quando-card ul { list-style: none; display: grid; gap: 0.5rem; }
  .lp-comp-quando-card li { color: #333; font-size: 15px; line-height: 1.625; }
  .lp-comp-note {
    text-align: center;
    color: #6b6b6b;
    font-style: italic;
    max-width: 672px;
    margin: 0 auto;
  }
</style>
