---
/**
 * LPFloatingWhatsApp — porte de src/components/landing/FloatingWhatsApp.tsx
 * Botão flutuante mobile-only (md:hidden) com badge "24h".
 * CTA usa js-wa-cta (handler global do Base.astro).
 */
interface Props {
  whatsappHref: string;
  waLabel: string; // data-label único (ex.: lp-clareamento_floating_whatsapp)
}
const { whatsappHref, waLabel } = Astro.props;
---

<a
  class="lp-float-wa js-wa-cta"
  data-label={waLabel}
  href={whatsappHref}
  target="_blank"
  rel="noopener"
  aria-label="Converse pelo WhatsApp"
>
  <svg class="lp-float-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
  <span class="lp-float-badge">24h</span>
</a>

<style>
  .lp-float-wa {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 50;
    background: #25d366;
    color: #fff;
    border-radius: 9999px;
    padding: 1rem;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
    transition: all 0.3s;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }
  .lp-float-wa:hover {
    background: #1ea952;
    transform: scale(1.05);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
  }
  @media (min-width: 768px) {
    .lp-float-wa { display: none; }
  }
  @keyframes lp-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
  .lp-float-icon { animation: lp-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
  .lp-float-badge {
    position: absolute;
    top: -0.25rem;
    right: -0.25rem;
    background: #ef4444;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.125rem 0.375rem;
    border-radius: 9999px;
    border: 2px solid #fff;
  }
</style>
