---
/**
 * LPHero — porte de src/components/landing/consulta/ConsultaInicialHero.tsx
 * Hero padrão das LPs config-driven (Google Ads).
 * Copy 100% via props (verbatim dos configs). CTA usa js-wa-cta (handler global).
 * AVIF paths derivados do webp (-480 mobile / -1024 desktop) — mesmo esquema do React.
 */
interface Props {
  headline: string;
  subheadline: string;
  ctaText: string;
  benefits: string[];
  backgroundImage: string; // ex.: /lovable-uploads/xxx.webp
  whatsappHref: string;
  waLabel: string; // data-label único (ex.: lp-clareamento_hero_whatsapp)
  imgWidth: number; // dimensões REAIS do arquivo webp
  imgHeight: number;
}
const { headline, subheadline, ctaText, benefits, backgroundImage, whatsappHref, waLabel, imgWidth, imgHeight } = Astro.props;

const base = backgroundImage.replace(/\.webp$/, '');
const avifMobile = `${base}-480.avif`;
const avifDesktop = `${base}-1024.avif`;
---

<section class="lp-hero">
  <div class="lp-hero-radial" aria-hidden="true"></div>
  <div class="lp-hero-container">
    <div class="lp-hero-flex">
      <!-- Conteúdo — 60% no desktop -->
      <div class="lp-hero-content">
        <p class="lp-hero-eyebrow">Dentista em Ipanema · Zona Sul</p>

        <div class="lp-hero-badges">
          <span class="lp-hero-badge">Atendimento Particular</span>
        </div>

        <div class="lp-hero-headlines">
          <h1 class="lp-hero-h1">{headline}</h1>
          <p class="lp-hero-sub">{subheadline}</p>
        </div>

        <div class="lp-hero-benefits">
          {benefits.map((benefit) => (
            <span class="lp-hero-pill"><span class="lp-dot">●</span>{benefit}</span>
          ))}
        </div>

        <div class="lp-hero-cta-wrap">
          <a
            class="lp-hero-cta js-wa-cta"
            data-label={waLabel}
            href={whatsappHref}
            target="_blank"
            rel="noopener"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
            {ctaText}
          </a>
          <!-- Prova social do Google — dado real 5,0/17 (BRAND.md §6) -->
          <a
            href="https://www.google.com/maps/place/Dra.+Carla+Christoph/@-22.9837862,-43.2055289,17z/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Avaliações no Google: 5,0 estrelas com 17 avaliações"
            class="lp-hero-review"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#B3955F" stroke="#B3955F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <span class="lp-hero-review-score">5,0</span>
            <span class="lp-hero-review-count">no Google · 17 avaliações</span>
          </a>
        </div>
      </div>

      <!-- Imagem — 40% no desktop -->
      <div class="lp-hero-imagecol">
        <div class="lp-hero-imagewrap">
          <div class="lp-hero-imageframe">
            <picture>
              <source srcset={avifDesktop} type="image/avif" media="(min-width: 768px)" sizes="(min-width: 1024px) 40vw, 50vw" />
              <source srcset={avifMobile} type="image/avif" media="(max-width: 767px)" sizes="100vw" />
              <source srcset={backgroundImage} type="image/webp" sizes="(min-width: 1024px) 40vw, (min-width: 768px) 50vw, 100vw" />
              <img
                src={backgroundImage}
                alt="Dra. Carla Christoph - Consulta Odontológica Personalizada em Ipanema"
                loading="eager"
                fetchpriority="high"
                decoding="sync"
                width={imgWidth}
                height={imgHeight}
              />
            </picture>
          </div>
          <div class="lp-hero-floatbadge">
            <span class="lp-dot">●</span>
            <span>20+ Anos de Experiência</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* section: pt-[90px] py-16 lg:py-24 + gradiente 170deg */
  .lp-hero {
    position: relative;
    overflow: hidden;
    padding: 90px 0 4rem;
    background: linear-gradient(170deg, #faf7f2 0%, #f5f0e8 40%, #ede8dc 100%);
  }
  @media (min-width: 1024px) {
    .lp-hero { padding-top: 96px; padding-bottom: 6rem; }
  }
  .lp-hero-radial {
    position: absolute;
    top: 0;
    right: 0;
    width: 500px;
    height: 500px;
    pointer-events: none;
    background: radial-gradient(circle at 80% 20%, rgba(179, 149, 95, 0.05) 0%, transparent 70%);
  }
  .lp-hero-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1rem;
    position: relative;
    z-index: 10;
  }
  .lp-hero-flex {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .lp-hero-flex { flex-direction: row; }
  }
  .lp-hero-content {
    width: 100%;
    display: grid;
    gap: 1.75rem; /* space-y-7 */
  }
  @media (min-width: 1024px) {
    .lp-hero-content { width: 60%; }
  }
  .lp-hero-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.025em;
    text-transform: uppercase;
    color: #8b7340;
  }
  @media (min-width: 768px) {
    .lp-hero-eyebrow { font-size: 0.875rem; }
  }
  .lp-hero-badges { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .lp-hero-badge {
    display: inline-flex;
    align-items: center;
    background: rgba(179, 149, 95, 0.15);
    color: #8b7340;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.375rem 0.75rem;
    border-radius: 9999px;
  }
  .lp-hero-headlines { display: grid; gap: 1rem; }
  .lp-hero-h1 {
    font-size: 34px;
    font-weight: 700;
    color: #381f47;
    line-height: 1.25;
    font-family: 'Playfair Display', Georgia, serif;
  }
  @media (min-width: 768px) {
    .lp-hero-h1 { font-size: 2.25rem; }
  }
  @media (min-width: 1024px) {
    .lp-hero-h1 { font-size: 3rem; }
  }
  .lp-hero-sub {
    font-size: 1rem;
    color: #4b5563;
    line-height: 1.625;
  }
  @media (min-width: 768px) {
    .lp-hero-sub { font-size: 1.125rem; }
  }
  .lp-hero-benefits {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .lp-hero-benefits { grid-template-columns: 1fr 1fr; }
  }
  .lp-hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #fff;
    border: 1px solid rgba(179, 149, 95, 0.4);
    border-radius: 9999px;
    padding: 0.375rem 0.875rem;
    font-size: 0.875rem;
    color: #381f47;
    font-weight: 500;
  }
  .lp-dot { color: #b3955f; font-size: 8px; }
  .lp-hero-cta-wrap { display: grid; gap: 0.5rem; justify-items: start; }
  .lp-hero-cta {
    width: 100%;
    color: #fff;
    border-radius: 10px;
    padding: 1rem 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.3);
    background: linear-gradient(135deg, #25d366 0%, #20bd5a 100%);
  }
  .lp-hero-cta:hover {
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.4);
    transform: scale(1.05);
  }
  @media (min-width: 768px) {
    .lp-hero-cta { width: auto; justify-content: flex-start; }
  }
  .lp-hero-review {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.25rem;
    padding: 0.375rem 0.75rem;
    background: #fff;
    border: 1px solid rgba(179, 149, 95, 0.3);
    border-radius: 9999px;
    width: fit-content;
    text-decoration: none;
  }
  .lp-hero-review-score { font-size: 0.875rem; font-weight: 600; color: #381f47; }
  .lp-hero-review-count { font-size: 0.75rem; color: rgba(56, 31, 71, 0.7); }
  .lp-hero-imagecol { width: 100%; }
  @media (min-width: 1024px) {
    .lp-hero-imagecol { width: 40%; }
  }
  .lp-hero-imagewrap {
    position: relative;
    aspect-ratio: 760 / 996;
  }
  .lp-hero-imageframe {
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(74, 45, 94, 0.08);
    height: 100%;
  }
  .lp-hero-imageframe picture,
  .lp-hero-imageframe img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .lp-hero-floatbadge {
    display: none;
    position: absolute;
    bottom: 1.5rem;
    left: 1rem;
    background: #fff;
    border-radius: 12px;
    padding: 0.625rem 1rem;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    font-size: 11px;
    font-weight: 600;
    color: #381f47;
  }
  @media (min-width: 768px) {
    .lp-hero-floatbadge { display: flex; }
  }
</style>
