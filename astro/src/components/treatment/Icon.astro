const inner = paths[name];
if (!inner) {
  throw new Error(`Icon.astro: ícone "${name}" não mapeado — adicione o path lucide correspondente.`);
}
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={fill ? 'currentColor' : 'none'}
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
/>
