---
/**
 * TreatmentHero — porte fiel de src/components/treatment/TreatmentHero.tsx.
 * Grid 5 colunas (3 texto / 2 foto), gradiente purple-soft, breadcrumb,
 * badges dourados e CTA roxo (WhatsApp, tracking js-wa-cta global).
 * Emite o schema BreadcrumbList (igual ao Helmet do original).
 * Foto: eager + fetchpriority high (LCP) — mesma proporção 600x800 do React
 * (object-fit cover + aspect-ratio, como o OptimizedImage original).
 */
import Icon from './Icon.astro';
import '../../styles/treatment.css';

export interface BreadcrumbItemType {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  subtitle: string;
  description: string;
  doctorImage?: string;
  doctorAlt?: string;
  badges?: string[];
  breadcrumbs?: BreadcrumbItemType[];
  /** data-label do CTA: "<slug>_hero_whatsapp" */
  waLabel: string;
  /** Mensagem pré-preenchida; default = mesma do React */
  waMessage?: string;
}

const {
  title,
  subtitle,
  description,
  doctorImage,
  doctorAlt,
  badges,
  breadcrumbs,
  waLabel,
  waMessage,
} = Astro.props;

const message = waMessage ?? `Olá! Gostaria de agendar uma consulta sobre ${title}.`;
const waHref = `https://wa.me/5521993304045?text=${encodeURIComponent(message)}`;
const imgAlt = doctorAlt ?? `Dra. Carla Christoph - Especialista em ${title}`;

const breadcrumbSchema =
  breadcrumbs && breadcrumbs.length > 0
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.label,
          item: item.href ? `https://dracarlachristoph.com${item.href}` : undefined,
        })),
      })
    : null;
---

{breadcrumbSchema && <script type="application/ld+json" set:html={breadcrumbSchema} />}

<section class="bg-gradient-purple-soft th-hero" aria-label="Hero do tratamento">
  <div class="section-spacing content-container">
    <div class="th-grid">
      <div class="th-content">
        {breadcrumbs && breadcrumbs.length > 0 && (
          <nav class="th-breadcrumb" aria-label="breadcrumb">
            <ol>
              {breadcrumbs.map((item, index) => (
                <li>
                  {item.href ? (
                    <a href={item.href}>{item.label}</a>
                  ) : (
                    <span class="th-bc-current" aria-current="page">{item.label}</span>
                  )}
                  {index < breadcrumbs.length - 1 && (
                    <svg class="th-bc-sep" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )}

        <h1 class="th-title">{title}</h1>

        <p class="th-subtitle">{subtitle}</p>

        <p class="th-description">{description}</p>

        {badges && badges.length > 0 && (
          <div class="th-badges">
            {badges.map((badge) => (
              <span class="th-badge">{badge}</span>
            ))}
          </div>
        )}

        <div class="th-cta-wrap">
          <a
            class="th-cta js-wa-cta"
            data-label={waLabel}
            href={waHref}
            target="_blank"
            rel="noopener"
            aria-label="Agendar consulta pelo WhatsApp"
          >
            <Icon name="calendar" size={20} />
            Agendar Consulta
          </a>
        </div>
      </div>

      {doctorImage && (
        <div class="th-image-col">
          <div class="th-image-frame shadow-elegant">
            <img
              src={doctorImage}
              alt={imgAlt}
              width="600"
              height="800"
              loading="eager"
              fetchpriority="high"
              decoding="sync"
            />
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .th-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .th-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 3rem;
    }
    .th-content {
      grid-column: span 3 / span 3;
    }
    .th-image-col {
      grid-column: span 2 / span 2;
      order: 2;
    }
  }
  .th-content > * + * {
    margin-top: 1.5rem;
  }
  /* Foto primeiro no mobile (order-first lg:order-last) */
  .th-image-col {
    order: -1;
  }

  .th-breadcrumb {
    font-size: 0.875rem;
    opacity: 0.7;
  }
  .th-breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .th-breadcrumb li {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  .th-breadcrumb a {
    color: var(--dc-purple-soft);
    text-decoration: none;
    transition: color 0.2s;
  }
  .th-breadcrumb a:hover {
    color: var(--dc-purple);
  }
  .th-bc-current {
    color: var(--dc-purple);
    font-weight: 500;
  }
  .th-bc-sep {
    color: var(--dc-gray);
    opacity: 0.6;
  }

  .th-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    font-size: 2.25rem;
    line-height: 1.25;
    color: var(--dc-purple);
  }
  @media (min-width: 768px) {
    .th-title {
      font-size: 3rem;
    }
  }
  @media (min-width: 1024px) {
    .th-title {
      font-size: 3.75rem;
    }
  }

  .th-subtitle {
    font-size: 1.25rem;
    color: var(--dc-purple-soft);
    font-weight: 500;
  }
  @media (min-width: 768px) {
    .th-subtitle {
      font-size: 1.5rem;
    }
  }

  .th-description {
    font-size: 1.125rem;
    color: var(--dc-gray);
    line-height: 1.625;
    max-width: 42rem;
  }

  .th-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .th-badge {
    display: inline-flex;
    align-items: center;
    background: rgba(179, 149, 95, 0.1);
    color: var(--dc-gold-dark);
    border: 1px solid rgba(179, 149, 95, 0.2);
    border-radius: 9999px;
    padding: 0.375rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    transition: background 0.2s;
  }
  .th-badge:hover {
    background: rgba(179, 149, 95, 0.15);
  }

  .th-cta-wrap {
    padding-top: 1rem;
  }
  .th-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--dc-purple);
    color: #fff;
    padding: 1.05rem 1.5rem;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: all 0.3s;
  }
  .th-cta:hover {
    background: var(--dc-purple-dark);
    box-shadow: 0 12px 32px rgba(56, 31, 71, 0.16), 0 6px 16px rgba(56, 31, 71, 0.1);
  }

  .th-image-frame {
    border-radius: 1rem;
    overflow: hidden;
  }
  .th-image-frame img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 600 / 800;
    object-fit: cover;
    transition: transform 0.5s;
  }
  .th-image-frame:hover img {
    transform: scale(1.02);
  }
</style>
