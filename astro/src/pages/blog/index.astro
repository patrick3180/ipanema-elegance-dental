---
/**
 * Índice do blog — todos os posts como links no HTML cru (zero órfãos).
 */
import Base from '../../layouts/Base.astro';
import { getBlogData, postMeta } from '../../lib/contentful';

const { posts, assetMap } = await getBlogData();
const items = posts
  .map((p) => postMeta(p, assetMap))
  .filter((m) => m.slug.length >= 3 && m.title)
  .sort((a, b) => (b.date || '').localeCompare(a.date || ''));

const canonical = 'https://dracarlachristoph.com/blog';
const title = 'Blog Dra. Carla Christoph | Dicas de Saúde Bucal em Ipanema';
const description =
  'Blog de odontologia da Dra. Carla Christoph. Dicas de saúde bucal, artigos informativos e novidades sobre tratamentos dentários em Ipanema.';

const blogSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: title,
  description,
  url: canonical,
  inLanguage: 'pt-BR',
  publisher: { '@type': 'Organization', name: 'Dra. Carla Christoph' },
  blogPost: items.slice(0, 60).map((m) => ({
    '@type': 'BlogPosting',
    headline: m.title,
    url: `https://dracarlachristoph.com/blog/${m.slug}`,
  })),
});
---

<Base title={title} description={description} canonical={canonical} schemas={[blogSchema]}>
  <main class="container">
    <h1>Blog — Dicas de Saúde Bucal</h1>
    <p class="intro">
      Artigos sobre saúde bucal, tratamentos odontológicos e prevenção pela Dra. Carla Christoph,
      especialista em Prótese Dentária e Implantodontia em Ipanema, Rio de Janeiro.
    </p>
    <ul class="post-list">
      {items.map((m) => (
        <li>
          <a href={`/blog/${m.slug}`}>{m.title}</a>
          {m.excerpt && <p>{m.excerpt.substring(0, 150)}</p>}
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  h1 {
    font-size: clamp(1.7rem, 4.5vw, 2.3rem);
    margin-bottom: 10px;
  }
  .intro {
    color: #555;
    margin-bottom: 24px;
  }
  .post-list {
    list-style: none;
    padding: 0;
  }
  .post-list li {
    padding: 14px 0;
    border-bottom: 1px solid #eee;
  }
  .post-list a {
    font-weight: 600;
    color: var(--dental-purple);
    text-decoration: none;
    font-size: 1.05rem;
  }
  .post-list a:hover {
    text-decoration: underline;
  }
  .post-list p {
    color: var(--dental-gray);
    font-size: 0.9rem;
    margin-top: 4px;
  }
</style>
