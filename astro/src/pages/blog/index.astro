---
/**
 * Índice do blog — paridade visual com o BlogPage.tsx original:
 * fundo bege, título + divisor dourado, intro, chips de categoria,
 * grid de cards com thumbnail/categoria/data/título/resumo/autor/"Ler mais".
 * Todos os posts como links no HTML cru (zero órfãos).
 */
import Base from '../../layouts/Base.astro';
import { getBlogData, postMeta } from '../../lib/contentful';

const { posts, assetMap, entryMap } = await getBlogData();
const items = posts
  .map((p) => postMeta(p, assetMap, entryMap))
  .filter((m) => m.slug.length >= 3 && m.title)
  .sort((a, b) => (b.date || '').localeCompare(a.date || ''));

const categories = [...new Set(items.map((m) => m.category).filter(Boolean))].slice(0, 6);

const canonical = 'https://dracarlachristoph.com/blog';
const title = 'Blog Dra. Carla Christoph | Dicas de Saúde Bucal em Ipanema';
const description =
  'Blog de odontologia da Dra. Carla Christoph. Dicas de saúde bucal, artigos informativos e novidades sobre tratamentos dentários em Ipanema.';

const fmtDate = (d: string) => (d ? new Date(d).toLocaleDateString('pt-BR') : '');
const thumb = (m: any) =>
  m.imageUrl && m.imageUrl.includes('ctfassets.net') ? `${m.imageUrl}?w=600&h=400&fit=fill&fm=webp&q=75` : m.imageUrl;

const blogSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: title,
  description,
  url: canonical,
  inLanguage: 'pt-BR',
  publisher: { '@type': 'Organization', name: 'Dra. Carla Christoph' },
  blogPost: items.slice(0, 60).map((m) => ({
    '@type': 'BlogPosting',
    headline: m.title,
    url: `https://dracarlachristoph.com/blog/${m.slug}`,
  })),
});
---

<Base title={title} description={description} canonical={canonical} schemas={[blogSchema]}>
  <main class="blog-index">
    <nav aria-label="breadcrumb" class="breadcrumb"><a href="/">Início</a> / <span>Blog</span></nav>

    <header class="blog-hero">
      <h1>Blog Odontológico da Dra. Carla Christoph:<br />Informação e Cuidado para seu Sorriso</h1>
      <div class="gold-divider" aria-hidden="true"></div>
      <p>
        Bem-vindo ao nosso espaço de informação e dicas sobre saúde bucal! No blog da Dra. Carla
        Christoph, você encontrará artigos atualizados sobre tratamentos odontológicos, prevenção,
        novidades da odontologia estética e cuidados essenciais para manter seu sorriso sempre
        saudável e bonito em Ipanema.
      </p>
      {categories.length > 0 && (
        <div class="cat-chips">
          {categories.map((c) => <span class="chip">{c}</span>)}
        </div>
      )}
    </header>

    <section class="card-grid" aria-label="Artigos do blog">
      {items.map((m, idx) => (
        <article class="card">
          <a href={`/blog/${m.slug}`} class="card-img-link" aria-hidden="true" tabindex="-1">
            {thumb(m) ? (
              <span class="card-img">
                {/* Primeiras 6 eager (padrão Sprint 7: acima da dobra carrega já) */}
                <img src={thumb(m)} alt={m.title} width="600" height="400" loading={idx < 6 ? 'eager' : 'lazy'} decoding="async" />
                {m.category && <span class="badge">{m.category}</span>}
              </span>
            ) : (
              <span class="card-img placeholder">{m.category && <span class="badge">{m.category}</span>}</span>
            )}
          </a>
          <div class="card-body">
            {m.date && <time class="card-date" datetime={m.date}>{fmtDate(m.date)}</time>}
            <h2><a href={`/blog/${m.slug}`}>{m.title}</a></h2>
            {m.excerpt && <p class="card-excerpt">{m.excerpt.substring(0, 140)}{m.excerpt.length > 140 ? '…' : ''}</p>}
            <div class="card-footer">
              <span class="card-author">{m.author}</span>
              <a class="read-more" href={`/blog/${m.slug}`}>Ler mais</a>
            </div>
          </div>
        </article>
      ))}
    </section>
  </main>
</Base>

<style>
  .blog-index {
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px 16px 40px;
  }
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--dental-gray);
    margin-bottom: 20px;
  }
  .blog-hero {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 36px;
  }
  .blog-hero h1 {
    font-size: clamp(1.7rem, 4.2vw, 2.5rem);
    margin-bottom: 14px;
  }
  .gold-divider {
    width: 96px;
    height: 3px;
    background: var(--dental-gold);
    margin: 0 auto 18px;
    border-radius: 2px;
  }
  .blog-hero p {
    color: #4a4437;
    line-height: 1.7;
  }
  .cat-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-top: 22px;
  }
  .chip {
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid rgba(56, 31, 71, 0.25);
    color: var(--dental-purple);
    border-radius: 8px;
    padding: 9px 18px;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 28px;
  }
  .card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.07);
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.1);
  }
  .card-img-link {
    display: block;
  }
  .card-img {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: #ded5c4;
  }
  .card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: var(--dental-purple);
    color: #fff;
    font-size: 0.72rem;
    padding: 5px 12px;
    border-radius: 999px;
    font-weight: 500;
  }
  .card-body {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .card-date {
    color: var(--dental-gray);
    font-size: 0.8rem;
    margin-bottom: 6px;
  }
  .card-body h2 {
    font-size: 1.15rem;
    line-height: 1.35;
    margin-bottom: 8px;
  }
  .card-body h2 a {
    color: var(--dental-purple);
    text-decoration: none;
  }
  .card-body h2 a:hover {
    text-decoration: underline;
  }
  .card-excerpt {
    color: #5a5548;
    font-size: 0.9rem;
    line-height: 1.6;
    flex: 1;
  }
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid #f0ece3;
  }
  .card-author {
    font-size: 0.82rem;
    color: var(--dental-gray);
  }
  .read-more {
    color: var(--dental-gold);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .read-more:hover {
    text-decoration: underline;
  }
</style>
