---
/**
 * /contato — porte fiel de src/pages/ContactPage.tsx (React SPA).
 * Copy VERBATIM. SEM formulário de contato (decisão consolidada — CLAUDE.md §11).
 * WhatsApp CTA + informações de contato + mapa (Google Maps embed, lazy).
 * Meta title: igual no SEOHead do React e no infoPages['/contato'] do
 * generate-static-meta.cjs; description copiada do generate-static-meta.cjs
 * (fonte da verdade das meta tags).
 * Schema: Dentist (mesmo payload do generate-static-meta.cjs — dados reais,
 * AggregateRating 5.0/18 = exceção autorizada Maio/2026).
 */
import { GOOGLE_AGGREGATE_RATING } from '../lib/googleBusiness';
import SiteLayout from '../layouts/SiteLayout.astro';

const WA_HREF = `https://wa.me/5521993304045?text=${encodeURIComponent('Olá! Gostaria de agendar uma consulta.')}`;

const dentistSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: 'Dra. Carla Christoph',
  description:
    'Dentista especialista em Prótese Dental e Reabilitação Oral em Ipanema, Rio de Janeiro. Mais de 20 anos de experiência.',
  telephone: '+5521993304045',
  url: 'https://dracarlachristoph.com',
  image: 'https://dracarlachristoph.com/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp',
  priceRange: '$$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Rua Visconde de Pirajá, 550 - Sala 1107',
    addressLocality: 'Ipanema',
    addressRegion: 'RJ',
    postalCode: '22410-901',
    addressCountry: 'BR',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '19:00',
    },
  ],
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'CRO-RJ',
    recognizedBy: { '@type': 'Organization', name: 'CRO-RJ' },
    identifier: '27.509',
  },
  aggregateRating: GOOGLE_AGGREGATE_RATING,
  availableLanguage: ['pt-BR', 'en'],
});
---

<SiteLayout
  title="Contato | Dra. Carla Christoph - Dentista em Ipanema"
  description="Entre em contato com a Dra. Carla Christoph. Consultório em Ipanema, Rio de Janeiro. Agende sua consulta pelo WhatsApp."
  canonical="https://dracarlachristoph.com/contato"
  schemas={[dentistSchema]}
>
  <main id="main-content">
    <section class="section-spacing">
      <div class="container-custom">
        <!-- Header -->
        <div class="page-head">
          <h1 class="heading-lg">Contato</h1>
          <div class="sep" role="none"></div>
          <p class="lead">Entre em contato conosco para agendar sua consulta</p>
          <p class="small">Atendimento particular.</p>
        </div>

        <!-- WhatsApp CTA -->
        <div class="wa-box">
          <h2>Agende pelo WhatsApp</h2>
          <p>A forma mais rápida de agendar sua consulta. Resposta rápida pelo WhatsApp 24h.</p>
          <a
            class="btn-gold js-wa-cta"
            data-label="contato_cta_whatsapp"
            href={WA_HREF}
            target="_blank"
            rel="noopener"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
            Chamar no WhatsApp
          </a>
        </div>

        <!-- Info + Map grid -->
        <div class="info-grid">
          <div class="card">
            <h2>Informações de contato</h2>
            <div class="info-list">
              <div class="info-item">
                <svg class="ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
                <div>
                  <p class="label">Endereço</p>
                  <p class="value">
                    Rua Visconde de Pirajá, 550 - Sala 1107<br />
                    Ipanema, Rio de Janeiro - RJ<br />
                    CEP: 22410-901
                  </p>
                </div>
              </div>
              <div class="info-item">
                <svg class="ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <div>
                  <p class="label">Telefone</p>
                  <p class="value">
                    (21) 3738-7909<br />
                    (21) 99330-4045
                  </p>
                </div>
              </div>
              <div class="info-item">
                <svg class="ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                <div>
                  <p class="label">Email</p>
                  <p class="value">contato@dracarlachristoph.com</p>
                </div>
              </div>
              <div class="info-item">
                <svg class="ico" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <div>
                  <p class="label">Horário de atendimento</p>
                  <p class="value">Segunda a Sexta: 9h às 19h</p>
                </div>
              </div>
            </div>
          </div>

          <div class="card">
            <h2>Localização</h2>
            <div class="map-wrap">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4586.581678884269!2d-43.2116873!3d-22.9836633!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9bd5070f90d87f%3A0x446370e6f29c86c4!2sDra.%20Carla%20Christoph%20-%20Reabilita%C3%A7%C3%A3o%20oral%20e%20est%C3%A9tica!5e1!3m2!1spt-BR!2sbr!4v1747142945090!5m2!1spt-BR!2sbr"
                width="100%"
                height="100%"
                style="border: 0;"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Mapa de localização do consultório"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  /* ── Utilitários portados do index.css/Tailwind do SPA ── */
  .container-custom {
    width: 100%;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }
  @media (min-width: 640px) { .container-custom { max-width: 640px; } }
  @media (min-width: 768px) { .container-custom { max-width: 768px; } }
  @media (min-width: 1024px) {
    .container-custom { max-width: 1024px; padding-left: 2rem; padding-right: 2rem; }
  }
  @media (min-width: 1280px) { .container-custom { max-width: 1280px; } }
  @media (min-width: 1536px) { .container-custom { max-width: 1536px; } }

  .section-spacing { padding-top: 4rem; padding-bottom: 4rem; }
  @media (min-width: 768px) { .section-spacing { padding-top: 5rem; padding-bottom: 5rem; } }
  @media (min-width: 1024px) { .section-spacing { padding-top: 6rem; padding-bottom: 6rem; } }

  .heading-lg { font-size: 1.875rem; line-height: 2.25rem; font-weight: 600; }
  @media (min-width: 768px) { .heading-lg { font-size: 2.25rem; line-height: 2.5rem; } }

  .sep { width: 6rem; height: 0.25rem; background: var(--dental-gold); margin: 0 auto 1.5rem; } /* mb-6 */

  /* ── Header da página ── */
  .page-head { max-width: 48rem; margin: 0 auto 3rem; text-align: center; } /* max-w-3xl mb-12 */
  .page-head h1 { margin-bottom: 1rem; } /* mb-4 */
  .page-head .lead { color: #525252; margin-bottom: 1rem; } /* text-dental-gray mb-4 */
  .page-head .small { color: #525252; font-size: 0.875rem; }

  /* ── WhatsApp CTA box ── */
  .wa-box {
    background: hsl(51 22% 76% / 0.5); /* bg-dental-beige/50 */
    padding: 2rem;
    border-radius: 0.5rem;
    text-align: center;
    margin: 0 auto 3rem; /* mb-12 */
    max-width: 42rem; /* max-w-2xl */
  }
  .wa-box h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 400;
    margin-bottom: 1rem;
  }
  .wa-box p { color: #525252; margin-bottom: 1.5rem; } /* mb-6 */

  .btn-gold {
    display: inline-flex;
    align-items: center;
    background: var(--dental-gold);
    color: #fff;
    border-radius: 0.375rem;
    padding: 1.5rem 2rem; /* py-6 px-8 */
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .btn-gold:hover { background: rgb(179 149 95 / 0.9); }
  .btn-gold svg { margin-right: 0.5rem; flex-shrink: 0; }

  /* ── Grid info + mapa ── */
  .info-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; } /* gap-12 */
  @media (min-width: 768px) { .info-grid { grid-template-columns: repeat(2, 1fr); } }
  .card {
    background: #fff;
    border-radius: 0.5rem;
    padding: 2rem;
    box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05); /* shadow-sm */
  }
  .card h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 400;
    margin-bottom: 1.5rem; /* mb-6 */
  }
  .info-list { display: flex; flex-direction: column; gap: 1.5rem; } /* space-y-6 */
  .info-item { display: flex; align-items: flex-start; gap: 0.75rem; } /* gap-3 */
  .info-item .ico { color: var(--dental-gold); margin-top: 0.25rem; flex-shrink: 0; } /* mt-1 */
  .info-item .label { font-weight: 500; }
  .info-item .value { color: #525252; }

  .map-wrap {
    aspect-ratio: 16 / 9; /* aspect-video */
    background: hsl(51 22% 76% / 0.5);
    border-radius: 0.5rem;
    overflow: hidden;
  }
  .map-wrap iframe { display: block; width: 100%; height: 100%; }
</style>
