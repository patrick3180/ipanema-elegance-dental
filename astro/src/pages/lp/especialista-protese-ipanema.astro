---
/**
 * /lp/especialista-protese-ipanema — V2 da LP de Prótese (URL PRINCIPAL).
 * Porte fiel de src/pages/EspecialistaProteseLandingPageV2.tsx + componentes
 * src/components/landing/protese/*.tsx (hero full-bleed, seletor de prótese,
 * reassurance, reenquadre de valor, barra sticky mobile).
 * CSS .ph-* portado verbatim de src/index.css (seção "LP Prótese V2").
 *
 * Regras de copy (config): sem "15-20 anos" na prótese fixa; "encaixe preciso"
 * na removível — já aplicadas no especialistaProteseV2Config (copy verbatim).
 *
 * Ordem: Hero → Seletor → MidCTA → Solução → Valor → DoctorBio → Guide →
 * SocialProof → FAQ → FinalCTA → StickyCTA (mobile).
 * Nota: o FloatingWhatsApp do React ficava invisível em todos os breakpoints
 * (wrapper `hidden md:block` + botão `md:hidden`) — não portado.
 */
import LPLayout from '../../layouts/LPLayout.astro';
import LPMidCTA from '../../components/lp/LPMidCTA.astro';
import LPDoctorBio from '../../components/lp/LPDoctorBio.astro';
import LPGuide from '../../components/lp/LPGuide.astro';
import LPSocialProof from '../../components/lp/LPSocialProof.astro';
import LPFAQ from '../../components/lp/LPFAQ.astro';
import LPFinalCTA from '../../components/lp/LPFinalCTA.astro';
import LPStickyCTA from '../../components/lp/LPStickyCTA.astro';
import { especialistaProteseV2Config as cfg } from '@/config/especialistaProteseV2Config';

const waHref = `https://wa.me/${cfg.whatsapp.number}?text=${encodeURIComponent(cfg.whatsapp.message)}`;
const prefix = 'lp-protese';

// Mensagem por opção do seletor — mesma lógica do ProteseSeletor.tsx
const seletorHref = (label: string) =>
  `https://wa.me/${cfg.whatsapp.number}?text=${encodeURIComponent(
    `Olá! Vi a página de prótese e tenho interesse em ${label.toLowerCase()}. Gostaria de agendar uma consulta para entender o que é possível no meu caso.`
  )}`;

// Schemas — copiados verbatim do Helmet de EspecialistaProteseLandingPageV2.tsx
const schemas = [
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Dentist',
    name: 'Dra. Carla Christoph',
    image: 'https://dracarlachristoph.com/lovable-uploads/hero-fb-1280.webp',
    description:
      'Reabilitação oral para casos complexos em Ipanema. Especialista em prótese dentária com planejamento detalhado.',
    url: 'https://dracarlachristoph.com/lp/especialista-protese-ipanema',
    telephone: '+5521993304045',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Rua Visconde de Pirajá, 550 - Sala 1107',
      addressLocality: 'Ipanema',
      addressRegion: 'RJ',
      postalCode: '22410-901',
      addressCountry: 'BR',
    },
    geo: { '@type': 'GeoCoordinates', latitude: -22.9868, longitude: -43.2005 },
    areaServed: { '@type': 'City', name: 'Rio de Janeiro' },
    priceRange: '$$$',
    openingHours: 'Mo-Fr 09:00-19:00',
  }),
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'MedicalProcedure',
    name: 'Reabilitação Oral e Prótese Dentária',
    description:
      'Prótese fixa, sobre implante e removível com planejamento digital e materiais de alta translucidez.',
    procedureType: 'Reconstructive',
    performer: { '@type': 'Dentist', name: 'Dra. Carla Christoph' },
  }),
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: cfg.faq.questions.map((q) => ({
      '@type': 'Question',
      name: q.question,
      acceptedAnswer: { '@type': 'Answer', text: q.answer },
    })),
  }),
];
---

<LPLayout
  title={cfg.seo.title}
  description={cfg.seo.description}
  canonical="https://dracarlachristoph.com/lp/especialista-protese-ipanema"
  ogImage="https://dracarlachristoph.com/lovable-uploads/hero-fb-1280.webp"
  schemas={schemas}
  whatsappHref={waHref}
  waLabelPrefix={prefix}
>
  <main id="main-content" class="ph-root">
    <!-- ═══ HERO full-bleed (ProteseHero.tsx + CSS .ph-* de index.css) ═══ -->
    <section class="ph-hero" id="inicio">
      <picture class="ph-hero-photo">
        <source
          media="(max-width: 767px)"
          type="image/avif"
          srcset="/lovable-uploads/hero-fb-m-480.avif 480w, /lovable-uploads/hero-fb-m-768.avif 768w"
          sizes="100vw"
        />
        <source
          media="(max-width: 767px)"
          type="image/webp"
          srcset="/lovable-uploads/hero-fb-m-480.webp 480w, /lovable-uploads/hero-fb-m-768.webp 768w"
          sizes="100vw"
        />
        <source
          media="(min-width: 768px)"
          type="image/avif"
          srcset="/lovable-uploads/hero-fb-1280.avif 1280w, /lovable-uploads/hero-fb-1920.avif 1920w"
          sizes="100vw"
        />
        <source
          media="(min-width: 768px)"
          type="image/webp"
          srcset="/lovable-uploads/hero-fb-1280.webp 1280w, /lovable-uploads/hero-fb-1920.webp 1920w"
          sizes="100vw"
        />
        <img
          src="/lovable-uploads/hero-fb-1280.webp"
          alt="Dra. Carla Christoph, especialista em prótese dentária, no consultório em Ipanema"
          width="1280"
          height="650"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>

      <div class="ph-hero-scrim" aria-hidden="true"></div>

      <div class="ph-hero-text">
        <div class="ph-hero-inner">
          <div class="ph-hero-copy">
            <p class="ph-hero-eyebrow">
              Especialista em Prótese e Implantodontia · CRO-RJ 27.509
            </p>

            <h1 class="ph-hero-h1">{cfg.hero.headline}</h1>

            <p class="ph-hero-sub">{cfg.hero.subheadline}</p>

            <div class="ph-hero-cta-row">
              <a
                class="ph-hero-cta js-wa-cta"
                data-label={`${prefix}_hero_whatsapp`}
                href={waHref}
                target="_blank"
                rel="noopener"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                <span class="ph-hero-cta-labels">
                  <b>{cfg.hero.ctaText}</b>
                  <small>WhatsApp 24h</small>
                </span>
              </a>

              <a
                href={cfg.proof.ratingHref}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Avaliações no Google: ${cfg.proof.rating} estrelas com ${cfg.proof.ratingCount}`}
                class="ph-hero-proof"
              >
                <svg class="ph-hero-star" width="16" height="16" viewBox="0 0 24 24" fill="#B3955F" stroke="#B3955F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <b>{cfg.proof.rating}</b>
                <span>no Google · {cfg.proof.ratingCount}</span>
              </a>
            </div>

            <div class="ph-hero-badges">
              {cfg.benefits.map((b) => (
                <span class="ph-hero-badge">
                  <span class="ph-hero-dot" aria-hidden="true">●</span>
                  {b}
                </span>
              ))}
            </div>

            <div class="ph-hero-trust">
              {cfg.proof.badges.map((badge) => <span>{badge}</span>)}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 1. Seletor de prótese (ProteseSeletor.tsx — inovação principal) ═══ -->
    <section class="ph-seletor" aria-label="Qual prótese para o seu caso">
      <div class="ph-container">
        <div class="ph-seletor-inner">
          <div class="ph-seletor-header">
            <h2>{cfg.seletor.title}</h2>
            <p>{cfg.seletor.subtitle}</p>
          </div>

          <div class="ph-seletor-grid">
            {cfg.seletor.options.map((option) => (
              <div class="ph-seletor-card">
                <div class="ph-seletor-body">
                  <span class="ph-seletor-fio" aria-hidden="true"></span>
                  <h3>{option.label}</h3>
                  <p class="ph-seletor-tag">{option.tag}</p>
                  <p class="ph-seletor-desc">{option.description}</p>
                  <p class="ph-seletor-highlight">
                    <span class="ph-seletor-hdot" aria-hidden="true">●</span>
                    {option.highlight}
                  </p>
                </div>
                <a
                  class="ph-seletor-cta js-wa-cta"
                  data-label={`${prefix}_seletor_${option.id}_whatsapp`}
                  href={seletorHref(option.label)}
                  target="_blank"
                  rel="noopener"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                  {option.ctaLabel}
                </a>
              </div>
            ))}
          </div>

          <p class="ph-seletor-footnote">{cfg.seletor.footnote}</p>
        </div>
      </div>
    </section>

    <!-- ═══ 2. Mid-CTA ═══ -->
    <LPMidCTA
      whatsappHref={waHref}
      waLabel={`${prefix}_midcta_whatsapp`}
      heading="Quer entender qual prótese resolve o seu caso?"
      ctaLabel="Agendar pelo WhatsApp"
    />

    <!-- ═══ 3. Reassurance — "o seu caso tem solução" (ProteseSolucao.tsx) ═══ -->
    <section class="ph-solucao" aria-label="O seu caso tem solução">
      <div class="ph-container">
        <div class="ph-solucao-inner">
          <div class="ph-solucao-header">
            <h2>{cfg.problem.title}</h2>
            {cfg.problem.description && <p>{cfg.problem.description}</p>}
          </div>

          <div class="ph-solucao-grid">
            {cfg.problem.problems.map((problem) => (
              <div class="ph-solucao-card">
                <span class="ph-solucao-losango" aria-hidden="true"></span>
                <p>{problem}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 4. Reenquadre de valor (ProteseValor.tsx) ═══ -->
    <section class="ph-valor" aria-label="Por que a prótese de especialista é diferente">
      <div class="ph-container">
        <div class="ph-valor-inner">
          <div class="ph-valor-header">
            <h2>{cfg.valueProps.title}</h2>
            <p>{cfg.valueProps.subtitle}</p>
          </div>

          <div class="ph-valor-grid">
            {cfg.valueProps.items.map((item, index) => (
              <div class="ph-valor-card">
                <span class="ph-valor-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 5. Autoridade — bio da Dra. Carla ═══ -->
    <LPDoctorBio />

    <!-- ═══ 6. Processo ═══ -->
    <LPGuide title={cfg.guide.title} subtitle={cfg.guide.subtitle} steps={cfg.guide.steps} />

    <!-- ═══ 7. Prova social ═══ -->
    <LPSocialProof
      title={cfg.socialProof.title}
      testimonials={cfg.socialProof.testimonials}
      stats={cfg.socialProof.stats}
    />

    <!-- ═══ 8. FAQ ═══ -->
    <LPFAQ title={cfg.faq.title} questions={cfg.faq.questions} />

    <!-- ═══ 9. CTA final ═══ -->
    <LPFinalCTA
      title={cfg.cta.title}
      subtitle={cfg.cta.subtitle}
      buttonText={cfg.cta.buttonText}
      urgency={cfg.cta.urgency}
      whatsappHref={waHref}
      waLabel={`${prefix}_final_whatsapp`}
    />

    <!-- ═══ Barra sticky de WhatsApp — componente compartilhado (Fase 0), com auto-ocultar sobre o CTA do hero ═══ -->
    <LPStickyCTA whatsappHref={waHref} waLabel={`${prefix}_sticky_whatsapp`} />
  </main>
</LPLayout>

<style>
  /* ═══ CSS .ph-* portado verbatim de src/index.css (LP Prótese V2) ═══ */
  .ph-root { background: #fff; }
  .ph-hero { position: relative; padding-top: 68px; background: #E4DBCA; }
  .ph-hero-photo { display: block; }
  .ph-hero-photo img { display: block; width: 100%; height: 44vh; min-height: 280px; max-height: 420px; object-fit: cover; object-position: 50% 16%; }
  .ph-hero-scrim { display: none; }
  .ph-hero-text { background: #E4DBCA; padding: 1.5rem 1.25rem 2rem; }
  .ph-hero-inner { width: 100%; }
  .ph-hero-copy { max-width: 600px; margin: 0 auto; }
  .ph-hero-eyebrow { font-size: .72rem; text-transform: uppercase; letter-spacing: .14em; color: #8A7444; font-weight: 600; margin: 0 0 .75rem; }
  .ph-hero-h1 { font-size: clamp(1.6rem, 5.4vw, 2.4rem); font-weight: 700; line-height: 1.14; color: #381F47; margin: 0 0 .9rem; font-family: 'Playfair Display', Georgia, serif; }
  .ph-hero-sub { font-size: .98rem; color: #5C5647; line-height: 1.55; margin: 0 0 1.1rem; }
  .ph-hero-badges { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.25rem 0 0; }
  .ph-hero-badge { display: inline-flex; align-items: center; gap: .4rem; background: #fff; border: 1px solid rgba(179,149,95,.4); border-radius: 999px; padding: .35rem .7rem; font-size: .8rem; color: #381F47; font-weight: 500; }
  .ph-hero-dot { color: #B3955F; font-size: 8px; }
  .ph-hero-cta-row { display: flex; flex-direction: column; gap: .75rem; align-items: flex-start; }
  .ph-hero-cta { display: inline-flex; align-items: center; gap: .6rem; width: 100%; justify-content: center; background: linear-gradient(135deg, #25D366 0%, #20BD5A 100%); color: #fff; border: none; cursor: pointer; border-radius: 10px; padding: .85rem 1.5rem; font-family: inherit; box-shadow: 0 4px 14px rgba(37,211,102,.3); transition: transform .2s ease; text-decoration: none; }
  .ph-hero-cta:hover { transform: scale(1.03); }
  .ph-hero-cta-labels { display: flex; flex-direction: column; line-height: 1.1; text-align: left; }
  .ph-hero-cta-labels b, .ph-hero-cta b { font-size: .95rem; font-weight: 700; }
  .ph-hero-cta-labels small, .ph-hero-cta small { font-size: .7rem; opacity: .9; font-weight: 400; }
  .ph-hero-proof { display: inline-flex; align-items: center; gap: .4rem; background: #fff; border: 1px solid rgba(179,149,95,.3); border-radius: 999px; padding: .4rem .8rem; text-decoration: none; }
  .ph-hero-proof b { color: #381F47; font-size: .9rem; }
  .ph-hero-proof span { color: rgba(56,31,71,.7); font-size: .75rem; }
  .ph-hero-star { color: #B3955F; }
  .ph-hero-trust { display: flex; flex-wrap: wrap; gap: .4rem 1rem; margin-top: 1rem; }
  .ph-hero-trust span { font-size: .68rem; text-transform: uppercase; letter-spacing: .1em; color: #8A7444; font-weight: 600; }
  /* Sticky bar: agora no componente compartilhado LPStickyCTA (Fase 0) */
  @media (min-width: 768px) {
    .ph-hero { min-height: 86vh; padding-top: 0; }
    .ph-hero-photo { position: absolute; top: 72px; left: 0; right: 0; bottom: 0; }
    .ph-hero-photo img { height: 100%; min-height: 0; max-height: none; object-position: 78% 18%; }
    .ph-hero-scrim { display: block; position: absolute; top: 72px; left: 0; right: 0; bottom: 0; pointer-events: none; background: linear-gradient(90deg, rgba(250,247,242,.97) 0%, rgba(250,247,242,.88) 34%, rgba(250,247,242,.5) 54%, rgba(250,247,242,0) 72%); }
    .ph-hero-text { position: relative; background: transparent; padding: 0; min-height: 86vh; display: flex; align-items: center; }
    .ph-hero-inner { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
    .ph-hero-copy { max-width: 540px; margin: 0; }
    .ph-hero-h1 { font-size: 2.7rem; }
    .ph-hero-sub { font-size: 1.05rem; }
    .ph-hero-cta-row { flex-direction: row; align-items: center; gap: 1.25rem; }
    .ph-hero-cta { width: auto; }
  }

  /* ═══ Container comum das seções próprias ═══ */
  .ph-container { max-width: 1280px; margin: 0 auto; padding: 0 1rem; }

  /* ═══ Seletor (ProteseSeletor.tsx — editorial, fio dourado) ═══ */
  .ph-seletor { background: #fff; padding: 4rem 0; }
  @media (min-width: 1024px) {
    .ph-seletor { padding: 6rem 0; }
  }
  .ph-seletor-inner { max-width: 1152px; margin: 0 auto; }
  .ph-seletor-header { text-align: center; display: grid; gap: 1rem; margin-bottom: 3rem; }
  .ph-seletor-header h2 {
    font-size: 1.875rem;
    font-weight: 700;
    color: #381f47;
    font-family: 'Playfair Display', Georgia, serif;
  }
  @media (min-width: 768px) {
    .ph-seletor-header h2 { font-size: 2.25rem; }
  }
  .ph-seletor-header p {
    font-size: 1rem;
    color: #5c5647;
    line-height: 1.625;
    max-width: 672px;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .ph-seletor-header p { font-size: 1.125rem; }
  }
  .ph-seletor-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 768px) {
    .ph-seletor-grid { grid-template-columns: 1fr 1fr 1fr; }
  }
  .ph-seletor-card {
    display: flex;
    flex-direction: column;
    background: #faf7f2;
    border-radius: 1rem;
    border: 1px solid rgba(179, 149, 95, 0.2);
    box-shadow: 0 4px 16px rgba(56, 31, 71, 0.06);
    overflow: hidden;
  }
  .ph-seletor-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .ph-seletor-fio {
    display: block;
    width: 2.5rem;
    height: 1px;
    background: #b3955f;
    margin-bottom: 1.25rem;
  }
  .ph-seletor-body h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #381f47;
    font-family: 'Playfair Display', Georgia, serif;
    margin-bottom: 0.25rem;
  }
  .ph-seletor-tag {
    font-size: 0.875rem;
    font-weight: 600;
    color: #8b7340;
    margin-bottom: 1rem;
  }
  .ph-seletor-desc {
    font-size: 15px;
    color: #333;
    line-height: 1.625;
    margin-bottom: 1rem;
  }
  .ph-seletor-highlight {
    margin-top: auto;
    display: inline-flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #381f47;
    font-weight: 500;
    background: #fff;
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid rgba(179, 149, 95, 0.2);
  }
  .ph-seletor-hdot { color: #b3955f; font-size: 8px; margin-top: 0.375rem; }
  .ph-seletor-cta {
    margin: 0 1.75rem 1.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: #fff;
    border-radius: 10px;
    padding: 0.875rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.3);
    background: linear-gradient(135deg, #25d366 0%, #20bd5a 100%);
  }
  .ph-seletor-cta:hover {
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.4);
    transform: scale(1.03);
  }
  .ph-seletor-footnote {
    text-align: center;
    color: #6b6b6b;
    font-style: italic;
    max-width: 672px;
    margin: 2.5rem auto 0;
  }

  /* ═══ Solução (ProteseSolucao.tsx — losango dourado) ═══ */
  .ph-solucao { background: #fff; padding: 4rem 0; }
  @media (min-width: 1024px) {
    .ph-solucao { padding: 6rem 0; }
  }
  .ph-solucao-inner { max-width: 1024px; margin: 0 auto; display: grid; gap: 3rem; }
  .ph-solucao-header { text-align: center; display: grid; gap: 1rem; }
  .ph-solucao-header h2 {
    font-size: 1.875rem;
    font-weight: 700;
    color: #381f47;
    font-family: 'Playfair Display', Georgia, serif;
  }
  @media (min-width: 768px) {
    .ph-solucao-header h2 { font-size: 2.25rem; }
  }
  .ph-solucao-header p {
    font-size: 1rem;
    color: #5c5647;
    line-height: 1.625;
    max-width: 672px;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .ph-solucao-header p { font-size: 1.125rem; }
  }
  .ph-solucao-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 768px) {
    .ph-solucao-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .ph-solucao-grid { grid-template-columns: 1fr 1fr 1fr; }
  }
  .ph-solucao-card {
    background: #faf7f2;
    border-left: 2px solid rgba(179, 149, 95, 0.6);
    border-radius: 0.5rem;
    padding: 1.25rem;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .ph-solucao-losango {
    flex-shrink: 0;
    margin-top: 0.375rem;
    width: 0.5rem;
    height: 0.5rem;
    transform: rotate(45deg);
    background: #b3955f;
  }
  .ph-solucao-card p { color: #333; line-height: 1.625; font-size: 15px; }

  /* ═══ Valor (ProteseValor.tsx — numerais serifados dourados) ═══ */
  .ph-valor { background: #faf7f2; padding: 4rem 0; }
  @media (min-width: 1024px) {
    .ph-valor { padding: 6rem 0; }
  }
  .ph-valor-inner { max-width: 1024px; margin: 0 auto; }
  .ph-valor-header { text-align: center; display: grid; gap: 1rem; margin-bottom: 3rem; }
