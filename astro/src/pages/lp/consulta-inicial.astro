---
/**
 * /lp/consulta-inicial — porte de src/pages/ConsultaInicialLandingPage.tsx
 * Config: consultaInicialConfig (importado do app React via alias '@').
 * Seções: Hero → Problem → DoctorBio → Guide → MidCTA → SocialProof → FAQ → FinalCTA.
 * noindex (default do LPLayout). Todos os CTAs: js-wa-cta + data-label único.
 */
import LPLayout from '../../layouts/LPLayout.astro';
import LPHeroFullBleed from '../../components/lp/LPHeroFullBleed.astro';
import LPProblem from '../../components/lp/LPProblem.astro';
import LPDoctorBio from '../../components/lp/LPDoctorBio.astro';
import LPGuide from '../../components/lp/LPGuide.astro';
import LPMidCTA from '../../components/lp/LPMidCTA.astro';
import LPSocialProof from '../../components/lp/LPSocialProof.astro';
import LPFAQ from '../../components/lp/LPFAQ.astro';
import LPFinalCTA from '../../components/lp/LPFinalCTA.astro';
import LPFloatingWhatsApp from '../../components/lp/LPFloatingWhatsApp.astro';
import { consultaInicialConfig as config } from '@/config/consultaInicialConfig';

const waHref = `https://wa.me/${config.whatsapp.number}?text=${encodeURIComponent(config.whatsapp.message)}`;
const prefix = 'lp-consulta-inicial';

// Schema — copiado verbatim do Helmet de ConsultaInicialLandingPage.tsx
const schemas = [
  JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Dentist',
        '@id': 'https://dracarlachristoph.com/#dentist',
        name: 'Dra. Carla Christoph',
        description: config.seo.description,
        url: 'https://dracarlachristoph.com/lp/consulta-inicial',
        telephone: '+5521993304045',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Rua Visconde de Pirajá, 550 - Sala 1107',
          addressLocality: 'Ipanema',
          addressRegion: 'RJ',
          postalCode: '22410-901',
          addressCountry: 'BR',
        },
        speciality: ['Prótese Dental', 'Implantodontia', 'Consulta Odontológica'],
        image: 'https://dracarlachristoph.com/lovable-uploads/RIT08058-vertical-doutora-site.webp',
      },
      {
        '@type': 'Service',
        name: 'Consulta Odontológica Personalizada',
        description:
          'Consulta com mínimo de 1 hora dedicada ao caso do paciente. Inclui anamnese, exame clínico completo, radiografias quando necessário e profilaxia.',
        provider: { '@type': 'Dentist', '@id': 'https://dracarlachristoph.com/#dentist' },
        areaServed: { '@type': 'City', name: 'Rio de Janeiro' },
      },
      {
        '@type': 'FAQPage',
        mainEntity: config.faq.questions.map((q) => ({
          '@type': 'Question',
          name: q.question,
          acceptedAnswer: { '@type': 'Answer', text: q.answer },
        })),
      },
    ],
  }),
];
---

<LPLayout
  title={config.seo.title}
  description={config.seo.description}
  canonical="https://dracarlachristoph.com/lp/consulta-inicial"
  ogImage="https://dracarlachristoph.com/lovable-uploads/RIT08058-vertical-doutora-site.webp"
  schemas={schemas}
  whatsappHref={waHref}
  waLabelPrefix={prefix}
>
  <main id="main-content" class="lp-main">
    <LPHeroFullBleed
      eyebrow="Dentista Especialista em Ipanema · CRO-RJ 27.509"
      headline={config.hero.headline}
      subheadline={config.hero.subheadline}
      ctaText={config.hero.ctaText}
      benefits={config.benefits}
      trustBadges={["20+ anos em Ipanema", "CRO-RJ 27.509", "4.000+ pacientes"]}
      whatsappHref={waHref}
      waLabel={`${prefix}_hero_whatsapp`}
      photo={{
        mobileBase: 'hero-fb-m',
        desktopBase: 'hero-fb',
        alt: 'Dra. Carla Christoph, dentista especialista em Ipanema, no consultório',
        width: 1280,
        height: 650,
      }}
    />

    <LPProblem
      title={config.problem.title}
      description={config.problem.description}
      problems={config.problem.problems}
    />

    <LPDoctorBio />

    <LPGuide title={config.guide.title} subtitle={config.guide.subtitle} steps={config.guide.steps} />

    <LPMidCTA whatsappHref={waHref} waLabel={`${prefix}_midcta_whatsapp`} />

    <LPSocialProof
      title={config.socialProof.title}
      testimonials={config.socialProof.testimonials}
      stats={config.socialProof.stats}
    />

    <LPFAQ title={config.faq.title} questions={config.faq.questions} />

    <LPFinalCTA
      title={config.cta.title}
      subtitle={config.cta.subtitle}
      buttonText={config.cta.buttonText}
      urgency={config.cta.urgency}
      whatsappHref={waHref}
      waLabel={`${prefix}_final_whatsapp`}
    />

    <LPFloatingWhatsApp whatsappHref={waHref} waLabel={`${prefix}_floating_whatsapp`} />
  </main>
</LPLayout>

<style>
  .lp-main { background: #fff; min-height: 100vh; }
</style>
