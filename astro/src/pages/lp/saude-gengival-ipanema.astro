---
/**
 * LP Saúde Gengival — porte fiel de src/pages/SaudeGengivalLandingPage.tsx
 * Seções: LPHero (padrão) + variantes próprias desta LP (ProblemSection,
 * GuideSection, SocialProofSection, FAQSection, CTASection — de
 * src/components/landing/*.tsx, usadas apenas por esta LP) + floating WhatsApp.
 * Copy 100% verbatim do saudeGengivalConfig. noindex via LPLayout (default).
 */
import LPLayout from '../../layouts/LPLayout.astro';
import LPHero from '../../components/lp/LPHero.astro';
import LPStickyCTA from '../../components/lp/LPStickyCTA.astro';
import { saudeGengivalConfig as cfg } from '@/config/saudeGengivalConfig';

const waHref = `https://wa.me/${cfg.whatsapp.number}?text=${encodeURIComponent(cfg.whatsapp.message)}`;

// Schemas portados do Helmet de SaudeGengivalLandingPage.tsx (@graph LocalBusiness
// + MedicalProcedure) + FAQPage (injetado pelo FAQSection.tsx no React).
const schemas = [
  JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'LocalBusiness',
        '@id': 'https://dracarlachristoph.com/#business',
        name: 'Consultório Odontológico - Dra. Carla Christoph',
        description:
          'Especialista em saúde gengival em Ipanema. Tratamento para sangramento, sensibilidade e prevenção.',
        url: 'https://dracarlachristoph.com/lp/saude-gengival-ipanema',
        telephone: '+5521993304045',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Rua Visconde de Pirajá, 550 - Sala 1107',
          addressLocality: 'Ipanema',
          addressRegion: 'RJ',
          postalCode: '22410-901',
          addressCountry: 'BR',
        },
        geo: { '@type': 'GeoCoordinates', latitude: '-22.9868', longitude: '-43.2050' },
        openingHours: 'Mo-Fr 09:00-19:00',
        priceRange: '$$$',
        image: 'https://dracarlachristoph.com/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp',
      },
      {
        '@type': 'MedicalProcedure',
        name: 'Tratamento de Saúde Gengival',
        description: 'Profilaxia profissional e cuidados para saúde da gengiva',
        procedureType: 'Preventive Care',
      },
    ],
  }),
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: cfg.faq.questions.map((q) => ({
      '@type': 'Question',
      name: q.question,
      acceptedAnswer: { '@type': 'Answer', text: q.answer },
    })),
  }),
];
---

<LPLayout
  title={cfg.seo.title}
  description={cfg.seo.description}
  canonical="https://dracarlachristoph.com/lp/saude-gengival-ipanema"
  ogImage="https://dracarlachristoph.com/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp"
  schemas={schemas}
  whatsappHref={waHref}
  waLabelPrefix="lp-saude-gengival"
>
  <main id="main-content" class="sg-main">
    <LPHero
      headline={cfg.hero.headline}
      subheadline={cfg.hero.subheadline}
      ctaText={cfg.hero.ctaText}
      benefits={cfg.benefits}
      backgroundImage={cfg.hero.backgroundImage}
      whatsappHref={waHref}
      waLabel="lp-saude-gengival_hero_whatsapp"
      imgWidth={800}
      imgHeight={1200}
    />

    <!-- Problem — porte de src/components/landing/ProblemSection.tsx (cards vermelhos) -->
    <section class="sg-problem">
      <div class="sg-container">
        <div class="sg-problem-inner">
          <div class="sg-problem-badge" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <h2>{cfg.problem.title}</h2>
          <p class="sg-problem-desc">{cfg.problem.description}</p>
          <div class:list={['sg-problem-grid', cfg.problem.problems.length === 4 ? 'cols-two' : 'cols-three']}>
            {cfg.problem.problems.map((problem) => (
              <div class="sg-problem-card">
                <div class="sg-problem-x" aria-hidden="true"><span>✗</span></div>
                <p>{problem}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Guide — porte de src/components/landing/GuideSection.tsx (passos numerados) -->
    <section class="sg-guide">
      <div class="sg-container">
        <div class="sg-guide-inner">
          <div class="sg-guide-header">
            <h2>{cfg.guide.title}</h2>
            <p>{cfg.guide.subtitle}</p>
          </div>
          <div class="sg-guide-steps">
            {cfg.guide.steps.map((step) => (
              <div class="sg-guide-step">
                <div class="sg-guide-number"><span>{step.number}</span></div>
                <div class="sg-guide-content">
                  <h3>{step.title}</h3>
                  <p>{step.description}</p>
                </div>
                <div class="sg-guide-check" aria-hidden="true">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.27"/></svg>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Social Proof — porte de src/components/landing/SocialProofSection.tsx -->
    <section class="sg-social">
      <div class="sg-container">
        <div class="sg-social-inner">
          <div class="sg-social-header">
            <h2>{cfg.socialProof.title}</h2>
          </div>
          {cfg.socialProof.stats && (
            <div class="sg-social-stats">
              {cfg.socialProof.stats.map((stat, index) => (
                <div class="sg-social-stat">
                  <div class="sg-social-stat-icon">
                    {index % 4 === 0 && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#B3955F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>}
                    {index % 4 === 1 && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#B3955F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>}
                    {index % 4 === 2 && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#B3955F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>}
                    {index % 4 === 3 && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#B3955F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>}
                  </div>
                  <div class="sg-social-stat-number">{stat.number}</div>
                  <div class="sg-social-stat-label">{stat.label}</div>
                </div>
              ))}
            </div>
          )}
          <div class="sg-social-testimonials">
            {cfg.socialProof.testimonials.map((testimonial) => (
              <div class="sg-social-card">
                <p class="sg-social-quote">"{testimonial.text}"</p>
                <div class="sg-social-author">
                  <div class="sg-social-avatar"><span>{testimonial.name.charAt(0)}</span></div>
                  <div class="sg-social-name">{testimonial.name}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ — porte de src/components/landing/FAQSection.tsx (accordion bege) -->
    <section class="sg-faq">
      <div class="sg-container">
        <div class="sg-faq-inner">
          <div class="sg-faq-header">
            <h2>{cfg.faq.title}</h2>
          </div>
          <div class="sg-faq-list">
            {cfg.faq.questions.map((faq) => (
              <details class="sg-faq-item">
                <summary>
                  <span>{faq.question}</span>
                  <svg class="sg-faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </summary>
                <div class="sg-faq-answer">{faq.answer}</div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA final — porte de src/components/landing/CTASection.tsx (gradiente roxo, 2 botões) -->
    <section class="sg-cta">
      <div class="sg-container">
        <div class="sg-cta-inner">
          <h2>{cfg.cta.title}</h2>
          <p class="sg-cta-sub">{cfg.cta.subtitle}</p>
          <div class="sg-cta-buttons">
            <a
              class="sg-cta-primary js-wa-cta"
              data-label="lp-saude-gengival_final_whatsapp"
              href={waHref}
              target="_blank"
              rel="noopener"
              aria-label={cfg.cta.buttonText}
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
              {cfg.cta.buttonText}
            </a>
            <a
              class="sg-cta-secondary js-wa-cta"
              data-label="lp-saude-gengival_final_agendar_whatsapp"
              href={waHref}
              target="_blank"
              rel="noopener"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              Agendar Consulta
            </a>
          </div>
          <div class="sg-cta-trust">
            <div><span class="sg-cta-dot" aria-hidden="true"></span><span>WhatsApp 24h</span></div>
            <div><span class="sg-cta-dot" aria-hidden="true"></span><span>Mín. 1h por consulta</span></div>
            <div><span class="sg-cta-dot" aria-hidden="true"></span><span>100% particular</span></div>
          </div>
        </div>
      </div>
    </section>

    <LPStickyCTA whatsappHref={waHref} waLabel="lp-saude-gengival_sticky_whatsapp" />
  </main>
</LPLayout>

<style>
  .sg-main { background: #fff; }
  .sg-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  @media (min-width: 1024px) {
    .sg-container { padding: 0 2rem; }
  }

  /* ── Problem (cards vermelhos) ── */
  .sg-problem { padding: 5rem 0; background: #fff; }
  .sg-problem-inner { max-width: 896px; margin: 0 auto; text-align: center; }
  .sg-problem-badge {
    width: 4rem;
    height: 4rem;
    background: #fee2e2;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
  }
  .sg-problem-inner h2 {
    font-size: 1.875rem;
    font-weight: 700;
    color: #381f47;
    font-family: 'Playfair Display', Georgia, serif;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 768px) {
    .sg-problem-inner h2 { font-size: 2.25rem; }
  }
  .sg-problem-desc {
    font-size: 1.125rem;
    color: rgba(56, 31, 71, 0.8);
    margin: 0 auto 3rem;
    max-width: 768px;
  }
  @media (min-width: 768px) {
    .sg-problem-desc { font-size: 1.25rem; }
  }
  .sg-problem-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 768px) {
    .sg-problem-grid.cols-two { grid-template-columns: 1fr 1fr; }
    .sg-problem-grid.cols-three { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .sg-problem-grid.cols-three { grid-template-columns: 1fr 1fr 1fr; }
  }
  .sg-problem-card {
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 0.5rem;
    padding: 1.5rem;
    text-align: left;
  }
  .sg-problem-x {
    width: 2rem;
    height: 2rem;
    background: #fee2e2;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }
  .sg-problem-x span { color: #dc2626; font-weight: 700; }
  .sg-problem-card p { color: #381f47; font-weight: 500; }

  /* ── Guide (passos numerados) ── */
  .sg-guide { padding: 5rem 0; background: rgba(207, 203, 180, 0.5); }
  .sg-guide-inner { max-width: 896px; margin: 0 auto; }
  .sg-guide-header { text-align: center; margin-bottom: 4rem; }
  .sg-guide-header h2 {
    font-size: 1.875rem;
    font-weight: 700;
    color: #381f47;
    font-family: 'Playfair Display', Georgia, serif;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 768px) {
    .sg-guide-header h2 { font-size: 2.25rem; }
  }
  .sg-guide-header p {
    font-size: 1.125rem;
    color: rgba(56, 31, 71, 0.8);
    max-width: 672px;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .sg-guide-header p { font-size: 1.25rem; }
  }
  .sg-guide-steps { display: grid; gap: 2rem; }
  .sg-guide-step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    background: #fff;
    border-radius: 0.75rem;
    padding: 2rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(56, 31, 71, 0.1);
  }
  @media (min-width: 768px) {
    .sg-guide-step { flex-direction: row; }
  }
  .sg-guide-number {
    flex-shrink: 0;
    width: 4rem;
    height: 4rem;
    background: #b3955f;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sg-guide-number span { color: #fff; font-weight: 700; font-size: 1.25rem; }
  .sg-guide-content { flex: 1; }
  .sg-guide-content h3 {
    font-size: 1.25rem;
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    color: #381f47;
    margin-bottom: 0.75rem;
  }
  @media (min-width: 768px) {
    .sg-guide-content h3 { font-size: 1.5rem; }
  }
  .sg-guide-content p { color: rgba(56, 31, 71, 0.8); line-height: 1.625; }
  .sg-guide-check { flex-shrink: 0; display: none; }
  @media (min-width: 768px) {
    .sg-guide-check { display: block; }
  }

  /* ── Social Proof ── */
  .sg-social { padding: 5rem 0; background: #fff; }
  .sg-social-inner { max-width: 1152px; margin: 0 auto; }
  .sg-social-header { text-align: center; margin-bottom: 4rem; }
  .sg-social-header h2 {
    font-size: 1.875rem;
    font-weight: 700;
    color: #381f47;
    font-family: 'Playfair Display', Georgia, serif;
  }
  @media (min-width: 768px) {
    .sg-social-header h2 { font-size: 2.25rem; }
  }
  .sg-social-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-bottom: 4rem;
  }
  @media (min-width: 768px) {
    .sg-social-stats { grid-template-columns: repeat(4, 1fr); }
  }
  .sg-social-stat { text-align: center; }
  .sg-social-stat-icon {
    width: 3rem;
    height: 3rem;
    background: rgba(179, 149, 95, 0.1);
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
  }
  .sg-social-stat-number {
    font-size: 1.5rem;
    font-weight: 700;
    color: #381f47;
    margin-bottom: 0.5rem;
  }
  @media (min-width: 768px) {
    .sg-social-stat-number { font-size: 1.875rem; }
  }
  .sg-social-stat-label { color: rgba(56, 31, 71, 0.7); font-size: 0.875rem; }
  .sg-social-testimonials { display: grid; grid-template-columns: 1fr; gap: 2rem; }
  @media (min-width: 768px) {
    .sg-social-testimonials { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .sg-social-testimonials { grid-template-columns: 1fr 1fr 1fr; }
  }
  .sg-social-card {
    background: rgba(207, 203, 180, 0.3);
    border-radius: 0.75rem;
    padding: 1.5rem;
    border: 1px solid rgba(56, 31, 71, 0.1);
  }
  .sg-social-quote {
    color: rgba(56, 31, 71, 0.8);
    margin-bottom: 1.5rem;
    line-height: 1.625;
  }
  .sg-social-author { display: flex; align-items: center; gap: 0.75rem; }
  .sg-social-avatar {
    width: 2.5rem;
    height: 2.5rem;
    background: rgba(179, 149, 95, 0.2);
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sg-social-avatar span { color: #b3955f; font-weight: 600; }
  .sg-social-name { font-weight: 600; color: #381f47; }

  /* ── FAQ (accordion bege) ── */
  .sg-faq { padding: 5rem 0; background: rgba(207, 203, 180, 0.3); }
  .sg-faq-inner { max-width: 896px; margin: 0 auto; }
  .sg-faq-header { text-align: center; margin-bottom: 4rem; }
  .sg-faq-header h2 {
    font-size: 1.875rem;
    font-weight: 700;
    color: #381f47;
    font-family: 'Playfair Display', Georgia, serif;
  }
  @media (min-width: 768px) {
    .sg-faq-header h2 { font-size: 2.25rem; }
  }
  .sg-faq-list { display: grid; gap: 1rem; }
  .sg-faq-item {
    background: rgba(207, 203, 180, 0.2);
    border-radius: 0.5rem;
    border: 1px solid rgba(56, 31, 71, 0.2);
    padding: 0 1.5rem;
  }
  .sg-faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    text-align: left;
    font-size: 1.125rem;
    font-weight: 600;
    color: #381f47;
    padding: 1.5rem 0;
    cursor: pointer;
    list-style: none;
    transition: color 0.2s;
  }
  .sg-faq-item summary::-webkit-details-marker { display: none; }
  .sg-faq-item summary:hover { color: #b3955f; }
  .sg-faq-chevron { flex-shrink: 0; transition: transform 0.2s; color: #381f47; }
  .sg-faq-item[open] .sg-faq-chevron { transform: rotate(180deg); }
  .sg-faq-answer {
    color: rgba(56, 31, 71, 0.8);
    line-height: 1.625;
    padding-bottom: 1.5rem;
  }

  /* ── CTA final (gradiente roxo) ── */
  .sg-cta {
    padding: 5rem 0;
    background: linear-gradient(to bottom right, #381f47, rgba(56, 31, 71, 0.9));
    color: #fff;
  }
  .sg-cta-inner { max-width: 896px; margin: 0 auto; text-align: center; }
  .sg-cta-inner h2 {
    font-size: 1.875rem;
    font-weight: 700;
    color: #fff;
    font-family: 'Playfair Display', Georgia, serif;
    margin-bottom: 1.5rem;
    line-height: 1.25;
  }
  @media (min-width: 768px) {
    .sg-cta-inner h2 { font-size: 3rem; }
  }
  .sg-cta-sub {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.9);
    margin: 0 auto 3rem;
    max-width: 768px;
  }
  @media (min-width: 768px) {
    .sg-cta-sub { font-size: 1.5rem; }
  }
  .sg-cta-buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: center;
    align-items: center;
  }
  @media (min-width: 640px) {
    .sg-cta-buttons { flex-direction: row; }
  }
  .sg-cta-primary {
    background: #381f47;
    color: #fff;
    padding: 1.5rem 3rem;
    border-radius: 0.5rem;
    font-size: 1.25rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: all 0.3s;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
  }
  .sg-cta-primary:hover {
    background: #4a2759;
    transform: scale(1.05);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
  }
  .sg-cta-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 1rem 2rem;
    border-radius: 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: all 0.3s;
    width: 100%;
  }
  @media (min-width: 640px) {
    .sg-cta-secondary { width: auto; }
  }
  .sg-cta-secondary:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.05);
  }
  .sg-cta-trust {
    margin-top: 3rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    color: rgba(255, 255, 255, 0.7);
