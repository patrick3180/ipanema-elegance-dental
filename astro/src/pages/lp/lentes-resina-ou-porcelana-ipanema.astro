---
/**
 * /lp/lentes-resina-ou-porcelana-ipanema — porte de
 * src/pages/LentesResinaOuPorcelanaLandingPage.tsx
 * Config: lentesComparacaoConfig. Seções: Hero → StatsBar → Problem →
 * ComparacaoResinaPorcelana → Guide → MidCTA (heading próprio) → DoctorBio →
 * SocialProof → FAQ → FinalCTA (ordem igual à do React).
 */
import LPLayout from '../../layouts/LPLayout.astro';
import LPHeroFullBleed from '../../components/lp/LPHeroFullBleed.astro';
import LPStatsBar from '../../components/lp/LPStatsBar.astro';
import LPProblem from '../../components/lp/LPProblem.astro';
import LPComparacaoResinaPorcelana from '../../components/lp/LPComparacaoResinaPorcelana.astro';
import LPDoctorBio from '../../components/lp/LPDoctorBio.astro';
import LPGuide from '../../components/lp/LPGuide.astro';
import LPMidCTA from '../../components/lp/LPMidCTA.astro';
import LPSocialProof from '../../components/lp/LPSocialProof.astro';
import LPFAQ from '../../components/lp/LPFAQ.astro';
import LPFinalCTA from '../../components/lp/LPFinalCTA.astro';
import LPStickyCTA from '../../components/lp/LPStickyCTA.astro';
import { lentesComparacaoConfig as config } from '@/config/lentesComparacaoConfig';

const waHref = `https://wa.me/${config.whatsapp.number}?text=${encodeURIComponent(config.whatsapp.message)}`;
// Onda 1: CTA contextual do mini-seletor ("não sei — quero orientação")
const waHrefOrientacao = `https://wa.me/${config.whatsapp.number}?text=${encodeURIComponent('Olá! Estou em dúvida entre lente de resina e de porcelana e gostaria de agendar uma consulta para orientação.')}`;
const prefix = 'lp-lentes-comparacao';

// Schema — copiado verbatim do Helmet de LentesResinaOuPorcelanaLandingPage.tsx
const schemas = [
  JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Dentist',
        '@id': 'https://dracarlachristoph.com/#dentist',
        name: 'Dra. Carla Christoph',
        description: config.seo.description,
        url: 'https://dracarlachristoph.com/lp/lentes-resina-ou-porcelana-ipanema',
        telephone: '+5521993304045',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Rua Visconde de Pirajá, 550 - Sala 1107',
          addressLocality: 'Ipanema',
          addressRegion: 'RJ',
          postalCode: '22410-901',
          addressCountry: 'BR',
        },
        geo: { '@type': 'GeoCoordinates', latitude: '-22.9866', longitude: '-43.2024' },
        speciality: ['Prótese Dental', 'Implantodontia', 'Estética Dental'],
        image: 'https://dracarlachristoph.com/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp',
      },
      {
        '@type': 'Service',
        name: 'Lentes de Contato Dental — Resina ou Porcelana',
        description:
          'Comparação entre lentes de contato dental em porcelana e facetas de resina. A indicação do material é definida individualmente na consulta, com Test Drive do Sorriso e planejamento digital iTero Element 5D quando indicado.',
        provider: { '@id': 'https://dracarlachristoph.com/#dentist' },
        areaServed: { '@type': 'City', name: 'Rio de Janeiro' },
        serviceType: 'Cosmetic Dentistry',
      },
      {
        '@type': 'FAQPage',
        mainEntity: config.faq.questions.map((q) => ({
          '@type': 'Question',
          name: q.question,
          acceptedAnswer: { '@type': 'Answer', text: q.answer },
        })),
      },
    ],
  }),
];
---

<LPLayout
  title={config.seo.title}
  description={config.seo.description}
  canonical="https://dracarlachristoph.com/lp/lentes-resina-ou-porcelana-ipanema"
  ogImage="https://dracarlachristoph.com/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp"
  schemas={schemas}
  whatsappHref={waHref}
  waLabelPrefix={prefix}
>
  <main id="main-content" class="lp-main">
    <!-- Onda 1 (jul/2026): variante DIAGNÓSTICO — a dúvida é o gancho, então o
         texto/CTA vêm antes (layout 'acao'); a foto vira faixa menor após o CTA. -->
    <LPHeroFullBleed
      layout="acao"
      eyebrow="Dentista em Ipanema · Zona Sul"
      headline={config.hero.headline}
      subheadline={config.hero.subheadline}
      ctaText={config.hero.ctaText}
      whatsappHref={waHref}
      waLabel={`${prefix}_hero_whatsapp`}
      benefits={['Test Drive do Sorriso antes de decidir', 'iTero Element 5D quando indicado']}
    />

    <!-- Mini-seletor de caminhos (Onda 1 — padrão do seletor da Prótese V2) -->
    <section class="cmp-sel" aria-label="Escolha o seu caminho">
      <div class="cmp-sel-inner">
        <p class="cmp-sel-title">O que pesa mais para você?</p>
        <div class="cmp-sel-grid">
          <a class="cmp-sel-card" href="#comparacao">
            <b>Máxima durabilidade</b>
            <span>Porcelana: em média 15 a 20 anos e não mancha — ver a comparação</span>
            <em>→</em>
          </a>
          <a class="cmp-sel-card" href="#comparacao">
            <b>Resultado rápido</b>
            <span>Resina: 1 a 2 sessões, investimento mais acessível — ver a comparação</span>
            <em>→</em>
          </a>
          <a
            class="cmp-sel-card js-wa-cta"
            data-label={`${prefix}_seletor_orientacao_whatsapp`}
            href={waHrefOrientacao}
            target="_blank"
            rel="noopener"
          >
            <b>Não sei — quero orientação</b>
            <span>A Dra. Carla avalia seu caso na consulta e indica o material</span>
            <em>→</em>
          </a>
        </div>
      </div>
    </section>

    <LPStatsBar />

    <LPProblem
      title={config.problem.title}
      description={config.problem.description}
      problems={config.problem.problems}
    />

    <div id="comparacao">
      <LPComparacaoResinaPorcelana />
    </div>

    <LPGuide title={config.guide.title} subtitle={config.guide.subtitle} steps={config.guide.steps} />

    <LPMidCTA
      whatsappHref={waHref}
      waLabel={`${prefix}_midcta_whatsapp`}
      heading="Ainda na dúvida entre resina e porcelana?"
      ctaLabel="Tirar Minhas Dúvidas no WhatsApp"
    />

    <LPDoctorBio />

    <LPSocialProof
      title={config.socialProof.title}
      testimonials={config.socialProof.testimonials}
      stats={config.socialProof.stats}
    />

    <LPFAQ title={config.faq.title} questions={config.faq.questions} />

    <LPFinalCTA
      title={config.cta.title}
      subtitle={config.cta.subtitle}
      buttonText={config.cta.buttonText}
      urgency={config.cta.urgency}
      whatsappHref={waHref}
      waLabel={`${prefix}_final_whatsapp`}
    />

    <LPStickyCTA whatsappHref={waHref} waLabel={`${prefix}_sticky_whatsapp`} />
  </main>
</LPLayout>

<style>
  .lp-main { background: #fff; min-height: 100vh; }

  /* Mini-seletor de caminhos (Onda 1) — visual derivado do seletor da Prótese V2 */
  .cmp-sel { background: #fff; padding: 2.25rem 1.25rem 1rem; }
  .cmp-sel-inner { max-width: 1024px; margin: 0 auto; }
  .cmp-sel-title {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #8a7444;
    font-weight: 600;
    margin: 0 0 0.9rem;
    text-align: center;
  }
  .cmp-sel-grid { display: grid; grid-template-columns: 1fr; gap: 0.75rem; }
  @media (min-width: 768px) {
    .cmp-sel-grid { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  }
  .cmp-sel-card {
    position: relative;
    display: block;
    background: #faf7f2;
    border: 1.5px solid rgba(179, 149, 95, 0.35);
    border-radius: 12px;
    padding: 0.9rem 2.2rem 0.9rem 1rem;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .cmp-sel-card:hover { border-color: #b3955f; transform: translateY(-2px); }
  .cmp-sel-card b {
    display: block;
    font-size: 0.95rem;
    color: #381f47;
    margin-bottom: 0.25rem;
  }
  .cmp-sel-card span { font-size: 0.82rem; color: #6b6455; line-height: 1.45; }
  .cmp-sel-card em {
    position: absolute;
    right: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    font-style: normal;
    color: #b3955f;
    font-weight: 700;
  }
  #comparacao { scroll-margin-top: 84px; }
</style>
