---
/**
 * /lp/limpeza-dental-ipanema — porte de src/pages/LimpezaDentalLandingPage.tsx
 * Config: limpezaDentalConfig. Hero PRÓPRIO desta LP (implementação inline
 * "Sprint 9 / V5" do React: badges CRO + Particular, nota "WhatsApp 24h",
 * sem pill do Google) — por isso não usa o LPHero compartilhado.
 * Seções: Hero → StatsBar → Problem → DoctorBio → Guide → MidCTA
 * ("Agendar Minha Limpeza") → SocialProof → FAQ → FinalCTA (+ floating).
 */
import LPLayout from '../../layouts/LPLayout.astro';
import LPStatsBar from '../../components/lp/LPStatsBar.astro';
import LPProblem from '../../components/lp/LPProblem.astro';
import LPDoctorBio from '../../components/lp/LPDoctorBio.astro';
import LPGuide from '../../components/lp/LPGuide.astro';
import LPMidCTA from '../../components/lp/LPMidCTA.astro';
import LPSocialProof from '../../components/lp/LPSocialProof.astro';
import LPFAQ from '../../components/lp/LPFAQ.astro';
import LPFinalCTA from '../../components/lp/LPFinalCTA.astro';
import LPFloatingWhatsApp from '../../components/lp/LPFloatingWhatsApp.astro';
import { limpezaDentalConfig as config } from '@/config/limpezaDentalConfig';

const waHref = `https://wa.me/${config.whatsapp.number}?text=${encodeURIComponent(config.whatsapp.message)}`;
const prefix = 'lp-limpeza';

// Schema — copiado verbatim do Helmet de LimpezaDentalLandingPage.tsx
// (@graph Dentist + Service + FAQPage)
const schemas = [
  JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Dentist',
        '@id': 'https://dracarlachristoph.com/#dentist',
        name: 'Dra. Carla Christoph',
        description: config.seo.description,
        url: 'https://dracarlachristoph.com/lp/limpeza-dental-ipanema',
        telephone: '+5521993304045',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Rua Visconde de Pirajá, 550 - Sala 1107',
          addressLocality: 'Ipanema',
          addressRegion: 'RJ',
          postalCode: '22410-901',
          addressCountry: 'BR',
        },
        geo: { '@type': 'GeoCoordinates', latitude: '-22.9866', longitude: '-43.2024' },
        speciality: ['Prótese Dental', 'Implantodontia', 'Estética Dental'],
        image: `https://dracarlachristoph.com${config.hero.backgroundImage}`,
      },
      {
        '@type': 'Service',
        name: 'Limpeza Dental Profissional',
        description:
          'Profilaxia profissional com tecnologia ultrassônica. Remoção de tártaro, placa bacteriana e manchas em consulta sem pressa.',
        provider: { '@id': 'https://dracarlachristoph.com/#dentist' },
        areaServed: { '@type': 'City', name: 'Rio de Janeiro' },
        serviceType: 'Preventive Dentistry',
      },
      {
        '@type': 'FAQPage',
        mainEntity: config.faq.questions.map((q) => ({
          '@type': 'Question',
          name: q.question,
          acceptedAnswer: { '@type': 'Answer', text: q.answer },
        })),
      },
    ],
  }),
];
---

<LPLayout
  title={config.seo.title}
  description={config.seo.description}
  canonical="https://dracarlachristoph.com/lp/limpeza-dental-ipanema"
  ogImage={`https://dracarlachristoph.com${config.hero.backgroundImage}`}
  schemas={schemas}
  whatsappHref={waHref}
  waLabelPrefix={prefix}
>
  <main id="main-content" class="lp-main">
    <!-- Hero próprio da LP de Limpeza (inline no React — Sprint 9 / V5) -->
    <section class="lz-hero">
      <div class="lz-hero-radial" aria-hidden="true"></div>
      <div class="lz-container">
        <div class="lz-hero-flex">
          <div class="lz-hero-content">
            <div class="lz-hero-badges">
              <span class="lz-badge lz-badge-purple">CRO-RJ 27.509</span>
              <span class="lz-badge lz-badge-gold">Atendimento Particular · Ipanema</span>
            </div>

            <div class="lz-hero-headlines">
              <h1 class="lz-hero-h1">{config.hero.headline}</h1>
              <p class="lz-hero-sub">{config.hero.subheadline}</p>
            </div>

            <div class="lz-hero-benefits">
              {config.benefits.map((benefit) => (
                <span class="lz-hero-pill"><span class="lz-dot" aria-hidden="true">●</span>{benefit}</span>
              ))}
            </div>

            <div class="lz-hero-cta-wrap">
              <a
                class="lz-hero-cta js-wa-cta"
                data-label={`${prefix}_hero_whatsapp`}
                href={waHref}
                target="_blank"
                rel="noopener"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                {config.hero.ctaText}
              </a>
              <div class="lz-wa24">
                <span class="lz-wa24-dot" aria-hidden="true">●</span>
                <span class="lz-wa24-text">WhatsApp 24h</span>
              </div>
            </div>
          </div>

          <div class="lz-hero-imagecol">
            <div class="lz-hero-imagewrap">
              <div class="lz-hero-imageframe">
                <picture>
                  <source
                    srcset="/lovable-uploads/vertical-de-jaleco-480.avif 480w, /lovable-uploads/vertical-de-jaleco-1024.avif 1024w"
                    sizes="(max-width:767px) 100vw, (min-width:768px) 50vw, 40vw"
                    type="image/avif"
                  />
                  <img
                    src={config.hero.backgroundImage}
                    alt="Dra. Carla Christoph - Consulta Odontológica Personalizada em Ipanema"
                    width="380"
                    height="570"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                  />
                </picture>
              </div>
              <div class="lz-hero-floatbadge">
                <span class="lz-dot" aria-hidden="true">●</span>
                <span>20+ Anos de Experiência</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <LPStatsBar />

    <LPProblem
      title={config.problem.title}
      description={config.problem.description}
      problems={config.problem.problems}
    />

    <LPDoctorBio />

    <LPGuide title={config.guide.title} subtitle={config.guide.subtitle} steps={config.guide.steps} />

    <LPMidCTA
      whatsappHref={waHref}
      waLabel={`${prefix}_midcta_whatsapp`}
      ctaLabel="Agendar Minha Limpeza"
    />

    <LPSocialProof
      title={config.socialProof.title}
      testimonials={config.socialProof.testimonials}
      stats={config.socialProof.stats}
    />

    <LPFAQ title={config.faq.title} questions={config.faq.questions} />

    <LPFinalCTA
      title={config.cta.title}
      subtitle={config.cta.subtitle}
      buttonText={config.cta.buttonText}
      urgency={config.cta.urgency}
      whatsappHref={waHref}
      waLabel={`${prefix}_final_whatsapp`}
    />

    <LPFloatingWhatsApp whatsappHref={waHref} waLabel={`${prefix}_floating_whatsapp`} />
  </main>
</LPLayout>

<style>
  .lp-main { background: #fff; min-height: 100vh; }

  /* ── Hero (paridade com o hero inline do React) ── */
  .lz-hero {
    position: relative;
    overflow: hidden;
    padding: 90px 0 4rem;
    background: linear-gradient(170deg, #faf7f2 0%, #f5f0e8 40%, #ede8dc 100%);
  }
  @media (min-width: 1024px) {
    .lz-hero { padding-top: 96px; padding-bottom: 6rem; }
  }
  .lz-hero-radial {
    position: absolute;
    top: 0;
    right: 0;
    width: 500px;
    height: 500px;
    pointer-events: none;
    background: radial-gradient(circle at 80% 20%, rgba(179, 149, 95, 0.05) 0%, transparent 70%);
  }
  .lz-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1rem;
    position: relative;
    z-index: 10;
  }
  .lz-hero-flex {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .lz-hero-flex { flex-direction: row; }
  }
  .lz-hero-content {
    width: 100%;
    display: grid;
    gap: 1.75rem;
  }
  @media (min-width: 1024px) {
    .lz-hero-content { width: 60%; }
  }
  .lz-hero-badges { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .lz-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.375rem 0.75rem;
    border-radius: 9999px;
  }
  .lz-badge-purple { background: rgba(56, 31, 71, 0.1); color: #381f47; }
  .lz-badge-gold { background: rgba(179, 149, 95, 0.15); color: #8b7340; }
  .lz-hero-headlines { display: grid; gap: 1rem; }
  .lz-hero-h1 {
    font-size: 34px;
    font-weight: 700;
    color: #381f47;
    line-height: 1.25;
    font-family: 'Playfair Display', Georgia, serif;
  }
  @media (min-width: 768px) {
    .lz-hero-h1 { font-size: 2.25rem; }
  }
  @media (min-width: 1024px) {
    .lz-hero-h1 { font-size: 3rem; }
  }
  .lz-hero-sub {
    font-size: 1rem;
    color: #4b5563;
    line-height: 1.625;
  }
  @media (min-width: 768px) {
    .lz-hero-sub { font-size: 1.125rem; }
  }
  .lz-hero-benefits {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .lz-hero-benefits { grid-template-columns: 1fr 1fr; }
  }
  .lz-hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #fff;
    border: 1px solid rgba(179, 149, 95, 0.4);
    border-radius: 9999px;
    padding: 0.375rem 0.875rem;
    font-size: 0.875rem;
    color: #381f47;
    font-weight: 500;
  }
  .lz-dot { color: #b3955f; font-size: 8px; }
  .lz-hero-cta-wrap { display: grid; gap: 0.5rem; justify-items: start; }
  .lz-hero-cta {
    width: 100%;
    color: #fff;
    border-radius: 10px;
    padding: 1rem 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.3);
    background: linear-gradient(135deg, #25d366 0%, #20bd5a 100%);
  }
  .lz-hero-cta:hover {
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.4);
    transform: scale(1.05);
  }
  @media (min-width: 768px) {
    .lz-hero-cta { width: auto; justify-content: flex-start; }
  }
  .lz-wa24 { display: flex; align-items: center; gap: 0.375rem; }
  @media (min-width: 768px) {
    .lz-wa24 { padding-left: 0.25rem; }
  }
  .lz-wa24-dot { color: #22c55e; font-size: 8px; }
  .lz-wa24-text { font-size: 11px; color: #6b7280; }
  .lz-hero-imagecol { width: 100%; }
  @media (min-width: 1024px) {
    .lz-hero-imagecol { width: 40%; }
  }
  .lz-hero-imagewrap {
    position: relative;
    aspect-ratio: 760 / 996;
  }
  .lz-hero-imageframe {
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(74, 45, 94, 0.08);
    height: 100%;
  }
  .lz-hero-imageframe picture,
  .lz-hero-imageframe img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .lz-hero-floatbadge {
    display: none;
    position: absolute;
    bottom: 1.5rem;
    left: 1rem;
    background: #fff;
    border-radius: 12px;
    padding: 0.625rem 1rem;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    font-size: 11px;
    font-weight: 600;
    color: #381f47;
  }
  @media (min-width: 768px) {
    .lz-hero-floatbadge { display: flex; }
  }
</style>
