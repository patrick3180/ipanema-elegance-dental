  /* ── Grid do hero: 1 coluna no mobile (foto vira avatar no topo via order),
        2 colunas no desktop (texto | retrato) ── */
  .cl-hero-grid { display: flex; flex-direction: column; }
  @media (min-width: 900px) {
    .cl-hero-grid {
      display: grid;
      /* coluna da foto FIXA em 340px, casada com o `sizes` do <source>: o original
         só tem 500px reais, então acima disso a imagem começa a ficar mole em telas
         retina. Com 340px o upscale fica em ~1,36× no DPR2 — aceitável. */
      grid-template-columns: 1fr 340px;
      gap: 3.5rem;
      align-items: center;
    }
  }

  .cl-hero-foto { margin: 0; }

  /* MOBILE: retrato de 84px, SEM legenda — nome e CRO já estão no header fixo
     e de novo nos trust pills logo abaixo do CTA; repetir aqui era a mesma
     credencial 3× na primeira dobra. Canto arredondado (não círculo): o site
     já usa avatar circular pequeno para depoimento de PACIENTE (.tst-avatar,
     a bolinha com a inicial do nome) — a foto da própria médica nesse mesmo
     formato lia como "isso é uma review", não "essa é a médica". */
  @media (max-width: 899px) {
    .cl-hero-foto { order: -1; margin-bottom: 1.25rem; }
    .cl-hero-foto img {
      width: 84px;
      height: 84px;
