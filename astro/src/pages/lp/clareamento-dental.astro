<style>
  /* ═══ Tokens (mesma paleta do site — DESIGN.md) ═══
     Contraste: o dourado #B3955F NÃO passa AA como texto sobre claro nem como
     fundo com texto branco (2,07:1 e 2,85:1 medidos). Aqui ele é usado só como
     preenchimento/acento e em texto sobre fundo escuro. Texto = ameixa. */
  .cl-main {
    --purple: #381f47;
    --purple-soft: #5a3f69;
    --gold: #b3955f;
    /* #8A7444 dá 4,50:1 no branco — no limite exato do AA para rótulos de 10-11px.
       #7A6539 sobe para 5,6:1 e mantém a família do latão. */
    --gold-dark: #7a6539;
    --linho: #cfcbb4;
    --linho-claro: #e9e5d9;
    --areia: #f6f3ec;
    --grafite: #525252;
    /* O #128C4A do site dá 4,30:1 com texto branco — reprova AA por pouco.
       #0F7540 (já usado como hover no site) dá 5,8:1. */
    --wa: #0f7540;
    --wa-hover: #0b5e33;

    /* ═══ TYPESET — escala de 7 degraus (a página tinha 22 valores distintos) ═══
       Razão 1,25 no MÍNIMO do clamp (piso do registro BRAND), abrindo para ~1,33
       no máximo. O problema anterior não era só a quantidade de valores: os quatro
       clamps só destravavam do mínimo entre 503px e 700px de viewport, ou seja, a
       escala "fluida" era FIXA exatamente onde vivem 87% do tráfego. Estes mínimos
       são calibrados para o mobile, não para o desktop. */
    --fs-display: clamp(2rem, 5.6vw, 3rem);
    --lh-display: 1.10;
    --fs-h2: clamp(1.6rem, 4.2vw, 2.25rem);
    --lh-h2: 1.18;
    --fs-h3: clamp(1.25rem, 2.6vw, 1.5rem);
    --lh-h3: 1.30;
    --fs-lead: 1.125rem;
    --lh-lead: 1.60;
    --fs-body: 1rem;
    --lh-body: 1.70;
    --fs-small: 0.875rem;
    --lh-small: 1.55;
    --fs-label: 0.75rem;
    --lh-label: 1.40;
    /* Ornamento, NÃO um degrau da escala: a aspa em marca-d'água do pull-quote.
       É glifo decorativo (aria-hidden por ser ::before), não texto — por isso
       fica fora da rampa de 7 degraus de propósito, e nomeado para não parecer
       um valor solto. */
    --fs-ornamento: 4rem;
    /* Um tracking para TODOS os rótulos caixa-alta (havia cinco: 0.04/0.08/0.10/
       0.12/0.16em — dois deles fora da banda de 5–12% do registro). */
    --ls-label: 0.09em;

    /* ═══ POLISH — raios do DESIGN.md ═══
       A página usava 5/10/12/14px; o sistema documentava só 4/6/8/999. Causa-raiz
       era TOKEN FALTANDO: o site usa 12px e 16px em 14 lugares. DESIGN.md agora
       documenta xl/2xl e a página passa a consumir os tokens. */
    --r-sm: 4px;
    --r-lg: 8px;
    --r-xl: 12px;
    --r-2xl: 16px;
    --r-pill: 999px;

    /* Sombras do sidecar .impeccable/design.json (eram 5 alfas de preto ad-hoc) */
    --sh-soft: 0 4px 20px hsl(0 0% 0% / 0.08);
    --sh-hover: 0 12px 32px rgba(56, 31, 71, 0.16), 0 6px 16px rgba(56, 31, 71, 0.1);
    --sh-elegant: 0 10px 40px -10px rgba(56, 31, 71, 0.28);

    /* Texto sobre fundo escuro — eram 4 alfas distintos para o mesmo papel */
    --on-dark: rgba(255, 255, 255, 0.86);
    --on-dark-muted: rgba(255, 255, 255, 0.62);

    background: #fff;
    color: var(--purple);
    font-family: Montserrat, system-ui, -apple-system, sans-serif;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  /* Peso 700 NÃO tem arquivo de fonte carregado (só 400/500/600 de Montserrat e
     400/600 de Playfair). Todo <b>/<strong> caía em faux bold — o navegador
     engorda o contorno por algoritmo, o que numa serifa fina destrói o contraste
     modulado. 600 já é o peso de ênfase da página e já está carregado. */
  .cl-main :is(strong, b) { font-weight: 600; }

  /* Ritmo vertical: no mobile as 8 seções somavam 768px só de padding
     (48px+48px cada). A 36px ainda respira — a página é longa por empilhamento,
     e cada tela precisa pagar aluguel quando só 13% chegam ao fim. */
  @media (max-width: 767px) {
    .cl-main :is(.cl-sel, .cl-escala, .cl-sens, .cl-nao, .cl-bio, .cl-prova, .cl-consulta) {
