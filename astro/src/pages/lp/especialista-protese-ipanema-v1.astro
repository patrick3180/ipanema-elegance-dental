---
/**
 * /lp/especialista-protese-ipanema-v1 — V1 CONGELADA da LP de Prótese.
 * Porte de src/pages/EspecialistaProteseLandingPage.tsx (especialistaProteseConfig).
 * A V2 vive na URL principal /lp/especialista-protese-ipanema.
 * Seções: Hero → Problem → Guide → SocialProof → FAQ → FinalCTA (+ floating).
 */
import LPLayout from '../../layouts/LPLayout.astro';
import LPHero from '../../components/lp/LPHero.astro';
import LPProblem from '../../components/lp/LPProblem.astro';
import LPGuide from '../../components/lp/LPGuide.astro';
import LPSocialProof from '../../components/lp/LPSocialProof.astro';
import LPFAQ from '../../components/lp/LPFAQ.astro';
import LPFinalCTA from '../../components/lp/LPFinalCTA.astro';
import LPFloatingWhatsApp from '../../components/lp/LPFloatingWhatsApp.astro';
import { especialistaProteseConfig as config } from '@/config/especialistaProteseConfig';

const waHref = `https://wa.me/${config.whatsapp.number}?text=${encodeURIComponent(config.whatsapp.message)}`;
const prefix = 'lp-protese-v1';

// Schemas — copiados verbatim do Helmet de EspecialistaProteseLandingPage.tsx
// (Dentist + MedicalProcedure). Canonical do React apontava para a URL principal;
// aqui usamos a URL própria da V1 congelada (rota real desta página).
const schemas = [
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Dentist',
    name: 'Dra. Carla Christoph',
    image: 'https://dracarlachristoph.com/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp',
    description:
      'Reabilitação oral para casos complexos em Ipanema. Especialista em prótese dentária com planejamento detalhado.',
    url: 'https://dracarlachristoph.com/lp/especialista-protese-ipanema',
    telephone: '+5521993304045',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Rua Visconde de Pirajá, 550 - Sala 1107',
      addressLocality: 'Ipanema',
      addressRegion: 'RJ',
      postalCode: '22410-901',
      addressCountry: 'BR',
    },
    geo: { '@type': 'GeoCoordinates', latitude: -22.9868, longitude: -43.2005 },
    areaServed: { '@type': 'City', name: 'Rio de Janeiro' },
    priceRange: '$$$',
    openingHours: 'Mo-Fr 09:00-19:00',
  }),
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'MedicalProcedure',
    name: 'Reabilitação Oral e Prótese Dentária',
    description:
      'Tratamento especializado para reabilitação oral completa com próteses dentárias de alta estética',
    procedureType: 'Reconstructive',
    performer: { '@type': 'Dentist', name: 'Dra. Carla Christoph' },
    medicationWarning:
      'Consulte sempre um profissional qualificado antes de qualquer procedimento odontológico',
  }),
];
---

<LPLayout
  title={config.seo.title}
  description={config.seo.description}
  canonical="https://dracarlachristoph.com/lp/especialista-protese-ipanema-v1"
  ogImage="https://dracarlachristoph.com/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp"
  schemas={schemas}
  whatsappHref={waHref}
  waLabelPrefix={prefix}
>
  <main id="main-content" class="lp-main">
    <LPHero
      headline={config.hero.headline}
      subheadline={config.hero.subheadline}
      ctaText={config.hero.ctaText}
      benefits={config.benefits}
      backgroundImage={config.hero.backgroundImage || ''}
      whatsappHref={waHref}
      waLabel={`${prefix}_hero_whatsapp`}
      imgWidth={800}
      imgHeight={1200}
    />

    <LPProblem
      title={config.problem.title}
      description={config.problem.description}
      problems={config.problem.problems}
    />

    <LPGuide title={config.guide.title} subtitle={config.guide.subtitle} steps={config.guide.steps} />

    <LPSocialProof
      title={config.socialProof.title}
      testimonials={config.socialProof.testimonials}
      stats={config.socialProof.stats}
    />

    <LPFAQ title={config.faq.title} questions={config.faq.questions} />

    <LPFinalCTA
      title={config.cta.title}
      subtitle={config.cta.subtitle}
      buttonText={config.cta.buttonText}
      urgency={config.cta.urgency}
      whatsappHref={waHref}
      waLabel={`${prefix}_final_whatsapp`}
    />

    <LPFloatingWhatsApp whatsappHref={waHref} waLabel={`${prefix}_floating_whatsapp`} />
  </main>
</LPLayout>

<style>
  .lp-main { background: #fff; min-height: 100vh; }
</style>
