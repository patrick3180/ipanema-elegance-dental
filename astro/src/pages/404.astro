---
/**
 * Página 404 — Astro gera dist/404.html; a Vercel serve com status 404
 * para rotas não encontradas (substitui o catch-all da SPA).
 */
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Página não encontrada | Dra. Carla Christoph"
  description="A página que você procura não foi encontrada. Volte ao início ou fale com a Dra. Carla Christoph pelo WhatsApp."
  canonical="https://dracarlachristoph.com/404"
  noindex={true}
>
  <main id="main-content" class="nf-page">
    <div class="nf-inner">
      <p class="nf-code">404</p>
      <h1>Página não encontrada</h1>
      <p class="nf-text">
        O endereço que você tentou acessar não existe ou foi movido. Use os links abaixo para
        continuar navegando.
      </p>
      <div class="nf-actions">
        <a class="nf-btn primary" href="/">Voltar ao início</a>
        <a class="nf-btn" href="/servicos">Tratamentos</a>
        <a class="nf-btn" href="/blog">Blog</a>
        <a
          class="nf-btn wa js-wa-cta"
          data-label="404_whatsapp"
          href="https://wa.me/5521993304045?text=Ol%C3%A1!%20Gostaria%20de%20agendar%20uma%20consulta."
          target="_blank"
          rel="noopener">Falar no WhatsApp</a>
      </div>
    </div>
  </main>
</SiteLayout>

<style>
  .nf-page {
    max-width: 640px;
    margin: 0 auto;
    padding: 140px 20px 80px;
    text-align: center;
  }
  .nf-code {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(3.5rem, 12vw, 6rem);
    color: var(--dental-gold);
    line-height: 1;
    margin-bottom: 8px;
  }
  h1 {
    font-size: clamp(1.5rem, 5vw, 2rem);
    margin-bottom: 14px;
  }
  .nf-text {
    color: #4a4437;
    line-height: 1.7;
    margin-bottom: 28px;
  }
  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  .nf-btn {
    display: inline-block;
    padding: 12px 22px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--dental-purple);
    border: 1px solid rgba(56, 31, 71, 0.25);
    background: #fff;
  }
  .nf-btn.primary {
    background: var(--dental-purple);
    color: #fff;
    border-color: var(--dental-purple);
  }
  .nf-btn.wa {
    background: var(--wa-green);
    color: #fff;
    border-color: var(--wa-green);
  }
</style>
