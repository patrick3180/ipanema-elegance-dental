---

<SiteLayout
  title="Dentista em Ipanema | Dra. Carla Christoph — Mínimo de 1h"
  description="Especialista em Prótese e Implantodontia, 20+ anos em Ipanema. Nota 5,0 no Google, consultas de no mínimo 1 hora e atendimento particular. Agende pelo WhatsApp."
  canonical="https://dracarlachristoph.com/"
  schemas={schemas}
>
  <Fragment slot="head">
    <!-- Hero image preload responsivo (LCP element) — mesmo bloco do generate-static-meta.cjs (Sprint 5) -->
    <link
      rel="preload"
      as="image"
      type="image/avif"
      media="(max-width: 767px)"
      imagesrcset="/lovable-uploads/hero-fb-m-480.avif 480w, /lovable-uploads/hero-fb-m-768.avif 768w"
      imagesizes="100vw"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      type="image/avif"
      media="(min-width: 768px)"
      imagesrcset="/lovable-uploads/hero-fb-1280.avif 1280w, /lovable-uploads/hero-fb-1920.avif 1920w"
      imagesizes="100vw"
      fetchpriority="high"
    />
    <!-- hreflang (paridade com SEOHead da home) -->
    <link rel="alternate" hreflang="pt-BR" href="https://dracarlachristoph.com/" />
    <link rel="alternate" hreflang="en" href="https://dracarlachristoph.com/en" />
    <link rel="alternate" hreflang="x-default" href="https://dracarlachristoph.com/" />
    <meta
      name="keywords"
      content="dentista Ipanema, clínica odontológica Ipanema, odontologia estética Ipanema, implantes dentários Ipanema, lentes de contato dental, facetas de porcelana, clareamento dental, prótese dentária, Dra. Carla Christoph, dentista especialista Rio de Janeiro"
    />
  </Fragment>

  <main id="main-content">
    <!-- Marca html.js cedo: os estados "escondido" de scroll-reveal só valem com JS ativo -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <!-- Entrada do hero (L2) só dispara com as fontes prontas: as palavras nascem já em Playfair e a troca de
         fonte acontece com o bloco invisível (não conta como layout shift). Teto de 2,5 s; sem JS, tudo estático. -->
    <script is:inline>
      (function () {
        var h = document.documentElement, done = false;
        function go() { if (!done) { done = true; h.classList.add('fonts-ready'); } }
        try {
          if (document.fonts && document.fonts.load) {
            Promise.all([document.fonts.load('600 1em "Playfair Display"'), document.fonts.load('600 1em Montserrat')]).then(go, go);
            setTimeout(go, 2500);
          } else { go(); }
        } catch (e) { go(); }
      })();
    </script>

    <!-- ═══ 1. HERO full-bleed (Hero.tsx) ═══ -->
    <section id="início" class="hero-fb">
      <picture class="hero-fb-photo">
        <source media="(max-width: 767px)" type="image/avif" srcset="/lovable-uploads/hero-fb-m-480.avif 480w, /lovable-uploads/hero-fb-m-768.avif 768w" sizes="100vw" />
        <source media="(max-width: 767px)" type="image/webp" srcset="/lovable-uploads/hero-fb-m-480.webp 480w, /lovable-uploads/hero-fb-m-768.webp 768w" sizes="100vw" />
        <source media="(min-width: 768px)" type="image/avif" srcset="/lovable-uploads/hero-fb-1280.avif 1280w, /lovable-uploads/hero-fb-1920.avif 1920w" sizes="100vw" />
        <source media="(min-width: 768px)" type="image/webp" srcset="/lovable-uploads/hero-fb-1280.webp 1280w, /lovable-uploads/hero-fb-1920.webp 1920w" sizes="100vw" />
        <img
          src="/lovable-uploads/hero-fb-1280.webp"
          alt="Dra. Carla Christoph, dentista em Ipanema, no consultório"
          width="1280"
          height="650"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>

      <div class="hero-fb-scrim" aria-hidden="true"></div>

      <!-- L1 — fundo de luz com grão (Movimento Silencioso, Fase 1 — 04/09/2026). Só transform; estático no celular. -->
