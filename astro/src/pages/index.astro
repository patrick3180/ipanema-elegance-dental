---
/**
 * HOME "/" — porte fiel de src/pages/Index.tsx (React SPA).
 *
 * Ordem das seções (idêntica ao Index.tsx):
 *  1. Hero full-bleed (Hero.tsx — foto real hero-fb-*)
 *  2. Stats Bar (HomepageStatsBar.tsx — count-up)
 *  3. Sobre (AboutSection.tsx)
 *  4. Diferenciais (DifferentialsSection.tsx)
 *  5. Tratamentos grid 3x3 (ServicesSection.tsx)
 *     + separador visual
 *  6. Tecnologia iTero (TechnologyShowcase.tsx)
 *  7. Depoimentos carousel (TestimonialsCarousel.tsx)
 *  8. Blog preview (BlogPreview.tsx — posts reais do Contentful em build-time)
 *  9. CTA Final (FinalCTA.tsx)
 * 10. Contato (ContactSection.tsx — form → /api/contact)
 *
 * Preload da hero: 2 <link rel="preload"> AVIF com media query (mobile/desktop),
 * copiados de scripts/generate-static-meta.cjs (bloco Sprint 5 da home), injetados
 * via slot "head" do SiteLayout → Base (a prop preloadImage não suporta media query).
 *
 * Schemas: Dentist rico (Index.tsx structuredData) + Dentist compacto com
 * aggregateRating real 5.0/18 (generateDentistSchema de generate-static-meta.cjs)
 * — paridade com produção, onde os dois coexistem (estático + helmet).
 *
 * Tracking: CTAs WhatsApp usam APENAS class js-wa-cta + data-label (handler
 * global do Base.astro). Form de contato replica o fluxo do React
 * (dataLayer + POST /api/contact + gtag conversion + beacon /api/send-gclid).
 */
import { GOOGLE_AGGREGATE_RATING, GOOGLE_REVIEWS_URL } from '../lib/googleBusiness';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getBlogData, postMeta } from '../lib/contentful';

const BASE_URL = 'https://dracarlachristoph.com';
const PHONE = '5521993304045';
const wa = (msg: string) => `https://wa.me/${PHONE}?text=${encodeURIComponent(msg)}`;

// Mensagens pré-preenchidas — copiadas verbatim dos componentes React de origem
const WA_HERO = wa('Olá! Vi o site e gostaria de agendar uma consulta.');
const WA_SOBRE = wa('Olá! Gostaria de agendar uma consulta.');
const WA_TECH = wa('Olá! Gostaria de saber mais sobre a tecnologia iTero Element 5D utilizada na clínica.');
const WA_FINAL = wa('Olá! Vi o site e gostaria de agendar uma consulta com a Dra. Carla.');

// ── Blog preview: 3 posts mais recentes do Contentful (build-time) ──
const { posts, assetMap, entryMap } = await getBlogData();
const blogItems = posts
  .map((p) => postMeta(p, assetMap, entryMap))
  .filter((m) => m.slug.length >= 3 && m.title)
  .sort((a, b) => (b.date || '').localeCompare(a.date || ''))
  .slice(0, 3);
const fmtDate = (d: string) => (d ? new Date(d).toLocaleDateString('pt-BR') : '');
const thumb = (m: any) =>
  m.imageUrl && m.imageUrl.includes('ctfassets.net') ? `${m.imageUrl}?w=400&h=250&fit=fill&fm=webp&q=75` : m.imageUrl;

// ── Dados das seções (copiados verbatim dos componentes React) ──

