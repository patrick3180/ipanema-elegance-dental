      <div class="hero-fb-grain" aria-hidden="true"></div>

      <div class="hero-fb-text">
        <div class="hero-fb-textwrap">
          <div class="hero-fb-copy">
            <p class="hero-fb-eyebrow hero-animate-1">Especialista em Prótese e Implantodontia</p>

            <!-- L2 — cada palavra nasce de uma máscara (overflow hidden); o texto do H1 é o mesmo de antes -->
            <h1 class="hero-fb-h1">
              <span class="w" style="--i:0"><span>Dentista</span></span> <span class="w" style="--i:1"><span>em</span></span> <span class="w" style="--i:2"><span>Ipanema</span></span> <span class="w" style="--i:3"><span>especializada</span></span> <span class="w" style="--i:4"><span>em</span></span> <span class="w" style="--i:5"><span>reabilitação</span></span> <span class="w" style="--i:6"><span>oral</span></span> <span class="w" style="--i:7"><span>e</span></span> <span class="h1-gold"><span class="w" style="--i:8"><span>estética</span></span> <span class="w" style="--i:9"><span>natural</span></span></span>
            </h1>

            <p class="hero-fb-sub hero-animate-3">
              No mínimo uma hora por consulta. Tempo para ouvir, examinar e planejar cada caso.
            </p>

            <div class="hero-fb-badges hero-animate-4">
              <span>20+ anos em Ipanema</span>
              <span>CRO-RJ 27.509</span>
              <span>Do plano à finalização</span>
            </div>

            <div class="hero-fb-actions hero-animate-5">
              <a
                class="hero-fb-cta js-wa-cta"
                data-label="home_hero_whatsapp"
                href={WA_HERO}
                target="_blank"
                rel="noopener"
              >
                <b>Agendar minha consulta</b>
                <small>WhatsApp 24h</small>
              </a>
              <a href="#tratamentos" class="hero-fb-explore" id="hero-explore">Conheça os tratamentos</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 2. STATS BAR (HomepageStatsBar.tsx) ═══ -->
