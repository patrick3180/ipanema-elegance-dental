<!-- Suavizar rolagem de âncoras (paridade com scroll-behavior:smooth do SPA) -->
<style is:global>
  html { scroll-behavior: smooth; scroll-padding-top: 100px; }
</style>

<script>
  // ═══ Interatividade da home — porte vanilla dos comportamentos React ═══
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 1) Explore CTA do hero: dataLayer (paridade com handleExploreClick do Hero.tsx)
  document.getElementById('hero-explore')?.addEventListener('click', () => {
    (window as any).dataLayer = (window as any).dataLayer || [];
    (window as any).dataLayer.push({
      event: 'hero_explore_click',
      event_category: 'Navigation',
      event_action: 'Click',
      event_label: 'Hero Secondary CTA',
    });
  });

  // 2) Stats count-up (porte do useCountUp — easeOutCubic, 1800ms, dispara a 50% visível)
  if (!reducedMotion) {
    document.querySelectorAll<HTMLElement>('.stat-value [data-count]').forEach((el) => {
      const end = Number(el.dataset.count || '0');
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          io.disconnect();
          let startTime: number | null = null;
          const duration = 1800;
          const step = (ts: number) => {
            if (startTime === null) startTime = ts;
            const progress = Math.min((ts - startTime) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            const val = Math.floor(eased * end);
            el.textContent = val >= 1000 ? val.toLocaleString('pt-BR') : String(val);
            if (progress < 1) requestAnimationFrame(step);
          };
          el.textContent = '0';
          requestAnimationFrame(step);
        },
        { threshold: 0.5 }
      );
      io.observe(el);
    });
  }

  // 3) Scroll reveal (porte do ScrollReveal.tsx — threshold por seção via IO único 0.1)
  const srItems = document.querySelectorAll('.sr');
  if (srItems.length) {
    const srIo = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('sr-in');
            srIo.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );
    srItems.forEach((el) => srIo.observe(el));
  }

  // 4) Carousel de depoimentos (porte do TestimonialsCarousel.tsx:
  //    3 visíveis no desktop / 1 no mobile, autoplay 5s, pausa no hover, setas + dots)
  (() => {
    const wrap = document.getElementById('tst-wrap');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.tst-card'));
    const dots = Array.from(document.querySelectorAll<HTMLElement>('.tst-dot'));
    if (!wrap || cards.length === 0) return;

    const N = cards.length;
    let current = 0;
    let autoPlaying = true;
    let timer: ReturnType<typeof setInterval> | null = null;

    function render() {
      cards.forEach((c) => {
        c.classList.add('is-off');
        c.classList.remove('md-only');
        c.style.order = '';
      });
      for (let k = 0; k < 3; k++) {
        const idx = (current + k) % N;
        const c = cards[idx];
        c.classList.remove('is-off');
        c.style.order = String(k);
        if (k > 0) c.classList.add('md-only');
      }
      dots.forEach((d, i) => d.classList.toggle('active', i === current));
    }

    const next = () => { current = (current + 1) % N; render(); };
    const prev = () => { current = (current - 1 + N) % N; render(); };

    function startAuto() {
      if (timer) clearInterval(timer);
      timer = setInterval(() => { if (autoPlaying) next(); }, 5000);
    }

    document.getElementById('tst-next')?.addEventListener('click', next);
    document.getElementById('tst-prev')?.addEventListener('click', prev);
    dots.forEach((d) => d.addEventListener('click', () => { current = Number(d.dataset.dot || '0'); render(); }));
    wrap.addEventListener('mouseenter', () => { autoPlaying = false; });
    wrap.addEventListener('mouseleave', () => { autoPlaying = true; });

    render();
    startAuto();
  })();

  // 5) Form de contato (porte do ContactSection.tsx: validação, dataLayer,
  //    beacon GCLID, POST /api/contact, gtag conversion no sucesso, toasts)
  (() => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('cf-submit') as HTMLButtonElement | null;
    const region = document.getElementById('toast-region');
    if (!form || !submitBtn || !region) return;

    function showToast(title: string, description: string, destructive = false) {
      const t = document.createElement('div');
      t.className = 'toast' + (destructive ? ' destructive' : '');
      t.setAttribute('role', 'status');
      const b = document.createElement('b');
      b.textContent = title;
      const p = document.createElement('span');
      p.textContent = description;
      t.appendChild(b);
      t.appendChild(p);
      region!.appendChild(t);
      setTimeout(() => t.remove(), 5000);
    }

    // Mesmo payload do sendGCLIDToWebhook (proxy /api/send-gclid) usado pelo handler global
    function sendGclidWebhook(label: string) {
      try {
        const gclid = localStorage.getItem('gclid');
        if (!gclid) return;
        // timestamp SEMPRE em ISO (epoch millis quebra o timestamptz na edge fn)
        let ts = localStorage.getItem('gclid_timestamp');
        if (ts && /^\d{10,17}$/.test(ts)) ts = new Date(Number(ts)).toISOString();
        const payload = JSON.stringify({
          gclid,
          timestamp: ts || new Date().toISOString(),
          page: localStorage.getItem('gclid_landing_url') || window.location.pathname,
          label,
        });
        if (navigator.sendBeacon) {
          navigator.sendBeacon('/api/send-gclid', new Blob([payload], { type: 'application/json' }));
        } else {
          fetch('/api/send-gclid', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: payload,
            keepalive: true,
          });
        }
      } catch (e) { /* noop */ }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = (document.getElementById('contact-name') as HTMLInputElement).value.trim();
      const phone = (document.getElementById('contact-phone') as HTMLInputElement).value.trim();
      const email = (document.getElementById('contact-email') as HTMLInputElement).value.trim();
      const message = (document.getElementById('contact-message') as HTMLTextAreaElement).value.trim();

      if (!name || !phone || !email || !message) {
        showToast('Campos obrigatórios', 'Por favor, preencha todos os campos antes de enviar.', true);
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando...';

      (window as any).dataLayer = (window as any).dataLayer || [];
      (window as any).dataLayer.push({
        event: 'contact_form_submit',
        event_category: 'Contact',
        event_action: 'Submit',
        event_label: 'Contact Section Form',
      });

      sendGclidWebhook('contact_form_submit');

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, phone, email, message }),
        });

        if (response.ok) {
          if ((window as any).gtag) {
            (window as any).gtag('event', 'conversion', {
              send_to: 'AW-16894364517/OQZvCMXV0foZEOqP7vY9',
            });
          }
          showToast('Mensagem enviada!', 'Entraremos em contato em breve.');
          form.reset();
        } else {
          const data = await response.json().catch(() => ({} as any));
          showToast('Erro ao enviar', (data as any).error || 'Tente novamente mais tarde.', true);
        }
      } catch {
        showToast('Erro ao enviar', 'Verifique sua conexão e tente novamente.', true);
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Enviar Mensagem';
      }
    });
  })();
</script>
