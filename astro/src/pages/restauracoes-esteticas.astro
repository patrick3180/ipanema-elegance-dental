---
/**
 * /restauracoes-esteticas — porte VERBATIM de src/pages/RestaureacoesEsteticas.tsx.
 * Meta/canonical: scripts/generate-static-meta.cjs ('/restauracoes-esteticas').
 * Schemas: MedicalProcedure + Dentist (generate-static-meta.cjs) +
 * FAQPage (mesmos textos do Helmet do React) + BreadcrumbList (hero).
 */
import { GOOGLE_AGGREGATE_RATING } from '../lib/googleBusiness';
import SiteLayout from '../layouts/SiteLayout.astro';
import TreatmentHero from '../components/treatment/TreatmentHero.astro';
import StatsBar from '../components/treatment/StatsBar.astro';
import SectionDivider from '../components/treatment/SectionDivider.astro';
import ProcessTimeline from '../components/treatment/ProcessTimeline.astro';
import QuickAnswerBox from '../components/treatment/QuickAnswerBox.astro';
import DoctorBioSection from '../components/treatment/DoctorBioSection.astro';
import EmpatheticPainPoints from '../components/treatment/EmpatheticPainPoints.astro';
import ServiceFAQ from '../components/treatment/ServiceFAQ.astro';
import FinalServiceCTA from '../components/treatment/FinalServiceCTA.astro';
import RelatedTreatments from '../components/treatment/RelatedTreatments.astro';
import Icon from '../components/treatment/Icon.astro';
import '../styles/treatment.css';

// FAQs exibidas na página (copy verbatim do .tsx — respostas com HTML preservam listas/links)
const faqs = [
  { question: 'O que é uma restauração dental estética?', answer: 'É um procedimento que reconstrói dentes comprometidos por cáries, fraturas ou trincas utilizando materiais de última geração (resina composta ou porcelana) que mimetizam perfeitamente a cor, brilho e textura dos dentes naturais. Diferente das antigas "obturações" escuras de amálgama, as restaurações estéticas são praticamente invisíveis.' },
  { question: 'Quando uma restauração é necessária?', html: true, answer: '<p class="mb-3">Restaurações são indicadas em diversas situações:</p><ul class="sfaq-ul"><li>Presença de cáries (pequenas, médias ou extensas)</li><li>Fraturas dentais por trauma ou desgaste</li><li>Trincas que causam sensibilidade</li><li>Substituição de restaurações antigas escurecidas</li><li>Correção de formato ou fechamento de pequenos espaços</li><li>Reconstrução após <a href="/tratamento-de-canal" class="sfaq-link">tratamento de canal</a></li></ul>' },
  { question: 'Qual material é usado nas restaurações estéticas?', answer: 'Utilizamos resinas compostas de última geração com nanotecnologia, que oferecem alta resistência, estética natural e durabilidade. Para casos que exigem máxima longevidade (grandes restaurações posteriores), indicamos porcelanas ou resinas laboratoriais (inlay/onlay), que são confeccionadas em laboratório e proporcionam ainda mais resistência.' },
  { question: 'Fazer restauração dói?', answer: 'Não. Utilizamos anestesia local com técnica confortável. A maioria dos pacientes relata não sentir desconforto durante o procedimento. Após o término do efeito anestésico, pode haver sensibilidade leve por 24-48h, facilmente controlada com analgésicos comuns se necessário.' },
  { question: 'Quanto tempo dura uma restauração estética?', html: true, answer: 'A durabilidade varia conforme o tipo de restauração e cuidados do paciente:<ul class="sfaq-ul mt-3"><li><strong>Restaurações diretas (resina):</strong> 5 a 8 anos em média</li><li><strong>Restaurações indiretas (inlay/onlay de porcelana):</strong> 12 a 15 anos ou mais</li></ul><p class="mt-3">Fatores que prolongam a vida útil: boa higiene oral, check-ups regulares, não roer unhas, evitar abrir embalagens com os dentes e usar placa para bruxismo quando indicado.</p>' },
  { question: 'Posso trocar minhas restaurações antigas escuras?', answer: 'Sim! A substituição de restaurações antigas de amálgama (metálicas) por restaurações estéticas em resina é um dos procedimentos mais procurados. Além do benefício estético, eliminamos o risco de microinfiltrações comuns em restaurações antigas e removemos o metal da boca. A troca é feita de forma conservadora, preservando o máximo de estrutura dental sadia.' },
  { question: 'Restauração em resina mancha com o tempo?', answer: 'As resinas compostas modernas apresentam excelente estabilidade de cor. Com os cuidados adequados (boa higiene, polimentos periódicos no dentista e moderação no consumo de alimentos muito pigmentados como café, vinho tinto e açaí), as restaurações mantêm sua cor original por muitos anos. Quando necessário, é possível fazer polimento profissional para renovar o brilho.' },
  { question: 'Qual a diferença entre restauração e obturação?', answer: 'Na prática odontológica moderna, os termos são sinônimos — ambos se referem ao preenchimento de uma cavidade dental. "Obturação" é um termo mais antigo, frequentemente associado às restaurações em amálgama (metálicas). "Restauração" é o termo técnico correto e mais abrangente, pois enfatiza o objetivo do tratamento: restaurar forma, função e estética. Hoje, priorizamos sempre restaurações estéticas em materiais tooth-colored (da cor do dente).' },
];

const PROVIDER = {
  '@type': 'Dentist',
  name: 'Dra. Carla Christoph',
  telephone: '+5521993304045',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Rua Visconde de Pirajá, 550 - Sala 1107',
    addressLocality: 'Ipanema',
    addressRegion: 'RJ',
    postalCode: '22410-901',
    addressCountry: 'BR',
  },
};

// FAQPage — mesmos textos do Helmet do React (versões em texto puro)
const faqSchemaEntries = [
  { q: 'O que é uma restauração dental estética?', a: 'É um procedimento que reconstrói dentes comprometidos por cáries, fraturas ou trincas utilizando materiais de última geração (resina composta ou porcelana) que mimetizam perfeitamente a cor, brilho e textura dos dentes naturais. Diferente das antigas obturações escuras de amálgama, as restaurações estéticas são praticamente invisíveis.' },
  { q: 'Quando uma restauração é necessária?', a: 'Restaurações são indicadas em diversas situações: presença de cáries, fraturas dentais por trauma ou desgaste, trincas que causam sensibilidade, substituição de restaurações antigas escurecidas, correção de formato ou fechamento de pequenos espaços, e reconstrução após tratamento de canal.' },
  { q: 'Qual material é usado nas restaurações estéticas?', a: 'Utilizamos resinas compostas de última geração com nanotecnologia, que oferecem alta resistência, estética natural e durabilidade. Para casos que exigem máxima longevidade, indicamos porcelanas ou resinas laboratoriais (inlay/onlay), confeccionadas em laboratório para ainda mais resistência.' },
  { q: 'Fazer restauração dói?', a: 'Não. Utilizamos anestesia local com técnica confortável. A maioria dos pacientes relata não sentir desconforto durante o procedimento. Após o término do efeito anestésico, pode haver sensibilidade leve por 24-48h, facilmente controlada com analgésicos comuns.' },
  { q: 'Quanto tempo dura uma restauração estética?', a: 'Restaurações diretas em resina duram de 5 a 8 anos em média. Restaurações indiretas (inlay/onlay de porcelana) duram 12 a 15 anos ou mais. Fatores que prolongam a vida útil: boa higiene oral, check-ups regulares e uso de placa para bruxismo quando indicado.' },
  { q: 'Posso trocar minhas restaurações antigas escuras?', a: 'Sim! A substituição de restaurações antigas de amálgama por restaurações estéticas em resina é um dos procedimentos mais procurados. Além do benefício estético, eliminamos o risco de microinfiltrações comuns em restaurações antigas. A troca é feita de forma conservadora, preservando o máximo de estrutura dental sadia.' },
  { q: 'Restauração em resina mancha com o tempo?', a: 'As resinas compostas modernas apresentam excelente estabilidade de cor. Com cuidados adequados (boa higiene, polimentos periódicos e moderação no consumo de alimentos muito pigmentados como café, vinho tinto e açaí), as restaurações mantêm sua cor original por muitos anos.' },
  { q: 'Qual a diferença entre restauração e obturação?', a: 'Na prática odontológica moderna, os termos são sinônimos — ambos se referem ao preenchimento de uma cavidade dental. Obturação é um termo mais antigo, frequentemente associado às restaurações em amálgama. Restauração é o termo técnico correto e mais abrangente. Hoje, priorizamos sempre restaurações estéticas em materiais da cor do dente.' },
];

const schemas = [
  // MedicalProcedure — copiado de generate-static-meta.cjs ('/restauracoes-esteticas')
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'MedicalProcedure',
    name: 'Restauração Dental Estética',
    description: 'Restauração dental estética com resina nanoparticulada para tratamento de cáries, fraturas e trincas com resultado natural',
    procedureType: 'Dental',
    url: 'https://dracarlachristoph.com/restauracoes-esteticas',
    provider: PROVIDER,
  }),
  // Dentist — generateDentistSchema() de generate-static-meta.cjs
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Dentist',
    name: 'Dra. Carla Christoph',
    description: 'Dentista especialista em Prótese Dental e Reabilitação Oral em Ipanema, Rio de Janeiro. Mais de 20 anos de experiência.',
    telephone: '+5521993304045',
    url: 'https://dracarlachristoph.com',
    image: 'https://dracarlachristoph.com/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp',
    priceRange: '$$$',
    address: PROVIDER.address,
    openingHoursSpecification: [
      { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '19:00' },
    ],
    hasCredential: { '@type': 'EducationalOccupationalCredential', credentialCategory: 'CRO-RJ', recognizedBy: { '@type': 'Organization', name: 'CRO-RJ' }, identifier: '27.509' },
    aggregateRating: GOOGLE_AGGREGATE_RATING,
    availableLanguage: ['pt-BR', 'en'],
  }),
  // FAQPage — textos do Helmet do React
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqSchemaEntries.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    })),
  }),
];

// Dados das seções (copy verbatim do .tsx)
const cardDireta = {
  img: '/lovable-uploads/Restauracao direta.webp',
  alt: 'Restauração Direta em Resina Composta',
  title: 'Restauração Direta em Resina',
  overlay: 'Realizada em uma única sessão no consultório',
  body: 'Realizada em uma única sessão, onde a resina nanoparticulada é aplicada e esculpida diretamente no dente comprometido.',
  indicacoes: ['Cáries pequenas a médias', 'Fraturas de pequena extensão', 'Trincas superficiais', 'Fechamento de pequenos espaços (diastemas)', 'Correção de formato'],
  caracteristicas: [
    { label: 'Confecção:', value: 'Consultório (1 sessão)' },
    { label: 'Tempo:', value: '40-90 minutos por dente' },
    { label: 'Durabilidade:', value: '5-8 anos' },
    { label: 'Investimento:', value: 'Mais acessível' },
    { label: 'Preparo:', value: 'Mínimo conservador' },
  ],
};
const cardIndireta = {
  img: '/lovable-uploads/inlay de porcelana.webp',
  alt: 'Restauração Indireta - Inlay e Onlay de Porcelana',
  title: 'Restauração Indireta (Inlay/Onlay)',
  overlay: 'Confeccionada em laboratório especializado',
  body: 'Confeccionada em laboratório e cimentada em segunda sessão, oferecendo maior resistência e longevidade.',
  indicacoes: ['Cáries extensas', 'Grande perda estrutural', 'Fraturas amplas em dentes posteriores', 'Substituição de grandes restaurações antigas', 'Necessidade de máxima durabilidade'],
  caracteristicas: [
    { label: 'Confecção:', value: 'Laboratório (2 sessões)' },
    { label: 'Material:', value: 'Porcelana ou resina laboratorial' },
    { label: 'Durabilidade:', value: '12-15 anos' },
    { label: 'Investimento:', value: 'Mais significativo' },
    { label: 'Precisão:', value: 'Adaptação milimétrica' },
  ],
};

const beneficios = [
  { icon: 'sparkles', iconClass: 're-ic-purple', bg: 're-bg-purple-50', title: 'Estética Superior', text: 'Cor e brilho idênticos aos dentes naturais. Resultado praticamente invisível.' },
  { icon: 'shield', iconClass: 're-ic-green', bg: 're-bg-green-50', title: 'Preservação Dental', text: 'Técnica conservadora que mantém o máximo de estrutura sadia do dente.' },
  { icon: 'link', iconClass: 're-ic-blue', bg: 're-bg-blue-50', title: 'Adesão Química', text: 'União química ao dente proporcionando selamento eficaz contra infiltrações.' },
  { icon: 'ban', iconClass: 're-ic-red', bg: 're-bg-red-50', title: 'Ausência de Metais', text: 'Zero mercúrio ou metais. Material biocompatível e seguro para sua saúde.' },
  { icon: 'target', iconClass: 're-ic-gold', bg: 're-bg-yellow-50', title: 'Versatilidade', text: 'Aplicável em dentes anteriores e posteriores, adaptando-se a cada situação.' },
  { icon: 'wrench', iconClass: 're-ic-orange', bg: 're-bg-orange-50', title: 'Reparo Facilitado', text: 'Possibilidade de ajustes e reparos sem necessidade de trocar toda a restauração.' },
  { icon: 'clock', iconClass: 're-ic-indigo', bg: 're-bg-indigo-50', title: 'Durabilidade Comprovada', text: 'Materiais de alta resistência que proporcionam longevidade ao tratamento.', center: true },
];

const diferenciais = [
  { icon: 'heart-pulse', iconClass: 're-ic-red', bg: 're-bg-red-50', title: 'Protocolo Saúde Primeiro', text: 'Tratamento de inflamações gengivais e controle de cáries ativas antes de qualquer restauração estética.' },
  { icon: 'award', iconClass: 're-ic-gold', bg: 're-bg-yellow-50', title: 'Materiais Certificados', text: 'Resinas compostas com certificação internacional, nanotecnologia e ampla paleta de cores para mimetização perfeita.' },
  { icon: 'layers', iconClass: 're-ic-purple', bg: 're-bg-purple-50', title: 'Técnica de Estratificação', text: 'Aplicação em múltiplas camadas com diferentes graus de opacidade e translucidez, imitando a estrutura natural do dente.' },
  { icon: 'focus', iconClass: 're-ic-blue', bg: 're-bg-blue-50', title: 'Análise Oclusal Detalhada', text: 'Verificação da distribuição correta das forças mastigatórias para evitar sobrecarga e garantir longevidade.' },
  { icon: 'gem', iconClass: 're-ic-pink', bg: 're-bg-pink-50', title: 'Acabamento de Alto Brilho', text: 'Polimento de alta performance que confere brilho vítreo e textura que imitam perfeitamente o esmalte dental natural.' },
  { icon: 'shield', iconClass: 're-ic-green', bg: 're-bg-green-50', title: 'Protocolo para Bruxismo', text: 'Confecção de placa miorrelaxante quando necessário para proteger as restaurações e prevenir desgastes precoces.' },
];

const iteroFeatures = [
  { icon: 'search', iconClass: 're-ic-purple', bg: 're-bg-purple-50', title: 'Detecção Precoce de Cáries', text: 'Identificação de lesões invisíveis a olho nu, permitindo tratamento preventivo.' },
  { icon: 'shield', iconClass: 're-ic-blue', bg: 're-bg-blue-50', title: 'Análise de Desgastes', text: 'Mapeamento de áreas de atrito excessivo por bruxismo ou má oclusão.' },
  { icon: 'sparkles', iconClass: 're-ic-green', bg: 're-bg-green-50', title: 'Moldagem Digital', text: 'Captura 3D sem desconforto, náuseas ou materiais de moldagem tradicionais.' },
  { icon: 'award', iconClass: 're-ic-gold', bg: 're-bg-yellow-50', title: 'Comunicação Visual', text: 'Visualização em tempo real na tela, facilitando compreensão do diagnóstico e plano de tratamento.' },
];

const comoEscolher = ['Extensão do dano', 'Localização (anterior/posterior)', 'Forças mastigatórias', 'Estrutura dental remanescente', 'Objetivos estéticos', 'Investimento disponível'];
---

<SiteLayout
  title="Restaurações Estéticas em Ipanema | Dra. Carla Christoph"
  description="Restauração dental estética em Ipanema com resina nanoparticulada. Tratamento de cáries, dentes quebrados e trincados. Resultado natural e duradouro. Dra. Carla Christoph CRO-RJ 27.509."
  canonical="https://dracarlachristoph.com/restauracoes-esteticas"
  preloadImage="/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp"
  schemas={schemas}
>
  <main id="main-content">
    <TreatmentHero
      title="Restaurações Estéticas em Ipanema"
      subtitle="Beleza e Função para seu Sorriso"
      description="Recupere dentes comprometidos por cáries, fraturas ou trincas com resinas compostas de última geração que imitam perfeitamente a cor e textura natural."
      badges={['Resinas de Alta Performance', 'Resultado Natural', 'Técnica Conservadora']}
      doctorImage="/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp"
      breadcrumbs={[
        { label: 'Início', href: '/' },
        { label: 'Tratamentos', href: '/servicos' },
        { label: 'Restaurações Estéticas' },
      ]}
      waLabel="restauracoes-esteticas_hero_whatsapp"
    />

    <section class="qa-section">
      <div class="container-custom">
        <QuickAnswerBox answer="Restaurações estéticas são tratamentos que recuperam dentes comprometidos por cáries, fraturas ou trincas usando resinas nanoparticuladas ou cerâmicas de última geração. Na clínica da Dra. Carla Christoph em Ipanema (CRO-RJ 27.509), utilizamos materiais de última geração com estratificação de cor que reproduzem perfeitamente a translucidez natural dos dentes. O tratamento é conservador, preservando ao máximo a estrutura dentária, e o resultado é indistinguível dos dentes naturais. Com 20+ anos de experiência, realizamos desde pequenas restaurações até reconstruções complexas em uma ou poucas sessões." />
      </div>
    </section>

    <EmpatheticPainPoints
      title="Você já escondeu o sorriso por causa de um dente comprometido?"
      painPoints={[
        { icon: 'gem', iconColor: 'purple', strong: 'Restaurações que passam despercebidas', description: 'Usamos resinas e cerâmicas estratificadas que reproduzem a translucidez e textura natural do seu dente — não são obturações, são reconstruções.', borderColor: 'purple' },
        { icon: 'shield', iconColor: 'gold', strong: 'Técnica conservadora — preservamos o máximo', description: 'Cada restauração é planejada para remover apenas o necessário. Quanto mais estrutura natural preservada, melhor o resultado a longo prazo.', borderColor: 'gold' },
        { icon: 'heart', iconColor: 'purple-soft', strong: 'Cada caso planejado individualmente', description: 'A Dra. Carla reserva tempo para entender seu histórico antes de qualquer procedimento — sem pressa, sem protocolo padrão.', borderColor: 'purple-soft' },
      ]}
    >
      <Fragment slot="conclusion">Cáries, fraturas e trincas são mais comuns do que imagina — e o impacto vai além da estética.<br class="md-only" /> Vamos encontrar a melhor solução para o seu caso.</Fragment>
    </EmpatheticPainPoints>

    <SectionDivider variant="with-icon" icon="award" />

    <DoctorBioSection
      sectionTitle="Restaurações com Precisão Técnica e Arte"
      badgeText="20+ Anos de Experiência"
      credentials={[
        { title: 'Formação', description: 'Especialista em Prótese Dentária e Implantodontia' },
        { title: 'Experiência', description: '20+ anos tratando casos de todas as complexidades' },
        { title: 'Atualização', description: 'Formação contínua em técnicas avançadas' },
        { title: 'Tecnologia', description: 'Scanner intraoral iTero Element 5D' },
      ]}
    >
      <p>Com mais de duas décadas em Ipanema, a Dra. Carla construiu sua reputação tratando cada paciente de forma individual, com tempo e atenção. Sua formação inclui 8 anos como dentista militar na Odontoclínica Central da Marinha, experiência que trouxe disciplina e precisão para sua prática clínica.</p>
      <p>Nas restaurações, utiliza resinas e cerâmicas que reproduzem a translucidez natural do dente. O objetivo é que a restauração passe despercebida — que o dente tratado seja indistinguível dos demais.</p>
    </DoctorBioSection>

    <SectionDivider variant="with-icon" icon="shield" />

    <!-- Modalidades: Direta vs Indireta -->
    <section class="sec-white">
      <div class="re-wrap">
        <div class="re-head">
          <h2 class="re-h2">Restauração Direta ou Indireta: Qual é a Ideal para Você?</h2>
          <p class="re-sub">Cada técnica tem suas indicações específicas. A escolha depende da extensão do dano, localização do dente e objetivos do tratamento.</p>
        </div>

        <div class="re-cards-grid">
          {[cardDireta, cardIndireta].map((card) => (
            <div class="re-card shadow-soft">
              <div class="re-card-img">
                <img src={card.img} alt={card.alt} width="600" height="400" loading="lazy" decoding="async" />
                <div class="re-card-overlay"></div>
                <div class="re-card-caption">
                  <h3>{card.title}</h3>
                  <p>{card.overlay}</p>
                </div>
              </div>
              <div class="re-card-body">
                <p class="re-card-text">{card.body}</p>
                <div class="re-indicacoes">
                  <h4>Indicações:</h4>
                  <ul>
                    {card.indicacoes.map((item) => (
                      <li>
                        <Icon name="check-circle" size={20} class="tx-gold re-check" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <details class="re-acc">
                  <summary class="re-acc-q">
                    <span>Ver Características Detalhadas</span>
                    <svg class="re-acc-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                  </summary>
                  <div class="re-acc-a">
                    {card.caracteristicas.map((row) => (
                      <div class="re-acc-row">
                        <span class="re-acc-label">{row.label}</span>
                        <span class="re-acc-value">{row.value}</span>
                      </div>
                    ))}
                  </div>
                </details>
              </div>
            </div>
          ))}
        </div>

        <!-- Box informativo -->
        <div class="re-choose">
          <div class="re-choose-row">
            <div class="re-choose-icon">
              <Icon name="help-circle" size={24} class="tx-gold" />
            </div>
            <div>
              <h4 class="re-choose-title">Como Escolher?</h4>
              <p class="re-choose-text">A escolha não é "melhor ou pior", mas <span class="re-choose-em">indicação técnica</span>. Analisamos:</p>
              <div class="re-choose-grid">
                {comoEscolher.map((item) => (
                  <div class="re-choose-item">
                    <Icon name="check-circle" size={20} class="tx-gold re-check" />
                    <span>{item}</span>
                  </div>
                ))}
              </div>
              <p class="re-choose-final">Prioridade: preservar o máximo de estrutura dental sadia e oferecer a solução mais duradoura para seu caso.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <SectionDivider variant="with-icon" icon="heart" />

    <!-- Benefícios -->
    <section class="re-sec-beige">
      <div class="re-wrap">
        <div class="re-head">
          <h2 class="re-h2">Vantagens das Restaurações Estéticas</h2>
          <p class="re-sub">Tecnologia e materiais de última geração para resultados naturais e duradouros</p>
        </div>
        <div class="re-benef-grid">
          {beneficios.map((b) => (
            <div class:list={['re-benef-card', 'shadow-soft', { 're-benef-center': b.center }]}>
              <div class:list={['re-benef-icon', b.bg]}>
                <Icon name={b.icon} size={28} class={b.iconClass} />
              </div>
              <h3 class="re-card-title">{b.title}</h3>
              <p class="re-card-p">{b.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SectionDivider variant="with-icon" icon="search" />

    <!-- Processo -->
    <section class="sec-white">
      <div class="re-wrap">
        <div class="re-head">
          <h2 class="re-h2">Seu Tratamento: Passo a Passo</h2>
          <p class="re-sub">Processo estruturado para buscar o melhor resultado com muito conforto</p>
        </div>
        <ProcessTimeline
          steps={[
