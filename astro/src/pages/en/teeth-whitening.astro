---
/**
 * /en/teeth-whitening — porte fiel de src/pages/en/EnTeethWhiteningPage.tsx.
 * Copy VERBATIM. Layout: SiteLayout lang="en" (EnSiteHeader/EnSiteFooter).
 * CTAs WhatsApp = âncoras .js-wa-cta (handler global do Base.astro).
 */
import SiteLayout from '../../layouts/SiteLayout.astro';

// ── Lucide icon paths (inline SVG) ──
const P: Record<string, string> = {
  sparkles: '<path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/>',
  checkCircle: '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>',
  checkCircle2: '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>',
  star: '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>',
  arrowRight: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  award: '<circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>',
  search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  helpCircle: '<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>',
  droplet: '<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>',
  alertCircle: '<circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/>',
  calendar: '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  chevronDown: '<path d="m6 9 6 6 6-6"/>',
  chevronRight: '<path d="m9 18 6-6-6-6"/>',
  fileText: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><line x1="10" x2="8" y1="9" y2="9"/>',
  scan: '<path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/>',
  zap: '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>',
  heart: '<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>',
};
const ic = (name: string, cls = '', size = 24) =>
  `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="${cls}" aria-hidden="true">${P[name]}</svg>`;

// ── FAQs (10 — verbatim do React) ──
const faqs = [
  { question: "What's the difference between the whitening modalities?", answer: "In-office whitening uses a high-concentration gel (35-37%), producing results in 1-3 sessions. At-home whitening uses a lower concentration (10-20%), applied gradually over 14-21 days with custom trays. The combined approach starts in the office and maintains results with at-home applications. The recommendation depends on individual assessment." },
  { question: "Does whitening cause sensitivity?", answer: "Temporary sensitivity may occur, but modern protocols minimize this discomfort. We use desensitizing agents, adjust concentrations as needed, and apply therapeutic laser when indicated. Most patients report little to no discomfort." },
  { question: "How long do results last?", answer: "With proper care, results last 2-3 years. Longevity varies depending on dietary habits and hygiene. A maintenance protocol with annual touch-up sessions significantly extends results." },
  { question: "Can I whiten my teeth if I have restorations?", answer: "Yes, but only natural teeth respond to whitening. Restorations and prostheses retain their original color. We analyze your case to determine the best strategy, considering whether visible restorations need replacement afterward." },
  { question: "Is whitening safe for enamel?", answer: "When performed with proper protocols, it does not damage enamel. Modern gels have balanced pH and do not cause demineralization. We use products with remineralizing agents that preserve dental integrity." },
  { question: "What care should I take after whitening?", answer: "In the first 48 hours, avoid pigmented foods and beverages. Maintain proper oral hygiene with brushing after meals. Use straws for dark drinks. Semi-annual visits for professional maintenance." },
  { question: "Does whitening work on all types of stains?", answer: "Effectiveness varies by stain type. Stains from food and aging respond very well. Medication-related stains have variable results. During the evaluation, we analyze your specific case and establish realistic expectations." },
  { question: "Is whitening the same as dental cleaning?", answer: "No. Cleaning removes tartar and surface stains, restoring the natural color. Whitening chemically alters the internal tooth color, lightening beyond the natural shade. We frequently perform cleaning before whitening to optimize results." },
  { question: "Do pharmacy products have the same effect?", answer: "Over-the-counter products contain very low concentrations due to regulations, offering limited results. Professional whitening uses therapeutic concentrations under supervision, ensuring superior effectiveness and safety." },
  { question: "How is the whitening modality chosen?", answer: "During the evaluation consultation, I analyze your individual characteristics, stain type, prior sensitivity, routine, and expectations. The recommendation considers all these factors to define the most suitable protocol for your case." },
];

// ── Comparison table — espelho fiel do render do ComparisonTable React:
// a 1ª linha do array vira o HEADER ("35-37%" / "10-20%"); a coluna C não é renderizada.
const cmpHeadA = '35-37%';
const cmpHeadB = '10-20%';
const cmpRows = [
  ['Treatment Time', '1-3 sessions', '14-21 days'],
  ['Expected Whitening', '4-9 shades', '2-6 shades'],
  ['Sensitivity', 'Moderate', 'Low'],
  ['Supervision', 'In-person', 'Remote'],
  ['Longevity', '2-3 years', '2-3 years'],
];

// ── Schemas (verbatim do SEOHead React) ──
const schemas = [
  JSON.stringify({
    "@context": "https://schema.org", "@type": "MedicalProcedure",
    "name": "Professional Teeth Whitening", "description": "Teeth whitening procedure with in-office and supervised at-home techniques",
    "procedureType": "Dental", "inLanguage": "en",
    "provider": { "@type": "Dentist", "name": "Dr. Carla Christoph", "telephone": "+5521993304045",
      "address": { "@type": "PostalAddress", "streetAddress": "Rua Visconde de Pirajá, 550 - Suite 1107", "addressLocality": "Ipanema", "addressRegion": "RJ", "postalCode": "22410-901", "addressCountry": "BR" }
    }
  }),
  JSON.stringify({
    "@context": "https://schema.org", "@type": "FAQPage", "inLanguage": "en",
    "mainEntity": faqs.map((faq) => ({ "@type": "Question", "name": faq.question, "acceptedAnswer": { "@type": "Answer", "text": faq.answer } }))
  }),
  JSON.stringify({
    "@context": "https://schema.org", "@type": "WebPage",
    "name": "Professional Teeth Whitening in Ipanema",
    "url": "https://dracarlachristoph.com/en/teeth-whitening",
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".treatment-hero-title", ".treatment-hero-description", ".quick-answer-box"] },
    "inLanguage": "en"
  }),
  // BreadcrumbList — gerado pelo TreatmentHero no React
  JSON.stringify({
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dracarlachristoph.com/en" },
      { "@type": "ListItem", "position": 2, "name": "Treatments", "item": "https://dracarlachristoph.com/en" },
      { "@type": "ListItem", "position": 3, "name": "Teeth Whitening" }
    ]
  }),
];

// ── WhatsApp CTAs (mensagens verbatim do React) ──
const WA = 'https://wa.me/5521993304045?text=';
const waHero = WA + encodeURIComponent('Hello! I would like to schedule a consultation about Professional Teeth Whitening.');
const waMid = WA + encodeURIComponent("Hello! I'd like to know which whitening modality is most suitable for my case.");
const waFinal = WA + encodeURIComponent("Hello! I'd like to schedule a teeth whitening evaluation with Dr. Carla Christoph.");

// ── Timeline (verbatim) ──
const timelineSteps = [
  { number: '1', icon: 'search', title: 'Initial Evaluation', description: 'Clinical exam, oral health analysis, and photographic documentation of the initial shade. Identification of stain type and treatment viability.', duration: '1st Visit' },
  { number: '2', icon: 'fileText', title: 'Planning', description: 'Technique selection based on your individual characteristics. Detailed explanation of the process and expectation setting.', duration: '1st Visit' },
  { number: '3', icon: 'sparkles', title: 'Preparation', description: 'Prophylaxis to remove surface stains. Treatment of cavities or gum issues when identified.', duration: 'If needed' },
  { number: '4', icon: 'scan', title: 'Tray Fabrication (At-Home)', description: 'Impression-taking and fabrication of custom trays for at-home whitening. The entire process is completed at the first visit, with precise fitting for even gel distribution and gum protection.', duration: '1st Visit' },
  { number: '5', icon: 'zap', title: 'Application', description: 'In-office: Gum protection and supervised application. At-home: Detailed guidance on proper tray use.', duration: 'Per protocol' },
  { number: '6', icon: 'heart', title: 'Follow-Up', description: 'Progress evaluation and adjustments when needed. Sensitivity management with specific protocols.', duration: 'During treatment' },
  { number: '7', icon: 'checkCircle', title: 'Completion', description: 'Final photographic documentation and personalized maintenance instructions to preserve results.', duration: 'Final visit' },
];

// ── Cards de modalidades (verbatim) ──
const modalityCards = [
  {
    img: '/lovable-uploads/Clareamento_de_consultorio.webp',
    alt: '3D model showing in-office teeth whitening procedure',
    accName: 'wh-office',
    title: 'In-Office Whitening',
    caption: 'High-concentration whitening gel applied in 60-90 minute sessions. Visible results from the very first application.',
    features: [
      ['Concentration:', '35-37% hydrogen peroxide'],
      ['Sessions:', '1 to 3 appointments'],
      ['Whitening:', '4-9 shades'],
      ['Longevity:', '2-3 years with proper care'],
    ],
    advantages: ['Results in just a few sessions', 'Constant professional supervision', 'Precise control of the process', 'Gum isolation to prevent irritation'],
    considerations: ['Temporary sensitivity possible', 'Requires availability for appointments'],
    ideal: 'Cases requiring results in a short timeframe, more resistant stains, or patients who prefer constant in-person supervision.',
  },
  {
    img: '/lovable-uploads/Clareamento_caseiro.webp',
    alt: '3D model showing custom whitening trays for at-home use',
    accName: 'wh-home',
    title: 'Supervised At-Home Whitening',
    caption: 'Custom trays made at the office. Lower-concentration gel for daily at-home application with professional follow-up.',
    features: [
      ['Concentration:', '10-20% carbamide peroxide'],
      ['Trays:', 'Custom-made and anatomical'],
      ['Application:', '14 to 21 days'],
      ['Whitening:', '2-6 shades'],
      ['Longevity:', '2-3 years with proper care'],
    ],
    advantages: ['Applied from the comfort of home', 'Flexible schedule', 'Less sensitivity', 'Gradual and controlled'],
    considerations: ['Requires discipline in application'],
    ideal: 'Those who prefer a gradual treatment, have a flexible routine, and value comfort during the process.',
  },
  {
    img: '/lovable-uploads/Clareamento_combinado.webp',
    alt: '3D model showing before and after teeth whitening result',
    accName: 'wh-combo',
    title: 'Combined Treatment',
    caption: 'Starts in the office followed by at-home maintenance. Combines a more evident initial result with gradual stabilization.',
    features: [
      ['Protocol:', 'In-office + at-home sequential'],
      ['Total time:', 'Variable by case'],
      ['Whitening:', '6-9 shades'],
      ['Longevity:', '3+ years with maintenance protocol'],
    ],
    advantages: ['More evident initial result', 'Gradual stabilization', 'Greater longevity', 'Complete protocol'],
    considerations: ['Higher investment'],
    ideal: 'Cases of more pronounced darkening, persistent stains, or when longer-lasting results are desired.',
  },
];
---

<SiteLayout
  title="Teeth Whitening in Ipanema, Rio — English-Speaking Dentist"
  description="Teeth whitening minutes from Copacabana and Leblon, in Ipanema. In-office, at-home, and combined protocols. English-speaking dentist, CRO-RJ 27.509."
  canonical="https://dracarlachristoph.com/en/teeth-whitening"
  ogImage="https://dracarlachristoph.com/og-image.jpg"
  preloadImage="/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp"
  schemas={schemas}
  lang="en"
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="pt-BR" href="https://dracarlachristoph.com/clareamento-dental" />
    <link rel="alternate" hreflang="en" href="https://dracarlachristoph.com/en/teeth-whitening" />
    <link rel="alternate" hreflang="x-default" href="https://dracarlachristoph.com/clareamento-dental" />
  </Fragment>

  <main id="main-content">
    <!-- ═══ Hero ═══ -->
    <section class="t-hero" aria-label="Treatment hero">
      <div class="content-c">
        <div class="hero-grid">
          <div class="hero-content">
            <nav class="crumbs" aria-label="Breadcrumb">
              <a href="/en">Home</a>
              <Fragment set:html={ic('chevronRight', 'crumb-sep', 14)} />
              <a href="/en">Treatments</a>
              <Fragment set:html={ic('chevronRight', 'crumb-sep', 14)} />
              <span class="crumb-cur">Teeth Whitening</span>
            </nav>
            <h1 class="hero-title treatment-hero-title">Professional Teeth Whitening</h1>
            <p class="hero-sub">Cosmetic Dentistry with Dr. Carla Christoph</p>
            <p class="hero-desc treatment-hero-description">In-office and supervised at-home techniques with personalized protocols that prioritize your safety and comfort. Individualized care at every step of the treatment. Over 20 years of experience in cosmetic dentistry.</p>
            <div class="hero-badges">
              <span class="badge">20+ years of experience</span>
              <span class="badge">Personalized protocols</span>
              <span class="badge">CRO-RJ 27.509</span>
            </div>
            <div class="hero-cta-wrap">
              <a class="btn-hero js-wa-cta" data-label="en-teeth-whitening_hero_whatsapp" href={waHero} target="_blank" rel="noopener" aria-label="Schedule consultation via WhatsApp">
                <Fragment set:html={ic('calendar', 'mr8', 20)} />
                Book Your Consultation
              </a>
            </div>
          </div>
          <div class="hero-img">
            <div class="hero-img-frame">
              <img src="/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp" alt="Dr. Carla Christoph - Professional Teeth Whitening Specialist" width="800" height="1200" loading="eager" fetchpriority="high" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ Quick Answer ═══ -->
    <section class="qa-section">
      <div class="container-c">
        <div class="qa-box quick-answer-box">
          <div class="qa-ic"><Fragment set:html={ic('checkCircle2', 'gold', 24)} /></div>
          <div>
            <h2 class="qa-title">Quick Answer</h2>
            <p class="qa-text">Teeth whitening is a cosmetic procedure that lightens teeth using peroxide-based gel. At Dr. Carla Christoph's practice in Ipanema, we offer in-office techniques (1-3 sessions of 60-90 minutes) and supervised at-home whitening. With over 20 years of experience (CRO-RJ 27.509), we work with personalized protocols that lighten 4 to 9 shades safely, preserving the health of teeth and gums. Treatment lasts 7 to 21 days depending on the chosen modality.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ Empathetic Pain Points ═══ -->
    <section class="pain-section">
      <div class="narrow-c">
        <h2 class="pain-title">Does your smile need a whitening boost?</h2>
        <div class="pain-list">
          <div class="pain-card b-purple">
            <div class="pain-ic"><Fragment set:html={ic('sparkles', 'purple', 24)} /></div>
            <div>
              <strong>Do you avoid smiling in photos</strong>
              <span>because you feel your teeth are yellowed or darker than you'd like?</span>
            </div>
          </div>
          <div class="pain-card b-gold">
            <div class="pain-ic"><Fragment set:html={ic('droplet', 'gold', 24)} /></div>
            <div>
              <strong>Have you tried "whitening" toothpastes from the store</strong>
              <span>and saw no results or experienced sensitivity with no real improvement?</span>
            </div>
          </div>
          <div class="pain-card b-purple-soft">
            <div class="pain-ic"><Fragment set:html={ic('alertCircle', 'purple-soft', 24)} /></div>
            <div>
              <strong>Want real, safe results</strong>
              <span>with professional supervision and without risking your enamel health?</span>
            </div>
          </div>
        </div>
        <p class="pain-conclusion">Professional whitening uses therapeutic concentrations under supervision.<br class="md-br" /> Let's find the ideal technique for you — with care at every step.</p>
      </div>
    </section>

    <div class="divider"><span class="d-line"></span><span class="d-circle"><Fragment set:html={ic('sparkles', '', 20)} /></span><span class="d-line"></span></div>

    <!-- ═══ Three Modality Cards ═══ -->
    <section class="sec-white">
      <div class="wide-c">
        <div class="sec-head">
          <h2>Available Whitening Options</h2>
          <p>Each technique is recommended based on individual characteristics. Learn about the options.</p>
        </div>
        <div class="grid-3">
          {modalityCards.map((card) => (
            <div class="modal-card">
              <div class="modal-img">
                <img src={card.img} alt={card.alt} width="800" height="800" loading="lazy" decoding="async" />
                <div class="modal-overlay"></div>
                <div class="modal-caption">
                  <h3>{card.title}</h3>
                  <p class="clamp-3">{card.caption}</p>
                </div>
              </div>
              <div class="modal-body">
                <details class="acc" name={card.accName}>
                  <summary><span>Key Features</span><Fragment set:html={ic('chevronDown', 'acc-chev', 16)} /></summary>
                  <div class="acc-content">
                    <ul class="tri-list">
                      {card.features.map(([label, val]) => (
                        <li><span class="tri">▸</span><span><strong>{label}</strong> {val}</span></li>
                      ))}
                    </ul>
                  </div>
                </details>
                <details class="acc" name={card.accName}>
                  <summary><span>Advantages &amp; Considerations</span><Fragment set:html={ic('chevronDown', 'acc-chev', 16)} /></summary>
                  <div class="acc-content">
                    <div class="adv-box">
                      <p class="adv-box-t">Advantages:</p>
                      <ul class="tick-list">
                        {card.advantages.map((t) => (
                          <li><span class="tick">✓</span><span>{t}</span></li>
                        ))}
                      </ul>
                    </div>
                    <div class="cons-box">
                      <p class="cons-box-t">Considerations:</p>
                      <ul class="dot-list">
                        {card.considerations.map((t) => (
                          <li><span class="dot">•</span><span>{t}</span></li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </details>
                <details class="acc" name={card.accName}>
                  <summary><span>Ideal For</span><Fragment set:html={ic('chevronDown', 'acc-chev', 16)} /></summary>
                  <div class="acc-content">
                    <div class="ideal-box"><p>{card.ideal}</p></div>
                  </div>
                </details>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ Mid CTA ═══ -->
    <section class="mid-cta sec-white">
      <div class="narrow-c center">
        <p class="mid-lead">Not sure which modality to choose?</p>
        <a class="btn-gold js-wa-cta" data-label="en_teeth_whitening" href={waMid} target="_blank" rel="noopener">
          Let's Evaluate Together <Fragment set:html={ic('arrowRight', 'ml8', 20)} />
        </a>
      </div>
    </section>

    <div class="divider"><span class="d-line"></span><span class="d-circle"><Fragment set:html={ic('sparkles', '', 20)} /></span><span class="d-line"></span></div>

    <!-- ═══ Comparison Table ═══ -->
    <section class="sec-beige20 pb-tight">
      <div class="wide-c">
        <div class="sec-head">
          <h2>Comparison Between Modalities</h2>
        </div>
        <div class="cmp-wrap">
          <h3 class="cmp-title">Comparação</h3>
          <div class="cmp-scroll">
            <table class="cmp-table">
              <thead>
                <tr><th class="th-left">Critério</th><th>{cmpHeadA}</th><th>{cmpHeadB}</th></tr>
              </thead>
              <tbody>
                {cmpRows.map((row, i) => (
                  <tr class={i % 2 === 0 ? 'even' : ''}>
                    <td class="td-crit">{row[0]}</td>
                    <td class="td-c"><span class="cell-txt">{row[1]}</span></td>
                    <td class="td-c"><span class="cell-txt">{row[2]}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        <p class="cmp-after">The recommendation depends on the individual analysis of each case. During the evaluation, we consider your needs, routine, and specific dental characteristics.</p>
      </div>
    </section>

    <div class="divider"><span class="d-line"></span><span class="d-circle"><Fragment set:html={ic('sparkles', '', 20)} /></span><span class="d-line"></span></div>

    <!-- ═══ Process Timeline ═══ -->
    <section class="sec-white">
      <div class="container-c">
        <h2 class="center-title">Treatment Steps</h2>
        <p class="center-sub">From planning to post-treatment care, each step is designed for your comfort</p>
        <div class="timeline">
          <div class="tl-line" aria-hidden="true"></div>
          <div class="tl-steps" role="list">
            {timelineSteps.map((step) => (
              <div class="tl-step" role="listitem">
                <div class="tl-num-col">
                  <div class="tl-num">{step.number}</div>
                  <div class="tl-dot" aria-hidden="true"></div>
                </div>
                <div class="tl-content">
                  <div class="tl-ic"><Fragment set:html={ic(step.icon, '', 24)} /></div>
                  <h3>{step.title}</h3>
                  <p>{step.description}</p>
                  <p class="tl-duration">Duração: {step.duration}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <div class="divider"><span class="d-line"></span><span class="d-circle"><Fragment set:html={ic('award', '', 20)} /></span><span class="d-line"></span></div>

    <!-- ═══ Doctor Bio ═══ -->
    <section class="bio-section">
      <div class="container-c">
        <h2 class="bio-sec-title">Expertise &amp; Experience in Cosmetic Dentistry</h2>
        <div class="bio-wrap">
          <div class="bio-photo-col">
            <div class="bio-photo">
              <img src="/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp" alt="Dr. Carla Christoph - Dental Specialist" width="800" height="1200" loading="lazy" decoding="async" />
              <div class="bio-badge">20+ Years of Experience</div>
            </div>
          </div>
          <div class="bio-card">
            <div class="bio-name-wrap">
              <h3>Dr. Carla Christoph</h3>
              <p class="bio-sub">CRO-RJ 27.509 | Specialist in Prosthodontics and Implant Dentistry</p>
            </div>
            <div class="bio-paras">
              <p>With over two decades in Ipanema, Dr. Carla has built her reputation by treating each patient individually, with time and attention. Her background includes 8 years as a military dentist at the Navy's Central Dental Clinic, experience that brought discipline and precision to her clinical practice.</p>
              <p>In her whitening protocols, she prioritizes safety and natural results — each case has its specific indication. The choice between in-office, supervised at-home, or combined whitening is defined during the evaluation, considering the tooth condition and the patient's expectations.</p>
            </div>
            <div class="bio-creds">
