          <div class="choose-flex">
            <div class="choose-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
