const finalWaHref = `${WA}?text=${encodeURIComponent('Hello! I saw the page about aesthetic restorations and would like to schedule an evaluation with Dr. Carla Christoph.')}`;
const floatWaHref = `${WA}?text=${encodeURIComponent("Hello! I'd like to book an appointment.")}`;

const schemas = [
  JSON.stringify({ "@context": "https://schema.org", "@type": "MedicalProcedure", "name": "Aesthetic Dental Restoration", "description": "Aesthetic dental restoration with nano-filled composite resin for treatment of cavities, fractures, and cracks with natural results", "procedureType": "Dental", "inLanguage": "en", "provider": { "@type": "Dentist", "name": "Dr. Carla Christoph", "telephone": "+5521993304045", "address": { "@type": "PostalAddress", "streetAddress": "Rua Visconde de Pirajá, 550 - Suite 1107", "addressLocality": "Ipanema", "addressRegion": "RJ", "postalCode": "22410-901", "addressCountry": "BR" } } }),
  JSON.stringify({ "@context": "https://schema.org", "@type": "FAQPage", "inLanguage": "en", "mainEntity": [
    { "@type": "Question", "name": "What is an aesthetic dental restoration?", "acceptedAnswer": { "@type": "Answer", "text": "It is a procedure that rebuilds teeth compromised by cavities, fractures, or cracks using state-of-the-art materials (composite resin or porcelain) that perfectly mimic the color, shine, and texture of natural teeth. Unlike the old dark amalgam \"fillings,\" aesthetic restorations are virtually invisible." } },
    { "@type": "Question", "name": "When is a restoration necessary?", "acceptedAnswer": { "@type": "Answer", "text": "When is a restoration necessary?" } },
    { "@type": "Question", "name": "What materials are used in aesthetic restorations?", "acceptedAnswer": { "@type": "Answer", "text": "We use state-of-the-art nano-filled composite resins that offer high strength, natural aesthetics, and durability. For cases requiring maximum longevity (large posterior restorations), we recommend porcelain or lab-processed resin restorations (inlays/onlays), which are fabricated in specialized labs for even greater strength." } },
    { "@type": "Question", "name": "Does the restoration procedure hurt?", "acceptedAnswer": { "@type": "Answer", "text": "No. We use local anesthesia with a comfortable technique. Most patients report no discomfort during the procedure. After the anesthesia wears off, there may be mild sensitivity for 24-48 hours, easily managed with over-the-counter pain medication if needed." } },
    { "@type": "Question", "name": "How long do aesthetic restorations last?", "acceptedAnswer": { "@type": "Answer", "text": "How long do aesthetic restorations last?" } },
    { "@type": "Question", "name": "Can I replace my old dark fillings?", "acceptedAnswer": { "@type": "Answer", "text": "Yes! Replacing old amalgam (metal) fillings with aesthetic composite restorations is one of the most sought-after procedures. Beyond the aesthetic benefit, we eliminate the risk of micro-leakage common in old restorations and remove the metal from your mouth. The replacement is done conservatively, preserving as much healthy tooth structure as possible." } },
    { "@type": "Question", "name": "Do composite restorations stain over time?", "acceptedAnswer": { "@type": "Answer", "text": "Modern composite resins have excellent color stability. With proper care (good hygiene, periodic professional polishing, and moderation with highly pigmented foods like coffee, red wine, and açaí), restorations maintain their original color for many years. When needed, professional polishing can restore the luster." } }
  ] }),
  JSON.stringify({ "@context": "https://schema.org", "@type": "WebPage", "name": "Aesthetic Dental Restorations in Ipanema", "url": "https://dracarlachristoph.com/en/aesthetic-restorations", "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".treatment-hero-title", ".treatment-hero-description", ".quick-answer-box"] }, "inLanguage": "en" }),
  JSON.stringify({ "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dracarlachristoph.com/en" },
    { "@type": "ListItem", "position": 2, "name": "Treatments", "item": "https://dracarlachristoph.com/en" },
    { "@type": "ListItem", "position": 3, "name": "Aesthetic Restorations" }
  ] }),
];
---

<SiteLayout
  title="Aesthetic Dental Restorations in Ipanema | Dr. Carla Christoph, Rio de Janeiro"
  description="Aesthetic dental restorations in Ipanema. Tooth-colored fillings, composite bonding, inlays and onlays. Natural results. Dr. Carla Christoph, CRO-RJ 27.509."
  canonical="https://dracarlachristoph.com/en/aesthetic-restorations"
  ogImage="https://dracarlachristoph.com/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp"
  preloadImage="/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp"
  schemas={schemas}
  lang="en"
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="pt-BR" href="https://dracarlachristoph.com/restauracoes-esteticas" />
    <link rel="alternate" hreflang="en" href="https://dracarlachristoph.com/en/aesthetic-restorations" />
    <link rel="alternate" hreflang="x-default" href="https://dracarlachristoph.com/restauracoes-esteticas" />
  </Fragment>

  <main id="main-content" class="en-page">
    <!-- ═══ Treatment Hero ═══ -->
    <section class="hero" aria-label="Treatment hero">
      <div class="content-container section-spacing">
        <div class="hero-grid">
          <div class="hero-content">
            <nav class="breadcrumb" aria-label="breadcrumb">
              <ol>
                <li><a href="/en">Home</a></li>
                <li class="sep" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></li>
                <li><a href="/en">Treatments</a></li>
                <li class="sep" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></li>
                <li><span class="current" aria-current="page">Aesthetic Restorations</span></li>
              </ol>
            </nav>

            <h1 class="treatment-hero-title">Aesthetic Dental Restorations in Ipanema</h1>
            <p class="hero-subtitle">Beauty and Function for Your Smile</p>
            <p class="hero-desc treatment-hero-description">Restore teeth compromised by cavities, fractures, or cracks with state-of-the-art composite resins that perfectly mimic the natural color and texture of your teeth.</p>

            <div class="hero-badges">
              <span class="badge">High-Performance Resins</span>
              <span class="badge">Natural Results</span>
              <span class="badge">Conservative Technique</span>
            </div>

            <div class="hero-cta-wrap">
              <a
                class="hero-cta js-wa-cta"
                data-label="en-aesthetic-restorations_hero_whatsapp"
                href={heroWaHref}
                target="_blank"
                rel="noopener"
                aria-label="Schedule consultation via WhatsApp"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                Book Your Consultation
              </a>
            </div>
          </div>

          <div class="hero-image-col">
            <div class="hero-image-frame">
              <img
                src="/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp"
                alt="Dr. Carla Christoph - Aesthetic Dental Restorations in Ipanema Specialist"
                width="800"
                height="1200"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ Quick Answer Box ═══ -->
    <section class="qa-section">
      <div class="container-custom">
        <div class="quick-answer-box">
          <div class="qa-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <div>
            <h2 class="qa-title">Quick Answer</h2>
            <p class="qa-text">Aesthetic restorations are treatments that rebuild teeth compromised by cavities, fractures, or cracks using nano-filled composite resins or state-of-the-art ceramics. At Dr. Carla Christoph's practice in Ipanema (CRO-RJ 27.509), we use high-quality materials with color layering techniques that perfectly reproduce the natural translucency of teeth. The treatment is conservative, preserving as much tooth structure as possible, and the result is indistinguishable from natural teeth. With 20+ years of experience, we perform everything from small restorations to complex reconstructions in one or just a few sessions.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ Empathetic Pain Points ═══ -->
    <section class="pain-section">
      <div class="pain-container">
        <h2 class="pain-title">Have you ever hidden your smile because of a compromised tooth?</h2>
        <div class="pain-list">
          <div class="pain-card" style="border-left-color: var(--dental-purple);">
            <div class="pain-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--dental-purple)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12l4 6-10 13L2 9Z"/><path d="M11 3 8 9l4 13 4-13-3-6"/><path d="M2 9h20"/></svg>
            </div>
            <div>
              <strong>Restorations that go completely unnoticed</strong>
              <span>We use layered resins and ceramics that reproduce the natural translucency and texture of your tooth — these aren't fillings, they're reconstructions.</span>
            </div>
          </div>
          <div class="pain-card" style="border-left-color: var(--dental-gold);">
            <div class="pain-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
              <strong>Conservative technique — we preserve as much as possible</strong>
              <span>Every restoration is planned to remove only what's necessary. The more natural structure preserved, the better the long-term outcome.</span>
            </div>
          </div>
          <div class="pain-card" style="border-left-color: var(--dp-soft);">
            <div class="pain-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--dp-soft)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
            </div>
            <div>
              <strong>Every case is individually planned</strong>
              <span>Dr. Carla takes the time to understand your history before any procedure — no rush, no one-size-fits-all approach.</span>
            </div>
          </div>
        </div>
        <p class="pain-conclusion">Cavities, fractures, and cracks are more common than you think — and the impact goes beyond aesthetics.<br class="md-only" /> Let's evaluate the best solution for your case.</p>
      </div>
    </section>

    <!-- Divider (award) -->
    <div class="divider" aria-hidden="true">
      <div class="divider-line"></div>
      <div class="divider-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg></div>
      <div class="divider-line"></div>
    </div>

    <!-- ═══ Doctor Bio ═══ -->
    <section class="bio-section">
