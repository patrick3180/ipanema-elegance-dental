  .hero-cta-wrap { padding-top: 16px; }
  .btn-hero {
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--dental-purple); color: #fff; text-decoration: none;
    padding: 12px 24px; border-radius: 6px; font-size: 1rem; font-weight: 500;
    box-shadow: 0 4px 20px hsl(0 0% 0% / 0.08); transition: all 0.3s;
  }
  .btn-hero:hover { background: #2a1735; box-shadow: 0 12px 32px rgba(56, 31, 71, 0.16), 0 6px 16px rgba(56, 31, 71, 0.1); }
  .hero-img-frame { border-radius: 16px; overflow: hidden; box-shadow: 0 10px 40px -10px rgb(56 31 71 / 0.2); }
  .hero-img-frame img { width: 100%; height: auto; transition: transform 0.5s; }
  .hero-img-frame:hover img { transform: scale(1.02); }

  /* ══ Quick Answer ══ */
  .qa-section { padding: 32px 0; background: #fff; }
  .qa-box {
    display: flex; align-items: flex-start; gap: 16px;
    background: linear-gradient(to right, rgb(56 31 71 / 0.1), rgb(179 149 95 / 0.1));
    border: 1px solid rgb(179 149 95 / 0.3); border-radius: 12px; padding: 24px; margin-bottom: 32px;
  }
  .qa-ic { flex-shrink: 0; margin-top: 4px; }
  .qa-title { font-family: Montserrat, sans-serif; font-size: 1.125rem; font-weight: 600; color: var(--dental-purple); margin-bottom: 8px; }
  .qa-text { color: var(--dental-gray); line-height: 1.7; }

  /* ══ Pain Points ══ */
  .pain-section { padding: 64px 0; background: linear-gradient(to bottom right, hsl(var(--beige-hsl) / 0.2), #fff, hsl(var(--beige-hsl) / 0.1)); }
  .pain-title { font-family: 'Playfair Display', Georgia, serif; font-weight: 600; font-size: 1.5rem; color: var(--dental-purple); margin-bottom: 40px; text-align: center; }
  @media (min-width: 768px) { .pain-title { font-size: 1.875rem; } }
  .pain-list > * + * { margin-top: 20px; }
  .pain-card {
    display: flex; align-items: flex-start; gap: 16px;
    background: rgb(255 255 255 / 0.8); backdrop-filter: blur(4px);
    padding: 24px; border-radius: 12px; border-left: 4px solid var(--dental-purple);
    box-shadow: 0 4px 20px hsl(0 0% 0% / 0.08); transition: box-shadow 0.3s;
  }
  .pain-card:hover { box-shadow: 0 10px 40px -10px rgb(56 31 71 / 0.2); }
  .pain-card.b-gold { border-left-color: var(--dental-gold); }
  .pain-card.b-purple-soft { border-left-color: var(--dental-purple-soft); }
  .pain-ic { flex-shrink: 0; width: 48px; height: 48px; border-radius: 999px; background: rgb(56 31 71 / 0.1); display: flex; align-items: center; justify-content: center; }
  .pain-card strong { display: block; color: var(--dental-purple); font-weight: 600; margin-bottom: 4px; }
  .pain-card span { color: var(--dental-gray); line-height: 1.7; }
  .pain-conclusion { text-align: center; color: var(--dental-gray); margin-top: 40px; font-size: 1.125rem; line-height: 1.7; }

  /* ══ Divider ══ */
  .divider { display: flex; align-items: center; justify-content: center; gap: 16px; margin: 32px 0; }
  @media (min-width: 768px) { .divider { margin: 48px 0; } }
  .d-line { flex: 1; height: 1px; background: rgb(179 149 95 / 0.3); max-width: 128px; }
  .d-circle { width: 48px; height: 48px; border-radius: 999px; background: rgb(179 149 95 / 0.1); display: flex; align-items: center; justify-content: center; color: var(--dental-gold); transition: transform 0.3s; }
  .d-circle:hover { transform: scale(1.1); }

  /* ══ Seções genéricas ══ */
  .sec-white { padding: 48px 0; background: #fff; }
  .sec-beige20 { padding: 48px 0; background: hsl(var(--beige-hsl) / 0.2); }
  .sec-beige30 { background: hsl(var(--beige-hsl) / 0.3); }
  .pb-tight { padding-bottom: 32px; }
  .sec-head { text-align: center; margin-bottom: 48px; }
  .sec-head h2 { font-family: 'Playfair Display', Georgia, serif; font-weight: 600; font-size: 1.875rem; color: var(--dental-purple); margin-bottom: 16px; }
  @media (min-width: 768px) { .sec-head h2 { font-size: 2.25rem; } }
  .sec-head p { font-size: 1.125rem; color: var(--dental-gray); }
  .grid-3 { display: grid; gap: 32px; }
  @media (min-width: 768px) { .grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .grid-2 { display: grid; gap: 32px; }
  @media (min-width: 768px) { .grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .grid-3-lg { display: grid; gap: 32px; }
  @media (min-width: 768px) { .grid-3-lg { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .grid-3-lg { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  /* ══ Benefit cards ══ */
  .benefit-card { background: #fff; padding: 24px; border-radius: 12px; box-shadow: 0 4px 20px hsl(0 0% 0% / 0.08); transition: box-shadow 0.3s; }
  .benefit-card:hover { box-shadow: 0 10px 40px -10px rgb(56 31 71 / 0.2); }
  .benefit-head { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .benefit-ic { width: 48px; height: 48px; border-radius: 999px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .bg-red-50 { background: #fef2f2; }
  .bg-purple-50 { background: #faf5ff; }
  .bg-blue-50 { background: #eff6ff; }
  .benefit-head h3 { font-family: Montserrat, sans-serif; font-weight: 600; font-size: 1.125rem; color: var(--dental-purple); }
  .check-list { list-style: none; color: var(--dental-gray); font-size: 0.875rem; }
  .check-list li { display: flex; align-items: flex-start; gap: 8px; }
  .check-list li + li { margin-top: 8px; }

  /* ══ Modality cards ══ */
  .modal-card { border-radius: 16px; overflow: hidden; box-shadow: 0 4px 20px hsl(0 0% 0% / 0.08); transition: box-shadow 0.3s; }
  .modal-card:hover { box-shadow: 0 10px 40px -10px rgb(56 31 71 / 0.2); }
  .modal-img { position: relative; aspect-ratio: 4 / 3; }
  .modal-img img { width: 100%; height: 100%; object-fit: cover; }
  .modal-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgb(56 31 71 / 0.9), rgb(56 31 71 / 0.5) 50%, transparent); }
  .modal-caption { position: absolute; bottom: 0; left: 0; right: 0; padding: 24px; color: #fff; }
  .modal-caption h3 { font-family: 'Playfair Display', Georgia, serif; font-weight: 600; font-size: 1.5rem; color: #fff; margin-bottom: 8px; }
  .modal-caption p { font-size: 0.875rem; color: rgb(255 255 255 / 0.9); margin-bottom: 16px; }
  .modal-body { background: #fff; padding: 24px; }

  /* ══ Accordion (shadcn → <details>) ══ */
  .acc { border-bottom: 1px solid #e5e7eb; }
  .acc summary {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    padding: 16px 0; cursor: pointer; list-style: none;
    font-weight: 600; font-size: 1rem; color: #333; text-align: left; transition: color 0.2s;
  }
  .acc summary:hover { color: var(--dental-purple); text-decoration: underline; }
  .acc summary::-webkit-details-marker { display: none; }
  :global(.acc-chev) { flex-shrink: 0; color: var(--dental-gray); transition: transform 0.2s; }
  .acc[open] summary :global(.acc-chev), .faq-item[open] summary :global(.acc-chev) { transform: rotate(180deg); }
  .acc-content { padding-bottom: 16px; }
  .tri-list, .tick-list, .dot-list { list-style: none; color: var(--dental-gray); font-size: 0.875rem; }
  .tri-list li, .tick-list li, .dot-list li { display: flex; align-items: flex-start; gap: 8px; }
  .tri-list li + li, .tick-list li + li, .dot-list li + li { margin-top: 8px; }
  .tri { color: var(--dental-gold); margin-top: 4px; }
  .tick { color: #16a34a; margin-top: 4px; }
  .dot { color: var(--dental-gray); margin-top: 4px; }
  .adv-title { display: flex; align-items: center; gap: 8px; font-weight: 600; color: #15803d; margin-bottom: 8px; font-size: 1rem; font-family: Montserrat, sans-serif; }
  .cons-title { font-weight: 600; color: var(--dental-gray); margin: 16px 0 8px; font-size: 1rem; font-family: Montserrat, sans-serif; }
  .ideal-box { background: #eff6ff; padding: 16px; border-radius: 8px; }
  .ideal-box p { color: var(--dental-gray); font-size: 0.875rem; }

  /* ══ Comparison table ══ */
  .cmp-wrap { margin-bottom: 32px; }
  .cmp-title { font-family: Montserrat, sans-serif; font-size: 1.25rem; font-weight: 600; color: var(--dental-purple); margin-bottom: 16px; }
  .cmp-scroll { overflow-x: auto; }
  .cmp-table { width: 100%; border-collapse: collapse; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 2px rgb(0 0 0 / 0.05); }
  .cmp-table thead tr { background: var(--dental-purple); color: #fff; }
  .cmp-table th { padding: 12px 16px; text-align: center; font-weight: 500; font-family: Montserrat, sans-serif; }
  .cmp-table th.th-left { text-align: left; }
  .cmp-table td { padding: 12px 16px; }
  .cmp-table tr.even { background: #f9fafb; }
  .td-crit { color: var(--dental-purple); font-weight: 500; font-size: 0.875rem; }
  .td-c { text-align: center; }
  .cell-txt { color: var(--dental-gray); font-size: 0.875rem; }
  :global(.cell-x) { color: #dc2626; display: inline-block; vertical-align: middle; }
  :global(.cell-ok) { color: #16a34a; display: inline-block; vertical-align: middle; }
  .cmp-note { margin-top: 32px; text-align: center; }
  .cmp-note p { color: var(--dental-gray); font-style: italic; }

  /* ══ Doctor Bio ══ */
  .bio-section { padding: 64px 0; background: linear-gradient(135deg, hsl(250 100% 98%) 0%, hsl(30 100% 97%) 100%); }
  .bio-sec-title { font-family: 'Playfair Display', Georgia, serif; font-weight: 600; font-size: 1.875rem; color: var(--dental-purple); margin-bottom: 48px; text-align: center; }
  @media (min-width: 768px) { .bio-sec-title { font-size: 2.25rem; } }
  .bio-wrap { max-width: 1024px; margin: 0 auto; display: grid; gap: 32px; align-items: start; }
  @media (min-width: 768px) { .bio-wrap { grid-template-columns: 300px 1fr; } }
  .bio-photo-col { margin: 0 auto; }
  @media (min-width: 768px) { .bio-photo-col { margin: 0; } }
  .bio-photo { position: relative; }
  .bio-photo img { width: 100%; border-radius: 16px; box-shadow: 0 10px 40px -10px rgb(56 31 71 / 0.2); }
  .bio-badge {
    position: absolute; bottom: -16px; left: 50%; transform: translateX(-50%);
    background: var(--dental-gold); color: #fff; padding: 8px 24px; border-radius: 999px;
    box-shadow: 0 4px 12px rgb(179 149 95 / 0.3); font-weight: 600; font-size: 0.875rem; white-space: nowrap;
  }
  .bio-card { background: #fff; padding: 32px; border-radius: 16px; box-shadow: 0 4px 20px hsl(0 0% 0% / 0.08); }
  .bio-name-wrap { margin-bottom: 24px; }
  .bio-name-wrap h3 { font-family: 'Playfair Display', Georgia, serif; font-weight: 600; font-size: 1.875rem; color: var(--dental-purple); margin-bottom: 8px; }
  .bio-sub { color: var(--gold-dark); font-weight: 500; font-size: 1.125rem; }
  .bio-paras { color: var(--dental-gray); line-height: 1.7; }
  .bio-paras > * + * { margin-top: 16px; }
  .bio-creds { margin-top: 24px; padding-top: 24px; border-top: 1px solid rgb(107 107 107 / 0.2); display: grid; gap: 16px; }
  @media (min-width: 768px) { .bio-creds { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .cred { display: flex; align-items: flex-start; gap: 12px; }
  :global(.cred-ic) { margin-top: 4px; flex-shrink: 0; }
  .cred-t { font-weight: 600; color: var(--dental-purple); }
  .cred-d { font-size: 0.875rem; color: var(--dental-gray); }
  .bio-quote {
    position: relative; margin-top: 32px; padding: 32px; border-radius: 16px; overflow: hidden;
    background: linear-gradient(to bottom right, rgb(56 31 71 / 0.05), rgb(179 149 95 / 0.05));
    border: 1px solid rgb(179 149 95 / 0.1);
  }
  .bio-quote p { font-family: 'Playfair Display', Georgia, serif; font-size: 1.25rem; color: var(--dental-purple); font-style: italic; line-height: 1.7; text-align: center; position: relative; z-index: 10; padding: 0 16px; }
  .q-mark { position: absolute; font-size: 3rem; color: rgb(179 149 95 / 0.2); font-family: Georgia, serif; line-height: 1; }
  .q-tl { top: 16px; left: 16px; }
  .q-br { bottom: 16px; right: 16px; }

  /* ══ Smile Test Drive ══ */
  .td-section { padding: 64px 0; background: linear-gradient(to bottom right, rgb(56 31 71 / 0.05), rgb(179 149 95 / 0.05)); }
  .td-c { max-width: 1024px; margin: 0 auto; padding: 0 16px; }
  .td-pill { display: inline-flex; align-items: center; gap: 8px; background: rgb(179 149 95 / 0.1); padding: 8px 16px; border-radius: 999px; margin-bottom: 16px; }
  .td-pill span { color: var(--dental-gold); font-weight: 600; font-size: 0.875rem; }
  .td-lead { font-size: 1.25rem !important; }
  .td-card { background: #fff; border-radius: 24px; box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1); overflow: hidden; }
  .td-grid { display: grid; }
  @media (min-width: 768px) { .td-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .td-left { background: linear-gradient(to bottom right, var(--dental-purple), rgb(56 31 71 / 0.9)); color: #fff; padding: 40px; }
  .td-head { display: flex; align-items: flex-start; gap: 16px; margin-bottom: 24px; }
  .td-head-ic { width: 56px; height: 56px; background: rgb(255 255 255 / 0.2); border-radius: 16px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #fff; }
  .td-head h3 { font-family: 'Playfair Display', Georgia, serif; font-weight: 600; font-size: 1.5rem; color: #fff; margin-bottom: 8px; }
  .td-head p { color: rgb(255 255 255 / 0.9); }
  .td-steps > * + * { margin-top: 24px; }
  .td-step { display: flex; align-items: flex-start; gap: 16px; }
  .td-num { width: 40px; height: 40px; border-radius: 999px; background: var(--dental-gold); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .td-num span { font-weight: 700; color: #fff; }
  .td-step h4 { font-family: Montserrat, sans-serif; font-weight: 600; color: #fff; margin-bottom: 4px; }
  .td-step p { font-size: 0.875rem; color: rgb(255 255 255 / 0.8); }
  .td-right { padding: 40px; background: hsl(var(--beige-hsl) / 0.2); }
  .td-right h3 { font-family: Montserrat, sans-serif; font-weight: 600; font-size: 1.25rem; color: var(--dental-purple); margin-bottom: 24px; }
  .td-points > * + * { margin-top: 20px; }
  .td-point { display: flex; align-items: flex-start; gap: 12px; }
  .td-point strong { display: block; color: var(--dental-purple); }
  .td-point p { color: var(--dental-gray); font-size: 0.875rem; }
  .td-quote { margin-top: 32px; background: linear-gradient(to bottom right, rgb(179 149 95 / 0.1), rgb(56 31 71 / 0.05)); padding: 24px; border-radius: 12px; border: 1px solid rgb(179 149 95 / 0.2); }
  .td-quote p { color: var(--dental-gray); font-size: 0.875rem; font-style: italic; line-height: 1.7; }

  /* ══ Mid CTA ══ */
  .mid-cta { padding: 32px 0; }
  .mid-lead { font-size: 1.25rem; color: var(--dental-gray); margin-bottom: 24px; }
  .btn-gold {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 16px 32px; background: var(--dental-gold); color: #fff; text-decoration: none;
    font-weight: 600; border-radius: 8px; transition: all 0.2s;
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
  }
  .btn-gold:hover { background: rgb(179 149 95 / 0.9); box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1); transform: scale(1.05); }

  /* ══ iTero ══ */
  .itero-section { padding: 64px 0; background: #fff; }
  .itero-card { background: linear-gradient(to bottom right, hsl(var(--beige-hsl) / 0.3), #fff); padding: 40px; border-radius: 24px; box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1); }
  .itero-lead { color: var(--dental-gray); line-height: 1.7; text-align: center; font-size: 1.125rem; }
  .itero-grid { display: grid; gap: 24px; margin-top: 32px; }
  @media (min-width: 768px) { .itero-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .itero-item { display: flex; align-items: flex-start; gap: 16px; }
  .itero-ic { width: 48px; height: 48px; background: rgb(56 31 71 / 0.1); border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .itero-item h4 { font-family: Montserrat, sans-serif; font-weight: 600; color: var(--dental-purple); margin-bottom: 4px; }
  .itero-item p { color: var(--dental-gray); font-size: 0.875rem; }

  /* ══ What Few Explain ══ */
  .few-section { padding: 80px 0; background: linear-gradient(to bottom, #fff, hsl(var(--beige-hsl) / 0.1), #fff); position: relative; overflow: hidden; }
  .few-bg { position: absolute; inset: 0; opacity: 0.03; background-image: radial-gradient(circle at 25px 25px, #381F47 2%, transparent 0%), radial-gradient(circle at 75px 75px, #381F47 2%, transparent 0%); background-size: 100px 100px; }
  .few-head { text-align: center; margin-bottom: 80px; }
  .few-orn { display: inline-flex; align-items: center; gap: 12px; margin-bottom: 24px; }
  .orn-line { width: 48px; height: 1px; background: linear-gradient(to right, transparent, var(--dental-gold), transparent); }
  .few-head h2 { font-family: 'Playfair Display', Georgia, serif; font-weight: 600; font-size: 2.25rem; color: var(--dental-purple); margin-bottom: 24px; }
  @media (min-width: 768px) { .few-head h2 { font-size: 3rem; } }
  .few-head p { font-size: 1.125rem; color: var(--dental-gray); max-width: 48rem; margin: 0 auto; line-height: 1.7; }
  @media (min-width: 768px) { .few-head p { font-size: 1.25rem; } }
  .few-block { margin-bottom: 80px; }
  .few-sub { text-align: center; margin-bottom: 48px; }
  .few-sub h3 { font-family: Montserrat, sans-serif; font-size: 1.5rem; font-weight: 600; color: var(--dental-purple); margin-bottom: 12px; }
  .few-sub p { color: var(--dental-gray); }
  .chal-card {
    position: relative; background: #fff; padding: 32px; border-radius: 16px; overflow: hidden;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
    border: 1px solid hsl(var(--beige-hsl) / 0.3); transition: all 0.3s;
  }
  .chal-card:hover { box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1); border-color: rgb(179 149 95 / 0.3); }
  .chal-num { position: absolute; top: 16px; right: 24px; font-size: 6rem; font-family: 'Playfair Display', Georgia, serif; font-weight: 700; color: rgb(56 31 71 / 0.05); user-select: none; line-height: 1; }
  .chal-top { display: flex; align-items: flex-start; gap: 20px; margin-bottom: 20px; }
  .chal-ic { width: 56px; height: 56px; border-radius: 16px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: transform 0.3s; }
  .chal-card:hover .chal-ic { transform: scale(1.1); }
  .grad-purple { background: linear-gradient(to bottom right, #faf5ff, #f3e8ff); }
  .grad-blue { background: linear-gradient(to bottom right, #eff6ff, #dbeafe); }
  .grad-green { background: linear-gradient(to bottom right, #f0fdf4, #dcfce7); }
  .grad-amber { background: linear-gradient(to bottom right, #fffbeb, #fef3c7); }
  .grad-yellow { background: linear-gradient(to bottom right, #fefce8, #fef9c3); }
  .grad-red { background: linear-gradient(to bottom right, #fef2f2, #fee2e2); }
  .grad-pink { background: linear-gradient(to bottom right, #fdf2f8, #fce7f3); }
  :global(.ic-purple) { color: #9333ea; }
  :global(.ic-purple600) { color: #9333ea; }
  :global(.ic-blue) { color: #2563eb; }
  :global(.ic-green) { color: #16a34a; }
  :global(.ic-amber) { color: #d97706; }
  :global(.ic-yellow) { color: #ca8a04; }
  :global(.ic-red) { color: #ef4444; }
  :global(.ic-pink) { color: #ec4899; }
  .chal-card h4 { font-family: Montserrat, sans-serif; font-weight: 600; font-size: 1.25rem; color: var(--dental-purple); margin-bottom: 8px; transition: color 0.3s; }
  .chal-card:hover h4 { color: var(--dental-gold); }
  .gold-bar { width: 48px; height: 4px; background: linear-gradient(to right, var(--dental-gold), transparent); border-radius: 999px; }
  .chal-card > .rel > p { color: var(--dental-gray); font-size: 0.875rem; line-height: 1.7; }
  .few-divider { display: flex; align-items: center; justify-content: center; gap: 16px; margin: 64px 0; }
  .fd-line { width: 128px; height: 1px; background: linear-gradient(to right, transparent, var(--dental-gold), var(--dental-gold)); }
  .fd-line-r { background: linear-gradient(to left, transparent, var(--dental-gold), var(--dental-gold)); }
  .fd-heart { position: relative; display: inline-flex; }
  .appr-list { max-width: 896px; margin: 0 auto; }
  .appr-list > * + * { margin-top: 20px; }
