---
/**
 * /en/dental-implants — porte fiel de src/pages/en/EnDentalImplantsPage.tsx (React SPA).
 * Copy VERBATIM. Layout: SiteLayout lang="en" (EnSiteHeader/EnSiteFooter).
 * Tracking: CTAs WhatsApp via classe global js-wa-cta (handler no Base.astro).
 */
import SiteLayout from '../../layouts/SiteLayout.astro';

// FAQs — verbatim do React (usadas no HTML e no schema FAQPage)
const faqs = [
  { question: "What are dental implants?", answer: "They are biocompatible titanium pins surgically placed in the jawbone, replacing the root of the lost tooth. On these pins, we fix crowns, bridges, or complete prostheses, restoring chewing function, aesthetics, and speech." },
  { question: "Is the procedure painful?", answer: "The surgery is performed under local anesthesia, with no pain during the procedure. Post-op recovery is generally smooth, with mild discomfort controlled by medication. Most patients return to normal activities within 2 to 3 days." },
  { question: "How long does the complete treatment take?", answer: "Timeframe varies by case. On average, 4 to 6 months from implant placement to the definitive prosthesis, including the osseointegration period (3 to 6 months). In selected immediate-loading cases, the provisional prosthesis is placed as planned." },
  { question: "Can anyone get implants?", answer: "Most healthy adults are candidates. We evaluate overall health, bone quantity and quality, habits (smoking), and systemic conditions (controlled diabetes). In cases of insufficient bone, bone grafts can make treatment viable." },
  { question: "How long do implants last?", answer: "With proper hygiene and regular maintenance, implants can last decades or a lifetime. Studies show a success rate above 95% at 10 years. The prosthetic crown may need replacement after 10 to 15 years depending on wear." },
  { question: "How do I maintain my implants?", answer: "Thorough hygiene with brushing, flossing, and specific interdental brushes. Semi-annual visits for professional check-ups, periodic X-rays, and peri-implant health assessment. Avoid excessive overloading and trauma." },
  { question: "Is there implant rejection?", answer: "Titanium is biocompatible and does not cause immune rejection. Failures occur due to infection, early overloading, smoking, or inadequate hygiene — not rejection. Success rate exceeds 95% when protocols are followed." },
  { question: "Can I get implants with limited bone?", answer: "Yes. Bone grafting techniques (autogenous, biomaterial) or sinus lift procedures can increase bone volume. Short or angled implants are also alternatives. Imaging exams allow us to plan the best solution for each case." },
  { question: "What's the difference between an implant and a prosthesis?", answer: "The implant is the titanium pin fixed in the bone (replaces the root). The prosthesis is the visible part (crown, bridge, or denture) that connects to the implant. The complete set restores function and aesthetics." },
  { question: "Can smokers get implants?", answer: "Yes, but smoking reduces the success rate (from 95% to approximately 85%) by impairing healing and osseointegration. We recommend quitting smoking at least 2 weeks before surgery and during healing. Individual evaluation is essential." },
  { question: "Can diabetics get implants?", answer: "Yes, as long as diabetes is controlled (glycated hemoglobin below 7%). Prior medical evaluation is important. Adequate glycemic control ensures normal healing and a success rate equivalent to non-diabetics." },
  { question: "Do you accept dental insurance?", answer: "Our practice is private, which allows us to dedicate the necessary time to each patient and use only top-tier materials. At the first consultation, we present a detailed and transparent estimate." },
];

// Schemas — copiados VERBATIM do SEOHead da página React
const schemas = [
  JSON.stringify({
    "@context": "https://schema.org", "@type": "MedicalProcedure",
    "name": "Dental Implants", "description": "Oral rehabilitation with biocompatible titanium implants and implant-supported prostheses",
    "procedureType": "Dental", "inLanguage": "en",
    "provider": { "@type": "Dentist", "name": "Dr. Carla Christoph", "telephone": "+5521993304045",
      "address": { "@type": "PostalAddress", "streetAddress": "Rua Visconde de Pirajá, 550 - Suite 1107", "addressLocality": "Ipanema", "addressRegion": "RJ", "postalCode": "22410-901", "addressCountry": "BR" }
    }
  }),
  JSON.stringify({
    "@context": "https://schema.org", "@type": "FAQPage", "inLanguage": "en",
    "mainEntity": faqs.map(faq => ({ "@type": "Question", "name": faq.question, "acceptedAnswer": { "@type": "Answer", "text": faq.answer } }))
  }),
  JSON.stringify({
    "@context": "https://schema.org", "@type": "WebPage",
    "name": "Dental Implants in Ipanema",
    "url": "https://dracarlachristoph.com/en/dental-implants",
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".treatment-hero-title", ".treatment-hero-description", ".quick-answer-box"] },
    "inLanguage": "en"
  }),
  // BreadcrumbList — o TreatmentHero do React injeta este schema via Helmet
  JSON.stringify({
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dracarlachristoph.com/en" },
      { "@type": "ListItem", "position": 2, "name": "Treatments", "item": "https://dracarlachristoph.com/en" },
      { "@type": "ListItem", "position": 3, "name": "Dental Implants" }
    ]
  }),
];

// WhatsApp CTAs — mensagens exatas do React
const WA = 'https://wa.me/5521993304045?text=';
const waHero = WA + encodeURIComponent('Hello! I would like to schedule a consultation about Dental Implants & Oral Rehabilitation.');
const waMid = WA + encodeURIComponent("Hello! I'd like to know which implant modality is recommended for my case.");
const waFinal = WA + encodeURIComponent('Hello! I saw the dental implants page and would like to schedule an evaluation with Dr. Carla Christoph.');

// Ícones lucide (inline SVG, stroke currentColor) — paridade visual com o React
const P: Record<string, string> = {
  calendar: '<rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  alert: '<circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/>',
  activity: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
  clock: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  heart: '<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>',
  cpu: '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/>',
  sparkles: '<path d="M12 3l1.912 5.813a2 2 0 0 0 1.275 1.275L21 12l-5.813 1.912a2 2 0 0 0-1.275 1.275L12 21l-1.912-5.813a2 2 0 0 0-1.275-1.275L3 12l5.813-1.912a2 2 0 0 0 1.275-1.275L12 3z"/>',
  scan: '<path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/>',
  award: '<circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>',
  help: '<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" x2="12.01" y1="17" y2="17"/>',
  check: '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>',
  check2: '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>',
  smile: '<circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" x2="9.01" y1="9" y2="9"/><line x1="15" x2="15.01" y1="9" y2="9"/>',
  arrow: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  star: '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>',
  chevdown: '<path d="m6 9 6 6 6-6"/>',
  chevright: '<path d="m9 18 6-6-6-6"/>',
};
const icon = (name: string, size = 24, fill = false) =>
  `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 24 24" fill="${fill ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${P[name]}</svg>`;

// Modalidades de implante (4 cards) — copy verbatim
const modalityCards = [
  {
    img: '/lovable-uploads/implante-unitario.webp',
    alt: 'Single dental implant replacing one missing tooth',
    title: 'Single Implant',
    text: 'Replaces a single missing tooth without compromising adjacent teeth. Titanium pin + pure ceramic crown for a natural, lasting result.',
    details: [
      { label: 'What it is:', text: 'Permanent replacement of a single missing tooth without needing to wear down adjacent teeth. The biocompatible titanium pin is placed in the bone, replacing the root of the absent tooth.' },
      { label: 'When indicated:', text: 'Tooth loss from trauma, non-restorable fracture, tooth with indicated extraction, or congenital tooth absence.' },
      { label: 'Material:', text: 'Medical-grade titanium pin + E-max or zirconia ceramic crown, providing strength and natural aesthetics.' },
      { label: 'Timeframe:', text: '4 to 6 months, including the osseointegration period.' },
      { label: 'Advantages:', text: 'Preserves healthy adjacent teeth, natural aesthetics with a real-tooth appearance, superior durability to conventional bridges, and total comfort.' },
    ],
  },
  {
    img: '/lovable-uploads/ponte-implante.webp',
    alt: 'Fixed bridge supported by dental implants replacing multiple teeth',
    title: 'Implant-Supported Bridge',
    text: 'Rehabilitates multiple adjacent missing teeth with two or more implants. Superior stability to conventional bridges without wearing down healthy teeth.',
    details: [
      { label: 'What it is:', text: "Two or more implants support a fixed bridge of multiple consecutive teeth. Ideal solution when 3 or more adjacent teeth are missing." },
      { label: 'When indicated:', text: "Loss of 3 to 4 consecutive teeth where a separate implant for each tooth isn't necessary." },
      { label: 'Material:', text: 'Titanium implants + monolithic zirconia or porcelain-fused-to-metal bridge.' },
      { label: 'Timeframe:', text: '5 to 7 months.' },
      { label: 'Advantages:', text: "Doesn't damage natural teeth, maximum chewing stability, total comfort without removable prosthetics, and an extremely natural look." },
    ],
  },
  {
    img: '/lovable-uploads/all-in-4.webp',
    alt: 'All-on-4 protocol for complete arch rehabilitation on implants',
    title: 'All-on-4/6 Protocol',
    text: 'Full arch rehabilitation with just 4 to 6 strategically positioned implants. Complete fixed prosthesis with excellent value.',
    details: [
      { label: 'What it is:', text: 'A complete fixed prosthesis for an entire arch (upper or lower) supported by 4 to 6 strategically positioned implants. Posterior implants are angled to maximize available bone.' },
      { label: 'When indicated:', text: "Total or near-total tooth loss in an arch, dissatisfaction with removable dentures, or cases where individual implants for each tooth aren't feasible." },
      { label: 'Material:', text: 'Special implants (some angled) + high-resistance acrylic or zirconia prosthesis with internal metal framework.' },
      { label: 'Timeframe:', text: 'Provisional prosthesis placed as planned; definitive prosthesis after 4 to 6 months.' },
      { label: 'Advantages:', text: 'Excellent value requiring fewer implants. Fully fixed prosthesis, superior comfort to dentures, secure chewing, and restored self-confidence.' },
    ],
  },
  {
    img: '/lovable-uploads/overdenture-clips-retencao.webp',
    alt: 'Overdenture removable prosthesis stabilized by dental implants',
    title: 'Overdenture',
    text: 'Removable prosthesis with precision attachment over 2 to 4 implants. Superior stability and retention compared to conventional dentures with accessible investment.',
    details: [
      { label: 'What it is:', text: 'A removable complete prosthesis that snaps with precision onto 2 to 4 implants through clip systems (bar or o-ring). Combines implant stability with easy removal for cleaning.' },
      { label: 'When indicated:', text: "When the patient wants more stability than a conventional denture but prefers a removable prosthesis for easier cleaning, or when a fixed protocol isn't feasible." },
      { label: 'Material:', text: '2 to 4 titanium implants + acrylic prosthesis with bar-type or o-ring (locator) attachment system.' },
      { label: 'Timeframe:', text: '4 to 6 months.' },
      { label: 'Advantages:', text: "Much more stable than a conventional denture, doesn't come loose when speaking or chewing. Removable for easy hygiene. Lower investment compared to fixed protocol. Restores confidence and comfort." },
    ],
  },
];

// Process Timeline — verbatim (nota: "Duração:" é hardcoded no componente React mesmo em EN)
const timelineSteps = [
  { number: 1, title: 'Evaluation & Exam Requisition', description: 'Complete clinical exam, arch digitization with 3D oral scanner, detailed case study, and imaging exam requisition for precise treatment planning.', iconName: 'scan', duration: '1 visit' },
  { number: 2, title: 'Implant Placement with Millimetric Precision', description: 'Minimally invasive technique when indicated, reducing discomfort and accelerating recovery. Provisional prosthesis in selected cases, according to the defined plan.', iconName: 'activity', duration: '1-2 hours' },
  { number: 3, title: 'Osseointegration Period', description: 'We await the biological union between titanium and bone (3 to 6 months). During this period, you wear a provisional prosthesis when needed. Periodic follow-up to monitor healing and integration.', iconName: 'clock', duration: '3-6 months' },
  { number: 4, title: 'Digital Impression & Definitive Prosthesis', description: 'Impression with iTero Element 5D or conventional method. Fabrication of the definitive prosthesis in pure ceramic with natural color, shape, and translucency. Placement and final adjustments for comfort and natural aesthetics.', iconName: 'check', duration: '2-3 visits' },
  { number: 5, title: 'Maintenance & Monitoring', description: 'Personalized hygiene protocol and periodic check-ups (initially every 6 months). Peri-implant health monitoring, necessary adjustments, and guidance for treatment longevity.', iconName: 'heart', duration: 'Every 6 months' },
];

// Related Treatments (InternalLinkingOptimizer → 'en-dental-implants')
const relatedLinks = [
  { title: 'Dental Prosthetics', url: '/en/dental-prosthetics', description: 'Crowns and fixed prostheses on implants' },
  { title: 'Gum Health', url: '/en/gum-health', description: 'Essential foundation for implant success' },
  { title: 'General Dentistry', url: '/en/general-dentistry', description: 'Assessment and preventive care' },
];
---

<SiteLayout
  title="Dental Implants in Ipanema | Dra. Carla Christoph, Rio de Janeiro"
  description="Dental implant placement with 3D digital planning in Ipanema. Biocompatible titanium implants, minimally invasive techniques. Dra. Carla Christoph, CRO-RJ 27.509."
  canonical="https://dracarlachristoph.com/en/dental-implants"
  preloadImage="/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp"
  schemas={schemas}
  lang="en"
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="pt-BR" href="https://dracarlachristoph.com/implantes-dentarios" />
    <link rel="alternate" hreflang="en" href="https://dracarlachristoph.com/en/dental-implants" />
    <link rel="alternate" hreflang="x-default" href="https://dracarlachristoph.com/implantes-dentarios" />
  </Fragment>

  <main id="main-content" class="pg-implants">
    <!-- Hero -->
    <section class="t-hero" aria-label="Treatment hero">
      <div class="t-hero-inner">
        <div class="t-hero-grid">
          <div class="t-hero-content">
            <nav class="t-bc" aria-label="Breadcrumb">
              <a href="/en">Home</a>
              <span class="t-bc-sep" set:html={icon('chevright', 14)} />
              <a href="/en">Treatments</a>
              <span class="t-bc-sep" set:html={icon('chevright', 14)} />
              <span class="t-bc-cur">Dental Implants</span>
            </nav>
            <h1 class="treatment-hero-title">Dental Implants &amp; Oral Rehabilitation</h1>
            <p class="t-hero-sub">Specialty of Dr. Carla Christoph</p>
            <p class="treatment-hero-description">Restore chewing function, natural aesthetics, and confidence with biocompatible titanium implants. 3D digital planning and minimally invasive techniques for predictable, lasting results.</p>
            <div class="t-badges">
              <span class="t-badge">20+ years of experience</span>
              <span class="t-badge">CRO-RJ 27.509</span>
              <span class="t-badge">iTero Element 5D</span>
            </div>
            <div class="t-hero-cta">
              <a
                class="btn-hero js-wa-cta"
                data-label="en_dental_implants_hero_whatsapp"
                href={waHero}
                target="_blank"
                rel="noopener"
                aria-label="Schedule consultation via WhatsApp"
              >
                <span class="i" set:html={icon('calendar', 20)} />
                Book Your Consultation
              </a>
            </div>
          </div>
          <div class="t-hero-imgcol">
            <div class="t-hero-imgframe">
              <img
                src="/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp"
                alt="Dr. Carla Christoph - Dental Implants & Oral Rehabilitation Specialist"
                width="800"
                height="1200"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Quick Answer Box -->
    <section class="qa-section">
      <div class="cc">
        <div class="quick-answer-box">
          <span class="qa-icon" set:html={icon('check2', 24)} />
          <div>
            <h2>Quick Answer</h2>
            <p>Dental implants are artificial titanium roots placed in the bone to replace missing teeth. At Dr. Carla Christoph's practice in Ipanema, we perform 3D digital planning with iTero Element 5D, minimally invasive techniques, and personalized prostheses. With over 20 years of experience (CRO-RJ 27.509), we offer everything from single implants to complete rehabilitations like All-on-4 and fixed protocols, with treatments lasting 3 to 6 months depending on the case.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Empathetic Pain Points -->
    <section class="pp-section">
      <div class="mw-4xl">
        <h2 class="pp-title">Do you relate to any of these situations?</h2>
        <div class="pp-list">
          <div class="pp-item b-purple">
            <span class="pp-icon c-purple" set:html={icon('shield', 24)} />
            <div>
              <strong>You avoid certain hard foods</strong>
              <span>for fear of hurting your gums or your removable denture coming loose?</span>
            </div>
          </div>
          <div class="pp-item b-gold">
            <span class="pp-icon c-gold" set:html={icon('alert', 24)} />
            <div>
              <strong>You feel insecure with a denture that loosens when speaking</strong>
              <span>or that requires adhesive daily?</span>
            </div>
          </div>
          <div class="pp-item b-purple-soft">
            <span class="pp-icon c-purple-soft" set:html={icon('activity', 24)} />
            <div>
              <strong>You notice progressive bone loss</strong>
              <span>and fear the situation will worsen over time, making treatment more difficult in the future?</span>
            </div>
          </div>
        </div>
        <p class="pp-conclusion">Dental implants restore the confidence to eat, speak, and smile without worry.<br class="md-only" /> Let's evaluate the best solution for your case.</p>
        <div class="pp-callout-wrap">
          <div class="pp-callout">
            <span class="pp-callout-icon c-gold" set:html={icon('clock', 20)} />
            <div>
              <p class="pp-callout-title">Important</p>
              <p class="pp-callout-text">Bone loss accelerates after extraction — the longer you go without a tooth, the more bone is lost, potentially requiring grafting. Early treatment preserves your natural bone structure.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="divider"><span class="d-line"></span><span class="d-circle" set:html={icon('cpu', 20)} /><span class="d-line"></span></div>

    <!-- 4 Implant Modality Cards -->
    <section class="mod-section">
      <div class="mw-6xl">
        <div class="sec-head">
          <h2>Available Dental Implant Options</h2>
          <p>Each technique is recommended based on individual characteristics. Learn about the options.</p>
        </div>
        <div class="mod-grid">
          {modalityCards.map((card) => (
            <div class="mod-card">
              <div class="mod-img">
                <img src={card.img} alt={card.alt} width="800" height="800" loading="lazy" decoding="async" />
                <div class="mod-overlay"></div>
                <div class="mod-text">
                  <h3>{card.title}</h3>
                  <p>{card.text}</p>
                </div>
              </div>
              <div class="mod-acc">
                <details>
                  <summary>See Full Details <span class="chev" set:html={icon('chevdown', 16)} /></summary>
                  <div class="mod-acc-body">
                    {card.details.map((d) => (
                      <div>
                        <p class="mod-acc-label">{d.label}</p>
                        <p class="mod-acc-text">{d.text}</p>
                      </div>
                    ))}
                  </div>
                </details>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Mid CTA -->
    <section class="mid-cta">
      <div class="mw-3xl">
        <p>Want to know which modality fits your case?</p>
        <a
          class="btn-gold js-wa-cta"
          data-label="en_dental_implants_mid_whatsapp"
          href={waMid}
          target="_blank"
          rel="noopener"
        >
          Book Your Evaluation
          <span class="i" set:html={icon('arrow', 20)} />
        </a>
      </div>
    </section>

    <div class="divider"><span class="d-line"></span><span class="d-circle" set:html={icon('sparkles', 20)} /><span class="d-line"></span></div>

    <!-- Treatment Differentiators -->
    <section class="diff-section">
      <div class="mw-5xl">
        <div class="sec-head">
          <h2>What Sets Our Treatment Apart</h2>
          <p>How we work to deliver safety and predictability</p>
        </div>
        <div class="diff-grid">
          <div class="diff-card">
            <span class="diff-icon" set:html={icon('scan', 48)} />
            <h3>3D Digital Planning</h3>
            <p>Use of technologies like 3D oral scanner to assist in implant positioning and prosthesis fabrication.</p>
          </div>
          <div class="diff-card">
            <span class="diff-icon" set:html={icon('shield', 48)} />
            <h3>Internationally Recognized Implants</h3>
            <p>We work with globally recognized brands, featuring treated surfaces that promote osseointegration and long-term scientific validation.</p>
          </div>
          <div class="diff-card">
            <span class="diff-icon" set:html={icon('heart', 48)} />
            <h3>Ongoing Follow-Up</h3>
            <p>Personalized maintenance protocol with periodic check-ups to ensure peri-implant health and maximum longevity.</p>
          </div>
        </div>
      </div>
    </section>

    <div class="divider"><span class="d-line"></span><span class="d-circle" set:html={icon('activity', 20)} /><span class="d-line"></span></div>

    <!-- Process Timeline -->
    <section class="tl-section">
      <div class="mw-6xl">
        <div class="sec-head">
          <h2>Treatment Journey: From Planning to Your Complete Smile</h2>
          <p>Each step is carefully executed for predictable results</p>
        </div>
        <div class="timeline" role="list">
          <div class="tl-vline" aria-hidden="true"></div>
          <div class="tl-steps">
            {timelineSteps.map((step) => (
              <div class="tl-step" role="listitem">
                <div class="tl-num-col">
                  <div class="tl-num">{step.number}</div>
                  <div class="tl-dot" aria-hidden="true"></div>
                </div>
                <div class="tl-content">
                  <span class="tl-icon" set:html={icon(step.iconName, 24)} />
                  <h3>{step.title}</h3>
                  <p>{step.description}</p>
                  <p class="tl-duration">Duração: {step.duration}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <div class="divider"><span class="d-line"></span><span class="d-circle" set:html={icon('award', 20)} /><span class="d-line"></span></div>

    <!-- Doctor Bio -->
    <section class="bio-section">
      <div class="cc">
        <h2 class="bio-title">Dr. Carla Christoph</h2>
        <div class="mw-5xl">
          <div class="bio-grid">
            <div class="bio-photo">
              <div class="bio-photo-frame">
                <img
                  src="/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp"
                  alt="Dr. Carla Christoph - Dental Specialist"
                  width="800"
                  height="1200"
                  loading="lazy"
                  decoding="async"
                />
                <div class="bio-badge">20+ Years of Experience</div>
              </div>
            </div>
            <div class="bio-card">
