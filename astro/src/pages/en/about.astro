---
/**
 * /en/about — Porte fiel de src/pages/en/EnAboutPage.tsx.
 *
 * - title/description: copiados de scripts/generate-static-meta.cjs (englishPages['/en/about']).
 * - Schema Dentist: copiado VERBATIM do structuredData do EnAboutPage.tsx.
 * - hreflang: copiado do SEOHead do React (pt-BR /sobre, en /en/about, x-default /sobre).
 * - CTA WhatsApp: label do React = sendGCLIDToWebhook('en_about_page_button').
 * - Header fixo → primeira seção compensa com padding-top 112px.
 * - Foto da doutora = LCP da página → eager + fetchpriority high + preload.
 *   Dimensões reais: 800x1200 (React declarava 500x625).
 */
import SiteLayout from '../../layouts/SiteLayout.astro';

const WA_HREF = "https://wa.me/5521993304045?text=Hello!%20I'd%20like%20to%20book%20an%20appointment.";

// Schema copiado VERBATIM de EnAboutPage.tsx (structuredData)
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Dentist",
  "name": "Dr. Carla Christoph",
  "url": "https://dracarlachristoph.com/en/about",
  "image": "https://dracarlachristoph.com/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp",
  "description": "Dental specialist in Ipanema, Rio de Janeiro with 20+ years of experience in prosthodontics and implant dentistry.",
  "medicalSpecialty": ["Prosthodontics", "Dental Implants", "Cosmetic Dentistry"],
  "hasCredential": [
    {
      "@type": "EducationalOccupationalCredential",
      "credentialCategory": "Professional License",
      "recognizedBy": {
        "@type": "Organization",
        "name": "Conselho Regional de Odontologia do Rio de Janeiro (CRO-RJ)"
      },
      "identifier": "CRO-RJ 27.509"
    }
  ],
  "knowsAbout": [
    "Porcelain Veneers",
    "Dental Implants",
    "Dental Prosthetics",
    "Teeth Whitening",
    "Orthodontics",
    "Cosmetic Dentistry",
    "Oral Rehabilitation"
  ],
  "worksFor": {
    "@type": "Dentist",
    "name": "Dr. Carla Christoph — Dental Clinic",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Rua Visconde de Pirajá, 550 - Suite 1107",
      "addressLocality": "Ipanema, Rio de Janeiro",
      "addressRegion": "RJ",
      "postalCode": "22410-901",
      "addressCountry": "BR"
    }
  },
  "sameAs": [
    "https://instagram.com/dracarlachristoph"
  ]
};

const schemas = [JSON.stringify(structuredData)];
---
<SiteLayout
  title="About Dra. Carla Christoph | Dentist in Ipanema, Rio de Janeiro"
  description="Meet Dra. Carla Christoph: dental prosthetics and implantology specialist in Ipanema with 20+ years of experience. CRO-RJ 27.509."
  canonical="https://dracarlachristoph.com/en/about"
  preloadImage="/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp"
  schemas={schemas}
  lang="en"
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="pt-BR" href="https://dracarlachristoph.com/sobre" />
    <link rel="alternate" hreflang="en" href="https://dracarlachristoph.com/en/about" />
    <link rel="alternate" hreflang="x-default" href="https://dracarlachristoph.com/sobre" />
  </Fragment>

  <main id="main-content">
    <section class="about-page">
      <div class="container">
        <!-- Header -->
        <div class="page-head">
          <h1 class="heading-lg">About Dr. Carla Christoph</h1>
          <div class="gold-sep" role="none"></div>
          <p class="page-sub">
            Over 20 years dedicated to cosmetic and restorative dentistry.
          </p>
        </div>

        <!-- Bio Section -->
        <div class="bio-grid">
          <div>
            <img
              class="bio-img"
              src="/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp"
              alt="Dr. Carla Christoph - Dentist in Ipanema"
              width="800"
              height="1200"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>

          <div class="bio-text">
            <div>
              <h2 class="bio-h2">Background &amp; Training</h2>
              <p class="bio-p">
                Dr. Carla Christoph is a board-certified dental specialist in <strong>prosthodontics</strong> and <strong>implant dentistry</strong>, registered with the Regional Dental Council of Rio de Janeiro (CRO-RJ 27.509), with over two decades of clinical experience.
              </p>
            </div>

            <div>
              <h3 class="bio-h3">8 Years in the Brazilian Navy</h3>
              <p class="bio-p">
                Before establishing her private practice in Ipanema, Dr. Carla served as a dental officer in the Brazilian Navy for 8 years — an experience that shaped her precision, discipline, and commitment to patient care.
              </p>
            </div>

            <div>
              <h3 class="bio-h3">Philosophy of Care</h3>
              <p class="bio-p">
                Every appointment is a minimum of 1 hour. This isn't a marketing promise — it's a philosophy. Patients deserve time for their dentist to listen, examine thoroughly, explain options clearly, and plan without pressure. No assembly lines, no conveyor belt dentistry.
              </p>
            </div>
          </div>
        </div>

        <!-- Credentials -->
        <div class="cred-grid">
          <div class="cred-card">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
            <p class="cred-label">20+ Years</p>
            <p class="cred-sub">Clinical Experience</p>
          </div>
          <div class="cred-card">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22V8"/><path d="M5 12H2a10 10 0 0 0 20 0h-3"/><circle cx="12" cy="5" r="3"/></svg>
            <p class="cred-label">8 Years</p>
            <p class="cred-sub">Brazilian Navy</p>
          </div>
          <div class="cred-card">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6 6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/><path d="M8 15v1a6 6 0 0 0 6 6 6 6 0 0 0 6-6v-4"/><circle cx="20" cy="10" r="2"/></svg>
            <p class="cred-label">CRO-RJ</p>
            <p class="cred-sub">27.509</p>
          </div>
          <div class="cred-card">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><path d="M7 12h10"/></svg>
            <p class="cred-label">iTero 5D</p>
            <p class="cred-sub">Digital Scanner</p>
          </div>
        </div>

        <!-- CTA -->
        <div class="page-cta">
          <h2 class="cta-h2">Book Your Appointment</h2>
          <p class="cta-p">
            Located in Ipanema, Rua Visconde de Pirajá, 550 – Suite 1107.
          </p>
          <a
            class="btn-gold js-wa-cta"
            data-label="en_about_page_button"
            href={WA_HREF}
            target="_blank"
            rel="noopener"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
            Book on WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .about-page {
    /* section-spacing + compensação do header fixo (~112px, ver PATTERNS.md §1.1) */
    padding-top: 112px;
    padding-bottom: 64px;
  }
  @media (min-width: 768px) {
    .about-page { padding-bottom: 80px; }
  }
  @media (min-width: 1024px) {
    .about-page { padding-bottom: 96px; }
  }
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }
  @media (min-width: 1024px) {
    .container { padding: 0 32px; }
  }

  .page-head {
    max-width: 48rem;
    margin: 0 auto 48px;
    text-align: center;
  }
  .heading-lg {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: 1.875rem;
    color: var(--dental-purple);
    margin-bottom: 16px;
  }
  @media (min-width: 768px) {
    .heading-lg { font-size: 2.25rem; }
  }
  .gold-sep {
    width: 96px;
    height: 4px;
    background: var(--dental-gold);
    margin: 0 auto 24px;
  }
  .page-sub { color: #525252; }

  .bio-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
    max-width: 64rem;
    margin: 0 auto 64px;
  }
  @media (min-width: 768px) {
    .bio-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .bio-img {
    width: 100%;
    border-radius: 16px;
    box-shadow: 0 10px 40px -10px rgb(56 31 71 / 0.2); /* shadow-elegant */
  }
  .bio-text {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .bio-h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--dental-purple);
    margin-bottom: 12px;
  }
  .bio-h3 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--dental-purple);
    margin-bottom: 8px;
  }
  .bio-p {
    color: #525252;
    line-height: 1.625;
  }

  .cred-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    max-width: 56rem;
    margin: 0 auto 48px;
  }
  @media (min-width: 768px) {
    .cred-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .cred-card {
    text-align: center;
    background: #fff;
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 4px 20px hsl(0 0% 0% / 0.08); /* shadow-soft */
  }
  .cred-card svg {
    color: var(--dental-gold);
    margin: 0 auto 12px;
    display: block;
  }
  .cred-label {
    font-family: 'Playfair Display', Georgia, serif;
    color: var(--dental-purple);
    font-size: 1.125rem;
  }
  .cred-sub {
    color: #525252;
    font-size: 0.875rem;
  }

  .page-cta {
    max-width: 42rem;
    margin: 0 auto;
    text-align: center;
  }
  .cta-h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--dental-purple);
    margin-bottom: 16px;
  }
  .cta-p { color: #525252; margin-bottom: 24px; }
  .btn-gold {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--dental-gold);
    color: #fff;
    border-radius: 6px;
    padding: 24px 32px;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .btn-gold:hover { background: rgb(179 149 95 / 0.9); }
</style>
