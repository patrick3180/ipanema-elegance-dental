---
/**
 * /en/orthodontics — porte fiel de src/pages/en/EnOrthodonticsPage.tsx (SPA React).
 * Ortodontia = Dr. Bruno (nunca "Dr. Bruno Christoph"); Dra. Carla supervisiona a jornada.
 * Copy verbatim; schemas copiados da página React; tracking via js-wa-cta (handler global do Base).
 */
import SiteLayout from '../../layouts/SiteLayout.astro';

const WA = 'https://wa.me/5521993304045';
const heroWaHref = `${WA}?text=${encodeURIComponent('Hello! I would like to schedule a consultation about Modern Orthodontics in Ipanema.')}`;
const finalWaHref = `${WA}?text=${encodeURIComponent("Hello! I'd like to schedule an orthodontic evaluation with Dr. Bruno.")}`;
const floatWaHref = `${WA}?text=${encodeURIComponent("Hello! I'd like to book an appointment.")}`;

const faqs = [
  { q: "How does orthodontic treatment work at Dr. Carla's office?", a: "Dr. Carla Christoph's office offers specialized orthodontic treatment through Dr. Bruno Moreira das Neves, an orthodontist with a PhD from UERJ. Dr. Carla oversees the entire patient journey, ensuring integrated and personalized care." },
  { q: "How long does Invisalign® treatment take?", a: "Invisalign® treatment typically lasts 6 to 18 months for simple to moderate cases, and may extend up to 24 months for complex cases. With the iTero Element 5D, we can digitally simulate the result and accurately estimate the time needed." },
  { q: "What is the ideal age to start orthodontic treatment?", a: "The first orthodontic evaluation is recommended at age 7 to identify problems early. For fixed braces, the ideal age is between 11-14 years. Adults of any age can undergo orthodontics — we have patients over 60." },
  { q: "Does orthodontic treatment hurt?", a: "It's normal to feel mild pressure for the first 2-3 days after placing a new Invisalign® aligner or after braces adjustments. The discomfort is temporary and easily managed with over-the-counter pain medication if needed." },
  { q: "Can I eat everything with braces?", a: "With Invisalign®, you remove the aligners to eat, so you can enjoy any food without restrictions. With fixed braces (aesthetic or traditional), hard and sticky foods should be avoided." },
  { q: "How does the iTero Element 5D work?", a: "The iTero Element 5D eliminates the need for traditional impressions with putty. In just a few minutes, we create an ultra-precise 3D model of your teeth, and you immediately see a simulation of the expected result." },
  { q: "What's the difference between aesthetic and traditional braces?", a: "Aesthetic braces use clear brackets, making them much more discreet. Both have the same effectiveness, but aesthetic braces offer a better appearance. Traditional braces are more durable and have a lower cost." },
  { q: "What is retention and why is it important?", a: "Retention is essential to maintain results after treatment. We offer fixed and/or removable retainers, ensuring your teeth stay aligned permanently." },
  { q: "Does Invisalign® work for complex cases?", a: "Yes! Invisalign® has evolved greatly and now treats everything from simple to complex cases, including crossbites and severe crowding. With Dr. Bruno's experience, we can resolve most cases." },
  { q: "How is follow-up during treatment?", a: "We schedule regular appointments to monitor progress and make necessary adjustments. Dr. Carla and Dr. Bruno work together, ensuring unhurried care with attention to detail." },
  { q: "What is the investment for orthodontic treatment?", a: "The investment varies depending on the type of braces and case complexity. We offer flexible payment plans and special conditions. A personalized quote is provided during the evaluation." },
  { q: "Can I switch from fixed braces to Invisalign® during treatment?", a: "Yes, it's possible to make the transition if you're not satisfied with fixed braces. Dr. Bruno will evaluate your case and determine the best time for the switch, aiming for more comfort and aesthetics." },
];

const schemas = [
  JSON.stringify({
    "@context": "https://schema.org", "@type": "MedicalProcedure",
    "name": "Orthodontic Treatment", "description": "Correction of tooth and jaw positioning using orthodontic appliances or invisible aligners",
    "procedureType": "Orthodontic", "bodyLocation": "Teeth and Jaw", "inLanguage": "en",
    "followup": "Monthly appointments and post-treatment retention",
    "howPerformed": "Fixed braces, aesthetic braces, or Invisalign removable aligners with digital planning",
    "preparation": "Clinical evaluation, X-rays, and iTero Element 5D scanning",
    "provider": [
      { "@type": "Dentist", "name": "Dr. Carla Christoph", "identifier": "CRO-RJ 27.509" },
      { "@type": "Dentist", "name": "Dr. Bruno Moreira das Neves", "identifier": "CRO-RJ 41.684", "description": "Specialist orthodontist, PhD from UERJ" }
    ],
    "typicalAgeRange": "7-99"
  }),
  JSON.stringify({
    "@context": "https://schema.org", "@type": "FAQPage", "inLanguage": "en",
    "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  }),
  JSON.stringify({
    "@context": "https://schema.org", "@type": "WebPage",
    "name": "Modern Orthodontics in Ipanema",
    "url": "https://dracarlachristoph.com/en/orthodontics",
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".treatment-hero-title", ".treatment-hero-description", ".quick-answer-box"] },
    "inLanguage": "en"
  }),
  JSON.stringify({ "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://dracarlachristoph.com/en" },
    { "@type": "ListItem", "position": 2, "name": "Treatments", "item": "https://dracarlachristoph.com/en" },
    { "@type": "ListItem", "position": 3, "name": "Orthodontics" }
  ] }),
];
---

<SiteLayout
  title="Orthodontics in Ipanema | Dr. Bruno Neves & Dr. Carla Christoph, Rio de Janeiro"
  description="Invisalign, ceramic braces, and traditional orthodontics in Ipanema. iTero 5D digital scanner for precise treatment planning. Dr. Bruno Neves & Dr. Carla Christoph."
  canonical="https://dracarlachristoph.com/en/orthodontics"
  preloadImage="/lovable-uploads/DrBruno_site.webp"
  schemas={schemas}
  lang="en"
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="pt-BR" href="https://dracarlachristoph.com/ortodontia" />
    <link rel="alternate" hreflang="en" href="https://dracarlachristoph.com/en/orthodontics" />
    <link rel="alternate" hreflang="x-default" href="https://dracarlachristoph.com/ortodontia" />
  </Fragment>

  <main id="main-content" class="en-page">
    <!-- ═══ Treatment Hero ═══ -->
    <section class="hero" aria-label="Treatment hero">
      <div class="content-container section-spacing">
        <div class="hero-grid">
          <div class="hero-content">
            <nav class="breadcrumb" aria-label="breadcrumb">
              <ol>
                <li><a href="/en">Home</a></li>
                <li class="sep" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></li>
                <li><a href="/en">Treatments</a></li>
                <li class="sep" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></li>
                <li><span class="current" aria-current="page">Orthodontics</span></li>
              </ol>
            </nav>

            <h1 class="treatment-hero-title">Modern Orthodontics in Ipanema</h1>
            <p class="hero-subtitle">Align Your Smile with Technology and Expertise</p>
            <p class="hero-desc treatment-hero-description">Specialized orthodontic treatment using advanced technology like iTero Element 5D and Invisalign® for comfort and precision in your treatment.</p>

            <div class="hero-badges">
              <span class="badge">Invisalign®</span>
              <span class="badge">PhD from UERJ</span>
              <span class="badge">iTero Element 5D</span>
            </div>

            <div class="hero-cta-wrap">
              <a
                class="hero-cta js-wa-cta"
                data-label="en-orthodontics_hero_whatsapp"
                href={heroWaHref}
                target="_blank"
                rel="noopener"
                aria-label="Schedule consultation via WhatsApp"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                Book Your Consultation
              </a>
            </div>
          </div>

          <div class="hero-image-col">
            <div class="hero-image-frame">
              <img
                src="/lovable-uploads/DrBruno_site.webp"
                alt="Dr. Carla Christoph - Modern Orthodontics in Ipanema Specialist"
                width="434"
                height="575"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ Quick Answer ═══ -->
    <section class="qa-section">
      <div class="container-custom">
        <div class="quick-answer-box">
          <div class="qa-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <div>
            <h2 class="qa-title">Quick Answer</h2>
            <p class="qa-text">Orthodontics is the specialty that corrects tooth positioning. At Dr. Carla's office, treatment is performed by Dr. Bruno Moreira, an orthodontist with a PhD from UERJ. Dr. Carla oversees the patient journey, ensuring integration. We use the iTero Element 5D for planning and offer Invisalign® or aesthetic braces with treatment lasting between 6 to 24 months.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Divider (alert) -->
    <div class="divider" aria-hidden="true">
      <div class="divider-line"></div>
      <div class="divider-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg></div>
      <div class="divider-line"></div>
    </div>

    <!-- ═══ Empathetic Pain Points ═══ -->
    <section class="pain-section">
      <div class="pain-container">
        <h2 class="pain-title">Do you think you're "too old" to straighten your teeth?</h2>
        <div class="pain-list">
          <div class="pain-card" style="border-left-color: var(--dental-purple);">
            <div class="pain-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--dental-purple)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
            <div>
              <strong>Professionals who need discretion</strong>
              <span>Invisalign® doesn't interfere with meetings, presentations, or social situations — it's nearly invisible.</span>
            </div>
          </div>
          <div class="pain-card" style="border-left-color: var(--dental-gold);">
            <div class="pain-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
            </div>
            <div>
              <strong>Adults who avoid metal braces</strong>
              <span>But feel uncomfortable with crooked teeth in professional and social settings.</span>
            </div>
          </div>
          <div class="pain-card" style="border-left-color: var(--dp-soft);">
            <div class="pain-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--dp-soft)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
            </div>
            <div>
              <strong>There's no age limit for orthodontics</strong>
              <span>We treat patients over 60 years old with consistent functional and aesthetic results.</span>
            </div>
          </div>
        </div>
        <p class="pain-conclusion">Adult orthodontics is one of the fastest-growing specialties.<br class="md-only" /> Straightening your teeth improves aesthetics, chewing, and your oral health.</p>
      </div>
    </section>

    <!-- Divider (sparkles) -->
    <div class="divider" aria-hidden="true">
      <div class="divider-line"></div>
      <div class="divider-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg></div>
      <div class="divider-line"></div>
    </div>

    <!-- ═══ Treatment Options — 3 Cards ═══ -->
    <section class="options-section">
      <div class="container-custom">
        <h2 class="heading-lg options-heading">Orthodontic Treatment Options</h2>
        <div class="options-grid">
          <!-- Invisalign -->
          <div class="option-card option-featured">
            <div class="option-icon" style="background: rgb(56 31 71 / 0.1);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--dental-purple)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
            <h3>Invisalign®</h3>
            <p>Clear removable aligners, nearly invisible. Maximum comfort.</p>
            <ul class="option-list">
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg> Nearly invisible</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg> Remove to eat</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg> Easy hygiene</li>
            </ul>
          </div>
          <!-- Aesthetic Braces -->
          <div class="option-card option-gold">
            <div class="option-icon" style="background: rgb(179 149 95 / 0.2);">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
            </div>
            <h3>Aesthetic Braces</h3>
            <p>Sapphire or clear porcelain brackets. Discreet and effective.</p>
            <ul class="option-list">
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg> Discreet and elegant</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg> Stain-resistant</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg> Great cost-benefit</li>
            </ul>
          </div>
          <!-- Traditional Braces -->
          <div class="option-card option-gray">
            <div class="option-icon" style="background: #e5e7eb;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4b5563" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3>Traditional Braces</h3>
            <p>Conventional metal brackets. Effective solution for all types of correction.</p>
            <ul class="option-list">
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg> Most affordable</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg> Very durable</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg> Proven effectiveness</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ Comparison Table ═══ -->
    <section class="compare-section">
      <div class="container-custom">
        <h2 class="heading-lg compare-heading">Detailed Comparison of Options</h2>
        <div class="compare-wrap">
          <div class="compare-block">
            <h3 class="compare-sub">Comparação</h3>
            <div class="table-scroll">
              <table class="compare-table">
                <thead>
                  <tr>
                    <th class="th-left">Critério</th>
                    <th>Invisalign®</th>
                    <th>Aesthetic Braces</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="even"><td class="td-crit">Visibility</td><td>Nearly invisible</td><td>Discreet (clear brackets)</td></tr>
                  <tr><td class="td-crit">Removable</td><td>Yes - for eating &amp; hygiene</td><td>No - fixed to teeth</td></tr>
                  <tr class="even"><td class="td-crit">Comfort</td><td>Maximum - no wires or brackets</td><td>Moderate - smooth brackets</td></tr>
                  <tr><td class="td-crit">Oral Hygiene</td><td>Easy - remove to brush</td><td>Requires extra care</td></tr>
                  <tr class="even"><td class="td-crit">Treatment Duration</td><td>6-18 months (simple cases)</td><td>12-24 months</td></tr>
                  <tr><td class="td-crit">Appointments</td><td>Every 6-8 weeks</td><td>Monthly</td></tr>
                  <tr class="even"><td class="td-crit">Main Indication</td><td>Adults, aesthetic cases</td><td>Teens and adults</td></tr>
                </tbody>
              </table>
            </div>
          </div>
          <p class="compare-note">The ideal appliance depends on your case, lifestyle, and priorities.</p>
        </div>
      </div>
    </section>

    <!-- Divider (award) -->
    <div class="divider" aria-hidden="true">
      <div class="divider-line"></div>
      <div class="divider-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg></div>
      <div class="divider-line"></div>
    </div>

    <!-- ═══ Doctor Bio — Dr. Bruno & Dra. Carla ═══ -->
    <section class="bio-section">
      <div class="container-custom">
        <h2 class="heading-lg bio-heading">Exclusive Integration and Expertise</h2>
        <div class="bio-wrap">
          <div class="bio-grid">
            <div class="bio-photo-col">
              <div class="bio-photo">
                <img
                  src="/lovable-uploads/DrBruno_site.webp"
                  alt="Dr. Bruno Moreira"
                  width="434"
                  height="575"
                  loading="lazy"
                  decoding="async"
                />
                <div class="bio-badge">PhD from UERJ</div>
              </div>
            </div>
            <div class="bio-card">
              <div class="bio-head">
                <h3>Dr. Bruno Moreira das Neves</h3>
                <p class="bio-sub">Specialist Orthodontist | CRO-RJ 41.684</p>
              </div>
              <div class="bio-paras">
                <p>With a solid academic background and extensive clinical experience, Dr. Bruno is responsible for the planning and execution of all advanced orthodontic treatments at our Ipanema office.</p>
                <p>Dr. Carla Christoph (CRO-RJ 27.509), a prosthodontic specialist, supervises and integrates the entire orthodontic journey into the comprehensive health and aesthetic plan for each patient. With this technical partnership, the final visual result is even more stunning with a strong functional foundation.</p>
              </div>
              <div class="bio-creds">
                <div class="bio-creds-grid">
                  <div class="bio-cred">
                    <svg class="cred-check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                    <div><p class="cred-t">PhD</p><p class="cred-d">Doctor of Orthodontics from UERJ</p></div>
                  </div>
                  <div class="bio-cred">
                    <svg class="cred-check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                    <div><p class="cred-t">Invisalign Doctor</p><p class="cred-d">Proficiency in the Invisalign system</p></div>
                  </div>
                  <div class="bio-cred">
                    <svg class="cred-check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                    <div><p class="cred-t">Teaching</p><p class="cred-d">Professor of Orthodontics (IOPUC-Rio)</p></div>
                  </div>
                  <div class="bio-cred">
                    <svg class="cred-check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                    <div><p class="cred-t">Master's</p><p class="cred-d">Master's in Clinical Dentistry (UFF)</p></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Divider (zap) -->
