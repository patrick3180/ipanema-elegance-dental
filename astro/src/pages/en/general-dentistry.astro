---
/**
 * /en/general-dentistry — porte fiel de src/pages/en/EnGeneralDentistryPage.tsx (SPA React).
 * Copy verbatim (espelha o que o React efetivamente RENDERIZA — props inexistentes
 * nos componentes, como títulos dos pain points e heading do timeline, não renderizam
 * no SPA e por isso não aparecem aqui; ver relatório do porte).
 * Schemas copiados da página React; tracking via js-wa-cta (handler global do Base).
 */
import SiteLayout from '../../layouts/SiteLayout.astro';

const WA = 'https://wa.me/5521993304045';
const heroWaHref = `${WA}?text=${encodeURIComponent('Hello! I would like to schedule a consultation about General Dentistry & Preventive Care.')}`;
const finalWaHref = `${WA}?text=${encodeURIComponent("Hello! I'd like to book a dental checkup with Dr. Carla Christoph.")}`;
const floatWaHref = `${WA}?text=${encodeURIComponent("Hello! I'd like to book an appointment.")}`;

const faqs = [
  { q: "What does a dental checkup include?", a: "A comprehensive exam including clinical inspection, digital 3D scan with the iTero Element 5D, risk assessment for cavities and gum disease, professional cleaning (scaling and polishing), and personalized oral hygiene guidance." },
  { q: "How often should I schedule a checkup?", a: "For most adults, every 6 months is recommended. Patients with a history of gum disease or higher cavity risk may benefit from visits every 3-4 months. We'll recommend the right schedule for your needs." },
  { q: "Is professional teeth whitening safe?", a: "When performed by a dental professional, teeth whitening is safe. We use pH-balanced gels with remineralizing agents that protect enamel integrity. In-office treatment can lighten teeth by 4-9 shades." },
  { q: "Does dental cleaning hurt?", a: "Ultrasonic cleaning is very comfortable — most patients describe only a mild vibration. For very sensitive areas, we can apply topical numbing gel." },
  { q: "Do you accept dental insurance?", a: "We are a private practice. This allows us to dedicate proper time to each patient and use only high-quality materials. We provide clear, detailed cost estimates before any treatment begins." },
  { q: "What should I bring to my first appointment?", a: "Bring any recent dental X-rays or records you may have, a list of medications you're currently taking, and your dental insurance card if applicable. If you don't have any of these, no worries — we'll gather everything we need during your visit." },
  { q: "How long does a checkup appointment take?", a: "We dedicate a minimum of 1 hour for every checkup appointment. This ensures enough time for a thorough examination, unhurried cleaning, and proper discussion of findings and any treatment options." },
];

const schemas = [
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MedicalProcedure",
    "name": "General Dentistry and Preventive Care",
    "description": "Comprehensive dental checkup, professional cleaning, teeth whitening, and preventive care in Ipanema, Rio de Janeiro.",
    "procedureType": "Dental",
    "url": "https://dracarlachristoph.com/en/general-dentistry",
    "inLanguage": "en",
    "provider": {
      "@type": "Dentist",
      "name": "Dr. Carla Christoph",
      "telephone": "+5521993304045",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Rua Visconde de Pirajá, 550 - Suite 1107",
        "addressLocality": "Ipanema",
        "addressRegion": "RJ",
        "addressCountry": "BR"
      }
    }
  }),
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "General Dentistry & Prevention in Ipanema",
    "url": "https://dracarlachristoph.com/en/general-dentistry",
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": [".heading-lg", ".heading-md", ".quick-answer-box"]
    },
    "inLanguage": "en"
  }),
];
---

<SiteLayout
  title="General Dentistry in Ipanema | Dra. Carla Christoph, Rio de Janeiro"
  description="Comprehensive dental checkups, cleanings, and preventive care in Ipanema. 3D digital scanner, personalized treatment plans. Dra. Carla Christoph."
  canonical="https://dracarlachristoph.com/en/general-dentistry"
  schemas={schemas}
  lang="en"
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="pt-BR" href="https://dracarlachristoph.com/clinica-geral-e-prevencao" />
    <link rel="alternate" hreflang="en" href="https://dracarlachristoph.com/en/general-dentistry" />
    <link rel="alternate" hreflang="x-default" href="https://dracarlachristoph.com/clinica-geral-e-prevencao" />
  </Fragment>

  <main id="main-content" class="en-page">
    <!-- ═══ Treatment Hero (sem imagem, sem badges — igual ao SPA) ═══ -->
    <section class="hero" aria-label="Treatment hero">
      <div class="content-container section-spacing">
        <div class="hero-grid">
          <div class="hero-content">
            <h1 class="treatment-hero-title">General Dentistry &amp; Preventive Care</h1>
            <p class="hero-subtitle">A routine checkup costs a fraction of what advanced treatments require. Our preventive approach identifies issues while they're still reversible — dedicating a minimum of 1 full hour to every appointment.</p>
            <div class="hero-cta-wrap">
              <a
                class="hero-cta js-wa-cta"
                data-label="en-general-dentistry_hero_whatsapp"
                href={heroWaHref}
                target="_blank"
                rel="noopener"
                aria-label="Schedule consultation via WhatsApp"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                Book Your Consultation
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ Quick Answer Box ═══ -->
    <section class="qa-outer">
      <div class="container-custom qa-narrow">
        <div class="quick-answer-box">
          <div class="qa-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <div>
            <h2 class="qa-title">Quick Answer</h2>
            <p class="qa-text">A comprehensive exam with the iTero Element 5D digital scanner, clinical inspection, professional cleaning (scaling and polishing), risk assessment, and a personalized prevention plan. Every appointment starts with at least 1 full hour of dedicated attention.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Divider (simple) -->
    <div class="divider" aria-hidden="true"><div class="divider-bar"></div></div>

    <!-- ═══ Empathetic Pain Points ═══ -->
    <section class="pain-section">
      <div class="pain-container">
        <h2 class="pain-title">Why Patients Delay Checkups</h2>
        <div class="pain-list">
          <div class="pain-card" style="border-left-color: var(--dental-purple);">
            <div class="pain-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <span>We respect your schedule. Appointments are punctual, efficient, and typically completed within 1 hour — including cleaning and exam.</span>
            </div>
          </div>
          <div class="pain-card" style="border-left-color: var(--dental-gold);">
            <div class="pain-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
            </div>
            <div>
              <span>Most dental problems are painless in the early stages. Cavities, gum disease, and even cracks can develop silently. A checkup catches them before they become costly problems.</span>
            </div>
          </div>
          <div class="pain-card" style="border-left-color: var(--dp-soft);">
            <div class="pain-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
            </div>
            <div>
              <span>We hear this often. That's why we prioritize a calm, unhurried environment. Dr. Carla explains every step before proceeding, and there's never any pressure.</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Divider (simple) -->
    <div class="divider" aria-hidden="true"><div class="divider-bar"></div></div>

    <!-- ═══ Services Offered ═══ -->
    <section class="services-section">
      <div class="container-custom services-narrow">
        <h2 class="heading-md svc-heading">What We Offer</h2>
        <p class="svc-sub">From routine exams to restorative care — all under one roof, with the same attention to detail.</p>
        <div class="svc-grid">
          <div class="svc-card">
            <div class="svc-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/></svg></div>
            <div>
              <h3>Comprehensive Dental Exam</h3>
              <p>Thorough clinical examination, 3D digital scan with iTero Element 5D, and personalized risk assessment.</p>
            </div>
          </div>
          <div class="svc-card">
            <div class="svc-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg></div>
            <div>
              <h3>Professional Dental Cleaning</h3>
              <p>Ultrasonic scaling to remove tartar and plaque buildup, followed by polishing for a clean, fresh feel.</p>
            </div>
          </div>
          <div class="svc-card">
            <div class="svc-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg></div>
            <div>
              <h3>Dental Fillings &amp; Restorations</h3>
              <p>Tooth-colored composite restorations for cavities, chips, or cracks — virtually invisible and durable.</p>
            </div>
          </div>
          <div class="svc-card">
            <div class="svc-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
            <div>
              <h3>Preventive Treatment Plans</h3>
              <p>Individual risk assessment and customized prevention schedules — typically every 6 months for low-risk patients.</p>
            </div>
          </div>
          <div class="svc-card">
            <div class="svc-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg></div>
            <div>
              <h3>Pediatric Dental Care</h3>
              <p>Gentle, age-appropriate dental care for children — building healthy habits and positive associations from an early age.</p>
            </div>
          </div>
          <div class="svc-card">
            <div class="svc-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg></div>
            <div>
              <h3>Oral Health Assessment</h3>
              <p>Comprehensive screening for gum disease, oral lesions, TMJ issues, and bruxism. Early detection is the foundation of effective treatment.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Divider (simple) -->
    <div class="divider" aria-hidden="true"><div class="divider-bar"></div></div>

    <!-- ═══ Why Prevention Matters ═══ -->
    <section class="prevention-section">
      <div class="container-custom prevention-narrow">
        <div class="prev-box">
          <div class="prev-flex">
            <svg class="prev-shield" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
            <div>
              <h2 class="prev-title">Prevention Is Always Better</h2>
              <p class="prev-p">A routine checkup costs a fraction of what advanced treatments like implants or root canals require. More importantly, early detection means less discomfort, fewer procedures, and better long-term outcomes.</p>
              <div class="prev-stats">
                <div class="prev-stat"><span class="ps-v">90%</span><span class="ps-l">of oral diseases are preventable with regular care</span></div>
                <div class="prev-stat"><span class="ps-v">1h</span><span class="ps-l">minimum dedicated to every checkup</span></div>
                <div class="prev-stat"><span class="ps-v">6 mo</span><span class="ps-l">recommended interval for routine visits</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Divider (simple) -->
    <div class="divider" aria-hidden="true"><div class="divider-bar"></div></div>

    <!-- ═══ Process Timeline (sem heading no SPA — porte fiel do render) ═══ -->
    <div class="timeline" role="list">
      <div class="timeline-line" aria-hidden="true"></div>
      <div class="timeline-steps">
        <div class="tl-step" role="listitem">
          <div class="tl-num-col"><div class="tl-num"></div><div class="tl-dot" aria-hidden="true"></div></div>
          <div class="tl-content">
            <div class="tl-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/></svg></div>
            <h3>3D Digital Scan</h3>
            <p>We begin with a complete intraoral scan using the iTero Element 5D — capturing detailed 3D images of your teeth, gums, and bite alignment without radiation or discomfort.</p>
          </div>
        </div>
        <div class="tl-step" role="listitem">
          <div class="tl-num-col"><div class="tl-num"></div><div class="tl-dot" aria-hidden="true"></div></div>
          <div class="tl-content">
            <div class="tl-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg></div>
            <h3>Clinical Examination</h3>
            <p>Dr. Carla performs a thorough clinical inspection of each tooth, checking for cavities, cracks, gum recession, and early signs of oral conditions.</p>
          </div>
        </div>
        <div class="tl-step" role="listitem">
          <div class="tl-num-col"><div class="tl-num"></div><div class="tl-dot" aria-hidden="true"></div></div>
          <div class="tl-content">
            <div class="tl-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg></div>
            <h3>Professional Cleaning</h3>
            <p>Ultrasonic scaling removes tartar and plaque buildup — especially in areas brushing and flossing can't reach — followed by polishing for a smooth, clean finish.</p>
          </div>
        </div>
        <div class="tl-step" role="listitem">
          <div class="tl-num-col"><div class="tl-num"></div><div class="tl-dot" aria-hidden="true"></div></div>
          <div class="tl-content">
            <div class="tl-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
            <h3>Risk Assessment &amp; Plan</h3>
            <p>Based on the findings, we create a personalized prevention plan with the recommended schedule for your next visit and any specific care instructions.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Divider (simple) -->
    <div class="divider" aria-hidden="true"><div class="divider-bar"></div></div>

    <!-- ═══ Technology Callout ═══ -->
    <section class="tech-section">
      <div class="container-custom tech-narrow">
        <div class="tech-flex">
          <div class="tech-text">
            <h2 class="heading-md tech-heading">Digital Precision with iTero Element 5D</h2>
            <p class="tech-p">Our 3D intraoral scanner replaces traditional impressions with a fast, comfortable digital scan. It captures thousands of data points to create a precise model of your teeth and gums — enabling better diagnoses and more accurate treatment planning.</p>
            <ul class="tech-list">
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>No radiation — safe optical technology</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>Instant visualization of bite alignment</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>Early detection of interproximal cavities</li>
              <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>Time-lapse comparison between visits</li>
            </ul>
          </div>
          <div class="tech-visual">
            <div class="tech-visual-inner">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgb(56 31 71 / 0.4)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/></svg>
              <span>iTero Element 5D</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Divider (simple) -->
    <div class="divider" aria-hidden="true"><div class="divider-bar"></div></div>

    <!-- ═══ Doctor Bio ═══ -->
    <section class="bio-section">
      <div class="container-custom">
        <h2 class="heading-lg bio-heading">Your Dentist in Ipanema</h2>
        <div class="bio-wrap">
          <div class="bio-grid">
            <div class="bio-photo-col">
              <div class="bio-photo">
                <img
                  src="/lovable-uploads/dra-carla-jaleco-bracos-cruzados.webp"
                  alt="Dr. Carla Christoph - Dental Specialist"
                  width="800"
                  height="1200"
                  loading="lazy"
                  decoding="async"
                />
                <div class="bio-badge">20+ Years of Experience</div>
              </div>
            </div>
            <div class="bio-card">
              <div class="bio-head">
                <h3>Dr. Carla Christoph</h3>
                <p class="bio-sub">CRO-RJ 27.509 | Specialist in Prosthodontics and Implant Dentistry</p>
              </div>
              <div class="bio-paras">
                <p>Dr. Carla Christoph has dedicated over 20 years to dentistry — with specializations in prosthodontics and implant dentistry (CRO-RJ 27.509) and 8 years of service as a dentist at the Brazilian Navy Central Dental Clinic.</p>
                <p>Her approach to general dentistry is rooted in prevention: every appointment is an opportunity to detect early signs of decay, gum disease, or functional issues before they become costly problems.</p>
                <p>Patients benefit from unhurried consultations (minimum 1 hour), digital diagnostics with iTero Element 5D, and a care plan that integrates every aspect of oral health.</p>
              </div>
              <div class="bio-creds">
                <div class="bio-creds-grid">
                  <div class="bio-cred">
                    <svg class="cred-check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                    <div><p class="cred-t">Brazilian Navy Dentist</p><p class="cred-d">8 years at Odontoclínica Central da Marinha</p></div>
                  </div>
                  <div class="bio-cred">
                    <svg class="cred-check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                    <div><p class="cred-t">Prosthodontics Specialist</p><p class="cred-d">Advanced oral rehabilitation</p></div>
                  </div>
                  <div class="bio-cred">
                    <svg class="cred-check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                    <div><p class="cred-t">20+ Years</p><p class="cred-d">Clinical experience in Ipanema</p></div>
                  </div>
                  <div class="bio-cred">
                    <svg class="cred-check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
                    <div><p class="cred-t">Digital Diagnostics</p><p class="cred-d">iTero Element 5D scanning</p></div>
                  </div>
                </div>
              </div>
              <div class="bio-quote">
                <div class="q-mark q-tl">"</div>
                <div class="q-mark q-br">"</div>
