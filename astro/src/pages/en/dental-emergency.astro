---
/**
 * /en/dental-emergency — porte fiel de src/pages/en/EnDentalEmergencyPage.tsx (SPA React).
 * Copy verbatim; schemas copiados da página React; tracking via js-wa-cta (handler global do Base).
 */
import SiteLayout from '../../layouts/SiteLayout.astro';

const WA = 'https://wa.me/5521993304045';
// Mensagem idêntica à do React (já URL-encoded no componente original)
const emergencyWaHref = `${WA}?text=Hello!%20I%20have%20a%20dental%20emergency%20and%20need%20to%20be%20seen%20as%20soon%20as%20possible.`;
const floatWaHref = `${WA}?text=${encodeURIComponent("Hello! I'd like to book an appointment.")}`;

const faqs = [
  { q: "What should I do if I have a dental emergency in Ipanema?", a: "Contact us via WhatsApp immediately. We accommodate emergency patients during business hours (Monday–Friday, 9 AM–7 PM). Describe your situation and we'll prioritize your appointment." },
  { q: "Can I be seen the same day?", a: "We do our best to accommodate dental emergencies on the same day. Contact us as early as possible to improve your chances of same-day care." },
  { q: "What if my emergency happens after hours or on a weekend?", a: "Send a WhatsApp message anytime — our team responds 24/7 and will book the earliest available slot. In-person emergency care is available Mon–Fri, 9 AM–7 PM (BRT). For life-threatening emergencies (uncontrolled bleeding, facial swelling affecting breathing), go to the nearest hospital ER immediately." },
  { q: "How much does emergency treatment cost?", a: "The cost depends on the type of treatment needed. We provide transparent pricing before any procedure begins. As a private practice, we do not accept insurance, but we ensure you receive dedicated, unhurried care." },
  { q: "I'm visiting Rio as a tourist. Can you help?", a: "Absolutely. We regularly see patients visiting Rio de Janeiro who need urgent dental care. Contact us via WhatsApp and we'll do our best to fit you in quickly." },
];

const schemas = [
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MedicalProcedure",
    "name": "Dental Emergency Care",
    "description": "Urgent dental care for toothache, broken teeth, lost fillings, and dental emergencies in Ipanema, Rio de Janeiro.",
    "procedureType": "Dental",
    "url": "https://dracarlachristoph.com/en/dental-emergency",
    "inLanguage": "en",
    "provider": {
      "@type": "Dentist",
      "name": "Dr. Carla Christoph",
      "telephone": "+5521993304045",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Rua Visconde de Pirajá, 550 - Suite 1107",
        "addressLocality": "Ipanema",
        "addressRegion": "RJ",
        "addressCountry": "BR"
      }
    }
  }),
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Dental Emergency in Ipanema",
    "url": "https://dracarlachristoph.com/en/dental-emergency",
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": [".treatment-hero-title", ".treatment-hero-description", ".quick-answer-box"]
    },
    "inLanguage": "en"
  }),
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "inLanguage": "en",
    "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  }),
];
---

<SiteLayout
  title="Dental Emergency in Ipanema | Dra. Carla Christoph, Rio de Janeiro"
  description="Dental emergency in Ipanema? Toothache, broken tooth, lost filling — contact us via WhatsApp for same-day urgent dental care. Dra. Carla Christoph."
  canonical="https://dracarlachristoph.com/en/dental-emergency"
  schemas={schemas}
  lang="en"
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="pt-BR" href="https://dracarlachristoph.com/emergencia-dental" />
    <link rel="alternate" hreflang="en" href="https://dracarlachristoph.com/en/dental-emergency" />
    <link rel="alternate" hreflang="x-default" href="https://dracarlachristoph.com/emergencia-dental" />
  </Fragment>

  <main id="main-content" class="en-page">
    <!-- ═══ Urgency Hero ═══ -->
    <section class="hero section-spacing">
      <div class="container-custom hero-narrow">
        <div class="hero-title-row">
          <svg class="hero-alert" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
          <h1 class="heading-lg hero-h1">Dental Emergency in Ipanema</h1>
        </div>
        <div class="hero-sep" aria-hidden="true"></div>
        <p class="hero-lead">Toothache, broken tooth, or lost crown? Don't wait — contact us now for same-day urgent care during business hours.</p>
        <p class="hero-credit">Dr. Carla Christoph · CRO-RJ 27.509 · Ipanema, Rio de Janeiro</p>

        <!-- Urgent CTA -->
        <div class="urgent-box">
          <div class="urgent-flex">
            <div class="urgent-info">
              <h2>Need Immediate Help?</h2>
              <div class="urgent-meta">
                <div class="meta-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  <span>Mon–Fri, 9 AM – 7 PM (GMT-3)</span>
                </div>
                <div class="meta-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  <span>Ipanema, Rio de Janeiro</span>
                </div>
              </div>
            </div>
            <a class="wa-btn js-wa-cta" data-label="en_dental_emergency" href={emergencyWaHref} target="_blank" rel="noopener">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
              WhatsApp Now
            </a>
          </div>
          <p class="urgent-note">Send a WhatsApp message anytime — we reply and book your slot 24/7. In-person care is Mon–Fri, 9 AM – 7 PM (BRT). Not a 24-hour emergency clinic; for life-threatening emergencies, go to the nearest hospital ER.</p>
        </div>
      </div>
    </section>

    <!-- ═══ Emergency Types ═══ -->
    <section class="types-section section-spacing">
      <div class="container-custom hero-narrow">
        <h2 class="heading-md types-heading">Common Dental Emergencies</h2>
        <div class="types-list">
          <div class="type-card">
            <h3>Severe Toothache</h3>
            <p class="type-desc">Persistent or throbbing tooth pain that doesn't go away. May indicate infection, deep cavity, or nerve involvement.</p>
            <p class="type-action">Contact us immediately. We'll prioritize your appointment to diagnose the cause and relieve your pain.</p>
          </div>
          <div class="type-card">
            <h3>Broken or Chipped Tooth</h3>
            <p class="type-desc">A fall, accident, or biting on something hard can fracture a tooth, exposing the inner layers.</p>
            <p class="type-action">Save any broken pieces if possible. Rinse your mouth with warm water and contact us for same-day evaluation.</p>
          </div>
          <div class="type-card">
            <h3>Lost Crown or Filling</h3>
            <p class="type-desc">A crown or filling can come loose, leaving the tooth exposed and sensitive.</p>
            <p class="type-action">Avoid chewing on the affected side. Keep the crown if you have it — it may be re-cemented. Contact us promptly.</p>
          </div>
          <div class="type-card">
            <h3>Dental Abscess</h3>
            <p class="type-desc">Swelling, pus, or a bump on the gums near a tooth, often accompanied by fever and pain.</p>
            <p class="type-action">This requires prompt treatment to prevent the infection from spreading. Contact us immediately.</p>
          </div>
          <div class="type-card">
            <h3>Knocked-Out Tooth</h3>
            <p class="type-desc">A tooth completely dislodged from its socket due to trauma.</p>
            <p class="type-action">Handle the tooth by the crown (not the root). If possible, place it back in the socket or keep it in milk. Seek care within 30 minutes.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ Quick Info ═══ -->
    <section class="info-section section-spacing">
      <div class="container-custom hero-narrow">
        <div class="info-grid">
          <div class="info-card">
            <svg class="info-ic" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <h3>Location</h3>
            <p>Rua Visconde de Pirajá, 550<br />Suite 1107 — Ipanema<br />2 blocks from the beach</p>
          </div>
          <div class="info-card">
            <svg class="info-ic" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <h3>Office Hours</h3>
            <p>In-person: Mon – Fri<br />9 AM – 7 PM (BRT)<br />Book via WhatsApp 24/7</p>
          </div>
          <div class="info-card">
            <svg class="info-ic" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--dental-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <h3>Phone</h3>
            <p>+55 (21) 99330-4045<br />WhatsApp &amp; calls<br /><a href="tel:+5521993304045" class="call-link">Call now</a></p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ FAQ ═══ -->
    <section class="faq-section section-spacing">
      <div class="container-custom faq-narrow">
        <h2 class="heading-md faq-heading">Frequently Asked Questions</h2>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}<svg class="acc-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
              <div class="faq-body"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ Bottom CTA ═══ -->
    <section class="bottom-cta section-spacing">
      <div class="container-custom bottom-inner">
        <h2>Don't Wait — Get Help Now</h2>
        <p>Dental emergencies can worsen quickly. Contact us on WhatsApp and we'll do our best to see you as soon as possible.</p>
        <a class="wa-btn js-wa-cta" data-label="en-dental-emergency_final_whatsapp" href={emergencyWaHref} target="_blank" rel="noopener">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
          WhatsApp Now
        </a>
      </div>
    </section>

    <!-- ═══ Related Treatments ═══ -->
    <section class="related-section">
      <div class="related-container">
        <h2 class="related-title">Related Treatments</h2>
        <div class="related-grid">
          <a href="/en/root-canal" class="related-card">
            <span class="rel-t">Root Canal</span>
            <span class="rel-d">Emergency endodontic treatment</span>
            <span class="rel-more">Learn more <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
          </a>
          <a href="/en/dental-implants" class="related-card">
            <span class="rel-t">Dental Implants</span>
            <span class="rel-d">Replacement for lost teeth</span>
            <span class="rel-more">Learn more <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
          </a>
          <a href="/en/general-dentistry" class="related-card">
            <span class="rel-t">General Dentistry</span>
            <span class="rel-d">Follow-up care after emergency</span>
            <span class="rel-more">Learn more <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
          </a>
        </div>
      </div>
    </section>

    <!-- Floating WhatsApp (paridade com WhatsAppButton do SPA) -->
    <a
      class="float-wa js-wa-cta"
      data-label="floating_whatsapp_button"
      href={floatWaHref}
      target="_blank"
      rel="noopener"
      aria-label="Chat on WhatsApp"
    >
      <svg class="pulse" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
      <span class="float-wa-txt">
        <span class="fw-desk">Discuss my case</span>
        <span class="fw-mob">Book</span>
        <span class="fw-sub">WhatsApp 24h</span>
      </span>
    </a>
  </main>
</SiteLayout>

<style>
  /* ── Tokens locais (paridade tailwind.config.ts) ── */
  .en-page {
    --dp-soft: #5a3f69;
    --dp-light: #4a2759;
    --dg-dark: #9d7f4f;
  }

  /* ── Utilitários compartilhados (paridade index.css) ── */
  .container-custom { width: 100%; max-width: 1400px; margin-inline: auto; padding-inline: 1.5rem; }
  @media (min-width: 1024px) { .container-custom { padding-inline: 2rem; } }
  .section-spacing { padding-block: 4rem; }
  @media (min-width: 768px) { .section-spacing { padding-block: 5rem; } }
  @media (min-width: 1024px) { .section-spacing { padding-block: 6rem; } }
  .heading-lg { font-family: 'Playfair Display', Georgia, serif; font-weight: 600; font-size: 1.875rem; line-height: 2.25rem; }
  @media (min-width: 768px) { .heading-lg { font-size: 2.25rem; line-height: 2.5rem; } }
  .heading-md { font-family: 'Playfair Display', Georgia, serif; font-weight: 600; font-size: 1.5rem; line-height: 2rem; color: var(--dental-purple); }
  @media (min-width: 768px) { .heading-md { font-size: 1.875rem; line-height: 2.25rem; } }
  .hero-narrow { max-width: 56rem; }
  .faq-narrow { max-width: 48rem; }

  /* ── Urgency Hero (compensa header fixo: pt-28 = 112px) ── */
  .hero {
    background: linear-gradient(to bottom right, rgb(254 242 242 / 0.5), hsl(51 22% 76%));
    padding-top: 7rem !important;
  }
  .hero-title-row { display: flex; align-items: flex-start; gap: 0.75rem; margin-bottom: 1rem; }
  .hero-alert { flex-shrink: 0; margin-top: 0.25rem; }
  .hero-h1 { color: var(--dental-purple); }
  .hero-sep { width: 6rem; height: 4px; background: #f87171; margin-bottom: 1.5rem; }
  .hero-lead { font-size: 1.125rem; color: var(--dental-gray); line-height: 1.625; max-width: 48rem; margin-bottom: 2rem; }
  .hero-credit { font-size: 0.875rem; color: rgb(107 107 107 / 0.7); }

  .urgent-box {
    background: #fff; border-radius: 1rem; padding: 1.5rem; margin-top: 0;
    box-shadow: 0 10px 40px -10px rgb(56 31 71 / 0.2); border: 1px solid #fee2e2; margin-bottom: 2rem;
  }
  @media (min-width: 768px) { .urgent-box { padding: 2rem; } }
  .urgent-flex { display: flex; flex-direction: column; gap: 1.5rem; align-items: center; justify-content: space-between; }
  @media (min-width: 768px) { .urgent-flex { flex-direction: row; } }
  .urgent-info { text-align: center; }
  @media (min-width: 768px) { .urgent-info { text-align: left; } }
  .urgent-info > * + * { margin-top: 0.5rem; }
  .urgent-info h2 { font-family: 'Playfair Display', Georgia, serif; font-weight: 400; font-size: 1.5rem; color: var(--dental-purple); }
  .urgent-meta { display: flex; flex-direction: column; gap: 1rem; font-size: 0.875rem; color: var(--dental-gray); }
  @media (min-width: 640px) { .urgent-meta { flex-direction: row; } }
  .meta-item { display: flex; align-items: center; gap: 0.5rem; }
  .meta-item svg { flex-shrink: 0; }
  .wa-btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: #128C4A; color: #fff; text-decoration: none;
    padding: 1rem 2rem; border-radius: 0.5rem; font-weight: 500; font-size: 1.125rem;
    white-space: nowrap; transition: all 0.3s;
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
  }
  .wa-btn:hover { background: #0F7540; }
  .urgent-note { font-size: 0.75rem; color: rgb(107 107 107 / 0.6); margin-top: 1rem; text-align: center; }
  @media (min-width: 768px) { .urgent-note { text-align: left; } }

  /* ── Emergency types ── */
  .types-section { background: rgb(255 255 255 / 0.5); }
  .types-heading { margin-bottom: 2rem; }
  .types-list > * + * { margin-top: 1rem; }
  .type-card {
    background: #fff; border-radius: 0.75rem; padding: 1.5rem;
    box-shadow: 0 4px 20px hsl(0 0% 0% / 0.08); border-left: 4px solid var(--dental-gold);
  }
  .type-card h3 { font-family: 'Playfair Display', Georgia, serif; font-weight: 400; color: var(--dental-purple); font-size: 1.125rem; margin-bottom: 0.5rem; }
  .type-desc { color: var(--dental-gray); font-size: 0.875rem; margin-bottom: 0.5rem; }
  .type-action { color: var(--dental-gold); font-size: 0.875rem; font-weight: 500; }

  /* ── Quick info ── */
  .info-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 768px) { .info-grid { grid-template-columns: repeat(3, 1fr); } }
  .info-card { background: #fff; border-radius: 0.75rem; padding: 1.5rem; box-shadow: 0 4px 20px hsl(0 0% 0% / 0.08); text-align: center; }
  .info-ic { margin: 0 auto 0.75rem; }
  .info-card h3 { font-family: 'Playfair Display', Georgia, serif; font-weight: 400; color: var(--dental-purple); margin-bottom: 0.5rem; font-size: 1rem; }
  .info-card p { color: var(--dental-gray); font-size: 0.875rem; line-height: 1.5; }
  .call-link { color: var(--dental-gold); text-decoration: none; }
  .call-link:hover { text-decoration: underline; }

  /* ── FAQ ── */
  .faq-section { background: rgb(255 255 255 / 0.5); }
  .faq-heading { margin-bottom: 2rem; text-align: center; }
  .faq-list > * + * { margin-top: 0.75rem; }
  .faq-item { background: #fff; border-radius: 0.5rem; border: 1px solid hsl(51 22% 76% / 0.5); padding-inline: 1.5rem; }
  .faq-item summary {
    list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
    text-align: left; padding-block: 1rem; font-weight: 500; color: var(--dental-purple); transition: color 0.2s;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:hover { color: var(--dental-gold); }
  .acc-chev { flex-shrink: 0; transition: transform 0.2s; }
  .faq-item[open] > summary .acc-chev { transform: rotate(180deg); }
  .faq-body { color: var(--dental-gray); line-height: 1.5; padding-bottom: 1rem; font-size: 0.875rem; }

  /* ── Bottom CTA ── */
  .bottom-cta { background: var(--dental-purple); color: #fff; }
  .bottom-inner { text-align: center; }
  .bottom-cta h2 { font-family: 'Playfair Display', Georgia, serif; font-weight: 400; font-size: 1.875rem; color: #fff; margin-bottom: 1rem; }
  .bottom-cta p { color: rgb(255 255 255 / 0.8); max-width: 36rem; margin: 0 auto 2rem; }

  /* ── Related ── */
  .related-section { padding-block: 3rem; background: hsl(51 22% 76% / 0.2); }
  .related-container { max-width: 56rem; margin-inline: auto; padding-inline: 1rem; }
  .related-title { font-family: 'Playfair Display', Georgia, serif; font-weight: 600; font-size: 1.25rem; color: var(--dental-purple); margin-bottom: 1.5rem; }
  .related-grid { display: grid; gap: 1rem; }
  @media (min-width: 640px) { .related-grid { grid-template-columns: repeat(3, 1fr); } }
  .related-card {
    display: flex; flex-direction: column; gap: 0.5rem; background: #fff; padding: 1.25rem;
    border-radius: 0.75rem; border: 1px solid #e5e1d4; text-decoration: none; transition: all 0.2s;
  }
  .related-card:hover { border-color: rgb(56 31 71 / 0.3); box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1); }
  .rel-t { font-weight: 600; color: var(--dental-purple); font-size: 0.875rem; line-height: 1.375; transition: color 0.2s; }
  .related-card:hover .rel-t { color: var(--dp-light); }
  .rel-d { color: var(--dental-gray); font-size: 0.75rem; line-height: 1.625; flex: 1; }
  .rel-more { display: flex; align-items: center; gap: 0.25rem; color: var(--dental-gold); font-size: 0.75rem; font-weight: 500; margin-top: 0.25rem; }

  /* ── Floating WhatsApp ── */
  .float-wa {
    position: fixed; bottom: 2rem; right: 2rem; z-index: 50;
    background: #128C4A; color: #fff; border-radius: 9999px; padding: 1rem;
    display: flex; align-items: center; gap: 0.5rem; text-decoration: none;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08); transition: all 0.3s;
  }
  .float-wa:hover { background: #0F7540; transform: scale(1.05); box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1); }
  .float-wa-txt { display: flex; flex-direction: column; text-align: left; line-height: 1.25; }
  .fw-desk, .fw-sub { display: none; }
  .fw-mob { font-weight: 500; }
