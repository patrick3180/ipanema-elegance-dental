/robots.txt   /.netlify/functions/robots   200!

# Common 404 redirects based on analytics
/admin                  /seo-dashboard      301
/dashboard              /seo-dashboard      301
/wp-admin               /seo-dashboard      301
/sobre-nos              /sobre              301
/servico                /servicos           301
