# Cache para assets estáticos (1 ano imutável)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache para JavaScript (1 ano imutável)
/*.js
  Cache-Control: public, max-age=31536000, immutable

# Cache para CSS (1 ano imutável)  
/*.css
  Cache-Control: public, max-age=31536000, immutable

# Cache para fontes (1 ano imutável)
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable

# Cache para imagens (24h browser + 1 ano CDN)
/images/*
  Cache-Control: public, max-age=86400, s-maxage=31536000
*.webp
  Cache-Control: public, max-age=86400, s-maxage=31536000
*.avif
  Cache-Control: public, max-age=86400, s-maxage=31536000
*.jpg
  Cache-Control: public, max-age=86400, s-maxage=31536000
*.png
  Cache-Control: public, max-age=86400, s-maxage=31536000

# HTML sem cache (sempre fresh)
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
/
  Cache-Control: no-cache, no-store, must-revalidate

# Landing pages (1 hora)
/lp/*
  Cache-Control: public, max-age=3600